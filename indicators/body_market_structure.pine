// Body-based market structure. Every level uses candle BODIES (open/close), never the wicks, and
// a level only counts as broken when a candle CLOSES beyond it.
//
// Uptrend (a downtrend is the mirror image):
//   low -> HIGH -> pullback (the potential HL) -> a body CLOSES above the high's body
//     = BOS: the high becomes a HH and the pullback low is CONFIRMED as the HL (new protected low).
//   A pullback only counts when the leg's bullish candles are followed by bearish candle(s) and then
//   a bullish candle again, AND the pullback reaches at least 30% (setting) of the move from the
//   protected low to the high. Anything smaller is just part of the same leg.
//   Downtrend: bearish candles, then bullish candle(s), then bearish again, retracing >= 30% of the
//   move from the protected high to the low.
//   While price stays between the high and the protected HL it is INTERNAL STRUCTURE: it is shaded
//   grey and none of its swings count.
//
// Reversal (bullish -> bearish):
//   1. CHoCH: a body CLOSES below the protected HL. The trend is not reversed yet (pending).
//   2. The down leg runs, then price pulls back and forms a LOWER HIGH (it may sit inside the old
//      internal structure).
//   3. BOS: a body CLOSES below the low of the CHoCH leg -> the LH is confirmed, trend is bearish.
//   If, while pending, a body closes back above the old high, the CHoCH failed and the uptrend
//   carries on.
//
// Paste into TradingView: Pine Editor -> new indicator -> replace everything -> Add to chart.
//@version=6
indicator("Body Market Structure (BOS / CHoCH / internal)", "Body MS", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ---------- inputs ----------
minPb         = input.float(30, "Minimum pullback (% of the move)", minval = 0, maxval = 100, step = 5)
dotLen        = input.int(2, "Internal swing dots: bars each side", minval = 1)
showInternal  = input.bool(true, "Shade internal structure")
showIntSwings = input.bool(true, "Mark internal swings (grey dots)")
bullCol       = input.color(color.teal, "Bullish colour")
bearCol       = input.color(color.red, "Bearish colour")
pendCol       = input.color(color.orange, "CHoCH / pending colour")
intCol        = input.color(color.gray, "Internal structure colour")

// ---------- body prices ----------
bodyTop = math.max(open, close)
bodyBot = math.min(open, close)

bullCandle = close > open
bearCandle = close < open

// body swings, only used for the grey dots inside internal structure
ph     = ta.pivothigh(bodyTop, dotLen, dotLen)
pl     = ta.pivotlow(bodyBot, dotLen, dotLen)
pivBar = bar_index - dotLen

// ---------- state ----------
// dir 1: tracking an up leg (ext = leg high, pot = potential HL, prot = protected low)
// dir -1: tracking a down leg (ext = leg low, pot = potential LH, prot = protected high)
var int   dir           = 1
var bool  confirmed     = false   // false = trend still forming, or CHoCH waiting for its BOS
var bool  everConfirmed = false
var float ext           = na
var int   extBar        = na
var bool  pb            = false   // pullback started -> price is in internal structure
var float pot           = na
var int   potBar        = na
var float prot          = na
var int   protBar       = na
var box   intBox        = na
var bool  sawCounter    = false   // an opposite-colour candle printed since the leg extreme

if barstate.isfirst
    ext     := bodyTop
    extBar  := bar_index
    prot    := bodyBot
    protBar := bar_index

bool chochBear = false
bool chochBull = false
bool revBear   = false
bool revBull   = false

// ---------- drawing helpers ----------
breakLine(int fromBar, float level, color col, string txt, string style) =>
    line.new(fromBar, level, bar_index, level, color = col, style = style, width = 1)
    label.new(math.round((fromBar + bar_index) / 2), level, txt, color = color.new(col, 100), textcolor = col, style = label.style_none, size = size.small)

swingLabel(int b, float p, string txt, color col, bool isHigh) =>
    label.new(b, p, txt, color = color.new(col, 100), textcolor = col, style = isHigh ? label.style_label_down : label.style_label_up, size = size.small)

closeBox() =>
    if not na(intBox)
        box.set_right(intBox, bar_index)

// ---------- structure logic ----------
isBull = dir == 1
broke  = isBull ? close < prot : close > prot

if broke
    closeBox()
    intBox := na
    if confirmed
        // CHoCH: trend is not reversed yet, it needs a LH/HL and then a BOS
        breakLine(protBar, prot, pendCol, "CHoCH", line.style_dashed)
        if isBull
            chochBear := true
        else
            chochBull := true
        // the old extreme (HH / LL) is now the level that cancels the CHoCH
        prot    := ext
        protBar := extBar
        dir     := -dir
        confirmed := false
    else
        // a pending CHoCH failed: the old trend carries on
        if everConfirmed
            breakLine(protBar, prot, isBull ? bearCol : bullCol, "CHoCH failed", line.style_dotted)
            confirmed := true
        // the extreme of the failed move becomes the new protected HL / LH
        prot    := ext
        protBar := extBar
        dir     := -dir
    ext    := isBull ? bodyBot : bodyTop
    extBar := bar_index
    pb     := false
    pot    := na
    potBar := na
    sawCounter := false
else
    if not pb
        // pullback = opposite candle(s) after the leg extreme, then a candle in the trend direction
        // again, with the retrace at least minPb % of the move (protected level -> leg extreme)
        move  = math.abs(ext - prot)
        depth = na(pot) or move == 0 ? 0.0 : math.abs(ext - pot) / move * 100
        if sawCounter and (isBull ? bullCandle : bearCandle) and depth >= minPb
            pb      := true
            txt = isBull ? (confirmed ? "HH" : "H") : (confirmed ? "LL" : "L")
            swingLabel(extBar, ext, txt, isBull ? bullCol : bearCol, isBull)
            if showInternal
                intBox := box.new(extBar, isBull ? ext : prot, bar_index, isBull ? prot : ext, border_color = color.new(intCol, 50), bgcolor = color.new(intCol, 88), border_style = line.style_dotted, text = "internal structure", text_color = color.new(intCol, 20), text_size = size.small, text_halign = text.align_left, text_valign = isBull ? text.align_top : text.align_bottom)
        else
            counter = isBull ? bearCandle : bullCandle
            if isBull ? bodyTop >= ext : bodyBot <= ext
                // leg extends: new extreme, pullback starts over
                ext        := isBull ? bodyTop : bodyBot
                extBar     := bar_index
                sawCounter := counter
                pot        := counter ? (isBull ? bodyBot : bodyTop) : na
                potBar     := counter ? bar_index : na
            else
                if counter
                    sawCounter := true
                if na(pot) or (isBull ? bodyBot < pot : bodyTop > pot)
                    pot    := isBull ? bodyBot : bodyTop
                    potBar := bar_index
    if pb
        // internal structure: only a body close beyond the leg extreme counts
        if isBull ? close > ext : close < ext
            closeBox()
            intBox := na
            swingLabel(potBar, pot, isBull ? "HL" : "LH", isBull ? bullCol : bearCol, not isBull)
            newTrend = not confirmed
            breakLine(extBar, ext, isBull ? bullCol : bearCol, newTrend and everConfirmed ? (isBull ? "BOS - bullish confirmed" : "BOS - bearish confirmed") : "BOS", newTrend and everConfirmed ? line.style_solid : line.style_dashed)
            if newTrend
                if isBull
                    revBull := true
                else
                    revBear := true
            confirmed     := true
            everConfirmed := true
            prot    := pot
            protBar := potBar
            ext     := isBull ? bodyTop : bodyBot
            extBar  := bar_index
            pb      := false
            pot     := na
            potBar  := na
            sawCounter := false
        else
            if isBull ? bodyBot < pot : bodyTop > pot
                pot    := isBull ? bodyBot : bodyTop
                potBar := bar_index
            if showIntSwings and pivBar > extBar
                if not na(ph)
                    label.new(pivBar, ph, "•", color = color.new(intCol, 100), textcolor = intCol, style = label.style_label_down, size = size.tiny)
                if not na(pl)
                    label.new(pivBar, pl, "•", color = color.new(intCol, 100), textcolor = intCol, style = label.style_label_up, size = size.tiny)

if not na(intBox)
    box.set_right(intBox, bar_index)

// ---------- most recent high / low lines ----------
var line  hiLine  = line.new(na, na, na, na, color = bearCol, width = 2, extend = extend.right)
var line  loLine  = line.new(na, na, na, na, color = bullCol, width = 2, extend = extend.right)
var line  potLine = line.new(na, na, na, na, color = pendCol, style = line.style_dotted, width = 1, extend = extend.right)
var label hiLbl   = label.new(na, na, "", style = label.style_label_left, color = color.new(bearCol, 20), textcolor = color.white, size = size.small)
var label loLbl   = label.new(na, na, "", style = label.style_label_left, color = color.new(bullCol, 20), textcolor = color.white, size = size.small)
var label potLbl  = label.new(na, na, "", style = label.style_label_left, color = color.new(pendCol, 20), textcolor = color.white, size = size.small)

hiLvl = dir == 1 ? ext : prot
hiBar = dir == 1 ? extBar : protBar
loLvl = dir == 1 ? prot : ext
loBar = dir == 1 ? protBar : extBar
hiTxt = dir == 1 ? (pb ? "High (close above = BOS) " : "Leg high (forming) ") : (confirmed ? "Protected LH (close above = CHoCH) " : "Old high (close above = CHoCH failed) ")
loTxt = dir == 1 ? (confirmed ? "Protected HL (close below = CHoCH) " : "Old low (close below = CHoCH failed) ") : (pb ? "Low (close below = BOS) " : "Leg low (forming) ")

line.set_xy1(hiLine, hiBar, hiLvl)
line.set_xy2(hiLine, bar_index, hiLvl)
label.set_xy(hiLbl, bar_index + 3, hiLvl)
label.set_text(hiLbl, hiTxt + str.tostring(hiLvl, format.mintick))
line.set_xy1(loLine, loBar, loLvl)
line.set_xy2(loLine, bar_index, loLvl)
label.set_xy(loLbl, bar_index + 3, loLvl)
label.set_text(loLbl, loTxt + str.tostring(loLvl, format.mintick))

if pb
    line.set_xy1(potLine, potBar, pot)
    line.set_xy2(potLine, bar_index, pot)
    label.set_xy(potLbl, bar_index + 3, pot)
    label.set_text(potLbl, (dir == 1 ? "Potential HL " : "Potential LH ") + str.tostring(pot, format.mintick))
else
    line.set_xy1(potLine, na, na)
    line.set_xy2(potLine, na, na)
    label.set_xy(potLbl, na, na)

// ---------- status panel ----------
var table panel = table.new(position.top_right, 2, 4, bgcolor = color.new(color.black, 30), border_width = 1)
if barstate.islast
    trendTxt = not everConfirmed ? "Forming" : confirmed ? (dir == 1 ? "Bullish" : "Bearish") : (dir == 1 ? "Bearish - CHoCH up, waiting for HL + BOS" : "Bullish - CHoCH down, waiting for LH + BOS")
    trendCol = not everConfirmed ? color.gray : confirmed ? (dir == 1 ? bullCol : bearCol) : pendCol
    mv       = math.abs(ext - prot)
    curDepth = na(pot) or mv == 0 ? 0.0 : math.abs(ext - pot) / mv * 100
    stateTxt = pb ? "Internal structure (ignored)" : "Leg running - pullback " + str.tostring(curDepth, "#") + "% of move (needs " + str.tostring(minPb, "#") + "% + " + (dir == 1 ? "bullish" : "bearish") + " candle)"
    table.cell(panel, 0, 0, "Trend", text_color = color.white)
    table.cell(panel, 1, 0, trendTxt, text_color = trendCol)
    table.cell(panel, 0, 1, "Status", text_color = color.white)
    table.cell(panel, 1, 1, stateTxt, text_color = pb ? intCol : color.white)
    table.cell(panel, 0, 2, "Recent high", text_color = color.white)
    table.cell(panel, 1, 2, str.tostring(hiLvl, format.mintick), text_color = color.white)
    table.cell(panel, 0, 3, "Recent low", text_color = color.white)
    table.cell(panel, 1, 3, str.tostring(loLvl, format.mintick), text_color = color.white)

bgcolor(not everConfirmed ? na : not confirmed ? color.new(pendCol, 94) : dir == 1 ? color.new(bullCol, 94) : color.new(bearCol, 94))

// ---------- alerts ----------
alertcondition(chochBear, "Bearish CHoCH", "Bearish CHoCH (body close below protected HL) - waiting for LH + BOS")
alertcondition(chochBull, "Bullish CHoCH", "Bullish CHoCH (body close above protected LH) - waiting for HL + BOS")
alertcondition(revBear, "Bearish reversal confirmed", "LH + body close below the CHoCH low - trend is now bearish")
alertcondition(revBull, "Bullish reversal confirmed", "HL + body close above the CHoCH high - trend is now bullish")
