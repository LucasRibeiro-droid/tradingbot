// Body-based market structure: shows the most recent swing high and swing low, the trend, and
// how a reversal happens. Every level uses candle BODIES (open/close), never the wicks.
//
// Trend reversal rule (bullish -> bearish; bearish -> bullish is the mirror image):
//   1. CHoCH  - a candle CLOSES below the most recent swing low (the last higher low).
//               The trend is NOT reversed yet; it is only "pending".
//   2. The CHoCH leg keeps running until price pulls back and prints a swing high (a lower high).
//      The lowest body of that leg is the confirmation level.
//   3. LL     - a candle CLOSES below that level = a new lower low. Only now is the trend bearish.
//   If, before step 3, a candle closes back above the high the uptrend made (the high before the
//   CHoCH), the CHoCH failed and the trend stays bullish.
//
// Paste into TradingView: Pine Editor -> new indicator -> replace everything -> Add to chart.
//@version=6
indicator("Body Market Structure (CHoCH + confirmation)", "Body MS", overlay = true, max_labels_count = 500, max_lines_count = 500)

// ---------- inputs ----------
swingLen   = input.int(3, "Swing strength (bars each side)", minval = 1)
showSwings = input.bool(true, "Label swing points (HH / HL / LH / LL)")
showBreaks = input.bool(true, "Show BOS / CHoCH / confirmation lines")
bullCol    = input.color(color.new(color.teal, 0), "Bullish colour")
bearCol    = input.color(color.new(color.red, 0), "Bearish colour")
pendCol    = input.color(color.new(color.orange, 0), "Pending (CHoCH) colour")

// ---------- body prices ----------
bodyTop = math.max(open, close)
bodyBot = math.min(open, close)

ph = ta.pivothigh(bodyTop, swingLen, swingLen)
pl = ta.pivotlow(bodyBot, swingLen, swingLen)

// ---------- state ----------
var float swingHigh    = na
var int   swingHighBar = na
var bool  highBroken   = false
var float swingLow     = na
var int   swingLowBar  = na
var bool  lowBroken    = false

var int   trend   = 0      // 1 bullish, -1 bearish, 0 not yet known
var int   pending = 0      // -1 bearish CHoCH waiting for a LL, 1 bullish CHoCH waiting for a HH

var float runHigh    = na  // highest body of the current uptrend
var int   runHighBar = na
var float runLow     = na  // lowest body of the current downtrend
var int   runLowBar  = na

var float legExtreme    = na   // extreme body of the CHoCH leg (the level to confirm)
var int   legExtremeBar = na
var bool  legFrozen     = false
var float invalidLevel  = na
var int   chochBar      = na

bool chochBear = false
bool chochBull = false
bool revBear   = false
bool revBull   = false

breakLine(int fromBar, float level, color col, string txt, string style) =>
    if showBreaks
        line.new(fromBar, level, bar_index, level, color = col, style = style, width = 1)
        label.new(int(math.round((fromBar + bar_index) / 2)), level, txt, color = color.new(col, 100), textcolor = col, style = label.style_none, size = size.small)

// ---------- new swing points (confirmed swingLen bars later) ----------
if not na(ph)
    if showSwings
        txt = na(swingHigh) ? "H" : ph > swingHigh ? "HH" : "LH"
        label.new(bar_index - swingLen, ph, txt, color = color.new(color.white, 100), textcolor = ph > nz(swingHigh, ph) ? bullCol : bearCol, style = label.style_label_down, size = size.tiny)
    swingHigh    := ph
    swingHighBar := bar_index - swingLen
    highBroken   := false
    if pending == -1 and swingHighBar > chochBar
        legFrozen := true      // pullback printed a lower high -> CHoCH leg low is now fixed

if not na(pl)
    if showSwings
        txt = na(swingLow) ? "L" : pl < swingLow ? "LL" : "HL"
        label.new(bar_index - swingLen, pl, txt, color = color.new(color.white, 100), textcolor = pl < nz(swingLow, pl) ? bearCol : bullCol, style = label.style_label_up, size = size.tiny)
    swingLow    := pl
    swingLowBar := bar_index - swingLen
    lowBroken   := false
    if pending == 1 and swingLowBar > chochBar
        legFrozen := true      // pullback printed a higher low -> CHoCH leg high is now fixed

// ---------- structure logic (closes only, i.e. bodies) ----------
if pending == -1
    if not legFrozen and bodyBot < legExtreme
        legExtreme    := bodyBot
        legExtremeBar := bar_index
    if close > invalidLevel
        breakLine(runHighBar, invalidLevel, bullCol, "CHoCH failed", line.style_dotted)
        pending    := 0
        runHigh    := bodyTop
        runHighBar := bar_index
    else if legFrozen and close < legExtreme
        breakLine(legExtremeBar, legExtreme, bearCol, "LL - bearish confirmed", line.style_solid)
        trend     := -1
        pending   := 0
        revBear   := true
        runLow    := bodyBot
        runLowBar := bar_index
else if pending == 1
    if not legFrozen and bodyTop > legExtreme
        legExtreme    := bodyTop
        legExtremeBar := bar_index
    if close < invalidLevel
        breakLine(runLowBar, invalidLevel, bearCol, "CHoCH failed", line.style_dotted)
        pending   := 0
        runLow    := bodyBot
        runLowBar := bar_index
    else if legFrozen and close > legExtreme
        breakLine(legExtremeBar, legExtreme, bullCol, "HH - bullish confirmed", line.style_solid)
        trend      := 1
        pending    := 0
        revBull    := true
        runHigh    := bodyTop
        runHighBar := bar_index
else
    if trend == 0
        if not na(swingHigh) and close > swingHigh
            trend      := 1
            runHigh    := bodyTop
            runHighBar := bar_index
            highBroken := true
        else if not na(swingLow) and close < swingLow
            trend     := -1
            runLow    := bodyBot
            runLowBar := bar_index
            lowBroken := true
    else if trend == 1
        if bodyTop > runHigh
            runHigh    := bodyTop
            runHighBar := bar_index
        if not highBroken and not na(swingHigh) and close > swingHigh
            breakLine(swingHighBar, swingHigh, bullCol, "BOS", line.style_dashed)
            highBroken := true
        if not lowBroken and not na(swingLow) and close < swingLow
            breakLine(swingLowBar, swingLow, pendCol, "CHoCH", line.style_dashed)
            lowBroken     := true
            pending       := -1
            chochBear     := true
            chochBar      := bar_index
            legExtreme    := bodyBot
            legExtremeBar := bar_index
            legFrozen     := false
            invalidLevel  := runHigh
    else if trend == -1
        if bodyBot < runLow
            runLow    := bodyBot
            runLowBar := bar_index
        if not lowBroken and not na(swingLow) and close < swingLow
            breakLine(swingLowBar, swingLow, bearCol, "BOS", line.style_dashed)
            lowBroken := true
        if not highBroken and not na(swingHigh) and close > swingHigh
            breakLine(swingHighBar, swingHigh, pendCol, "CHoCH", line.style_dashed)
            highBroken    := true
            pending       := 1
            chochBull     := true
            chochBar      := bar_index
            legExtreme    := bodyTop
            legExtremeBar := bar_index
            legFrozen     := false
            invalidLevel  := runLow

// ---------- most recent high / low lines ----------
var line  hiLine = line.new(na, na, na, na, color = bearCol, width = 2, extend = extend.right)
var line  loLine = line.new(na, na, na, na, color = bullCol, width = 2, extend = extend.right)
var label hiLbl  = label.new(na, na, "", style = label.style_label_left, color = color.new(bearCol, 20), textcolor = color.white, size = size.small)
var label loLbl  = label.new(na, na, "", style = label.style_label_left, color = color.new(bullCol, 20), textcolor = color.white, size = size.small)
var line  cfLine = line.new(na, na, na, na, color = pendCol, style = line.style_dotted, width = 1, extend = extend.right)

if not na(swingHigh)
    line.set_xy1(hiLine, swingHighBar, swingHigh)
    line.set_xy2(hiLine, bar_index, swingHigh)
    label.set_xy(hiLbl, bar_index + 3, swingHigh)
    label.set_text(hiLbl, "Recent high " + str.tostring(swingHigh, format.mintick))
if not na(swingLow)
    line.set_xy1(loLine, swingLowBar, swingLow)
    line.set_xy2(loLine, bar_index, swingLow)
    label.set_xy(loLbl, bar_index + 3, swingLow)
    label.set_text(loLbl, "Recent low " + str.tostring(swingLow, format.mintick))

// level that must be broken to confirm a pending reversal
if pending != 0 and legFrozen
    line.set_xy1(cfLine, legExtremeBar, legExtreme)
    line.set_xy2(cfLine, bar_index, legExtreme)
else
    line.set_xy1(cfLine, na, na)
    line.set_xy2(cfLine, na, na)

// ---------- status panel ----------
var table panel = table.new(position.top_right, 2, 4, bgcolor = color.new(color.black, 30), border_width = 1)
if barstate.islast
    trendTxt = trend == 1 ? "Bullish" : trend == -1 ? "Bearish" : "Undefined"
    trendCol = trend == 1 ? bullCol : trend == -1 ? bearCol : color.gray
    stateTxt = pending == -1 ? (legFrozen ? "CHoCH down - waiting for close < " + str.tostring(legExtreme, format.mintick) : "CHoCH down - waiting for lower high") : pending == 1 ? (legFrozen ? "CHoCH up - waiting for close > " + str.tostring(legExtreme, format.mintick) : "CHoCH up - waiting for higher low") : "Trend intact"
    table.cell(panel, 0, 0, "Trend", text_color = color.white)
    table.cell(panel, 1, 0, trendTxt, text_color = trendCol)
    table.cell(panel, 0, 1, "Status", text_color = color.white)
    table.cell(panel, 1, 1, stateTxt, text_color = pending != 0 ? pendCol : color.white)
    table.cell(panel, 0, 2, "Recent high", text_color = color.white)
    table.cell(panel, 1, 2, str.tostring(swingHigh, format.mintick), text_color = color.white)
    table.cell(panel, 0, 3, "Recent low", text_color = color.white)
    table.cell(panel, 1, 3, str.tostring(swingLow, format.mintick), text_color = color.white)

bgcolor(trend == 1 ? color.new(bullCol, 94) : trend == -1 ? color.new(bearCol, 94) : na)

// ---------- alerts ----------
alertcondition(chochBear, "Bearish CHoCH", "Bearish CHoCH (body close below recent low) - waiting for a new lower low")
alertcondition(chochBull, "Bullish CHoCH", "Bullish CHoCH (body close above recent high) - waiting for a new higher high")
alertcondition(revBear, "Bearish reversal confirmed", "New lower low after CHoCH - trend is now bearish")
alertcondition(revBull, "Bullish reversal confirmed", "New higher high after CHoCH - trend is now bullish")
