//
// ════════════════════════════════════════════════════════════════════════════════════════════════
//  NO-WICK ENTRY MODEL — NQ, 5-MINUTE, SUPERTREND TREND FILTER
//  Same no-wick rules as nowick_entry_model.pine (course timestamps in [mm:ss]); the trend is read
//  with the Supertrend (ATR 10, factor 3) instead of BOS / 4h structure — your rule.
//
//  RULES
//   1. No-wick candle [02:15–02:57]: bullish with NO bottom wick (open = low) / bearish with NO top
//      wick (open = high). Level = its open (the flat side) [04:23–04:31].
//   2. Only in the trend direction: bullish no-wick only while Supertrend is UP, bearish only while
//      DOWN — checked when the no-wick closes AND still required when price taps it.
//   3. Entry on the tap: limit order at the level [05:19–05:25]. The tap must happen within 9 candles
//      of the no-wick [04:47–05:11] (candle 10 or later → no trade).
//   4. Stop at structure: beyond the most recent swing high/low (body pivots, 2 each side) + breathing
//      room [05:26–05:45] [28:29–29:13]. Take profit 1:1 [05:47].
//   5. Management [35:41–36:20]: opposite no-wick against you → SL to breakeven after price comes a
//      bit your way; if in drawdown at that moment → TP to breakeven.
//   6. Avoid [36:20–37:08]: conflicting no-wicks, huge stops. Optional session filter.
//  Values he never gave are inputs marked [ASSUMPTION].
// ════════════════════════════════════════════════════════════════════════════════════════════════

//@version=6
strategy(title = "No-Wick NQ 5m — Supertrend trend",
     shorttitle = "NoWick NQ ST",
     overlay = true,
     pyramiding = 10,
     initial_capital = 100000,
     currency = currency.USD,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 0,                 // costs are charged in the results table (inputs below)
     slippage = 0,
     margin_long = 0,
     margin_short = 0,
     close_entries_rule = "ANY",
     process_orders_on_close = false,
     calc_on_every_tick = false,
     // ⚠ Free plan: keep the bar magnifier off (it errors). Without it, when entry and stop/TP happen
     // in the same 5m bar TradingView guesses the order — results can look better than reality.
     use_bar_magnifier = false,
     max_lines_count = 500,
     max_boxes_count = 500)

const string TZ = "America/New_York"

// ════════════════════════════════════════════════════════════════════════════════════════════════
// INPUTS
// ════════════════════════════════════════════════════════════════════════════════════════════════
const string G_ST = "Supertrend (trend filter)"
int   stATR    = input.int(10, "ATR Length", minval = 1, group = G_ST)
float stFactor = input.float(3.0, "Factor", minval = 0.01, step = 0.01, group = G_ST)
bool  showST   = input.bool(true, "Show Supertrend", group = G_ST)

const string G_NW = "No-wick setup"
int  tapWindow  = input.int(9, "Tap must happen within (candles)", minval = 1, group = G_NW,
     tooltip = "[04:47–05:11] No more than nine candles from the no-wick to the tap; on the 10th candle you don't take the trade.")
bool trendAtTap = input.bool(true, "Trend must still agree when price taps", group = G_NW,
     tooltip = "If the Supertrend flips while the order waits, the order is cancelled.")

const string G_SL = "Stop loss / take profit"
int   pivLen      = input.int(2, "Swing size: candles each side (bodies)", minval = 1, maxval = 10, group = G_SL,
     tooltip = "[09:01–11:47] Swings on candle bodies; his zig-zag is set to 2.")
float dojiPct     = input.float(10.0, "Doji = body ≤ this % of range (not structure) [ASSUMPTION]", minval = 0, maxval = 50, group = G_SL)
int   breathTicks = input.int(4, "Breathing room (ticks) [ASSUMPTION]", minval = 0, group = G_SL,
     tooltip = "[29:01] 'with a little bit of breathing room'. NQ tick = 0.25 point.")
float rrTarget    = input.float(1.0, "Take profit (R)", minval = 0.1, step = 0.1, group = G_SL)

const string G_MG = "Management & avoid"
bool  useMgmt    = input.bool(true, "Opposite no-wick → breakeven [35:41–36:20]", group = G_MG)
float beAfterR   = input.float(0.25, "'A bit' = price moves this many R your way [ASSUMPTION]", minval = 0, step = 0.05, group = G_MG)
bool  avConflict = input.bool(true, "Avoid conflicting no-wicks [36:20]", group = G_MG,
     tooltip = "An opposite no-wick closes while a setup waits → setup dropped.")
bool  avHuge     = input.bool(true, "Avoid huge SL [36:32]", group = G_MG)
float hugeATR    = input.float(3.0, "…huge = stop wider than this × ATR(14) [ASSUMPTION]", minval = 0.5, step = 0.5, group = G_MG)

const string G_SS = "Session (New York time)"
bool   useSess  = input.bool(false, "Only trade inside the window", group = G_SS,
     tooltip = "His sessions are for forex. Off by default for NQ — turn on and set your own window.")
string sessWin  = input.session("0930-1600", "Trading window", group = G_SS)

const string G_RK = "Size & costs"
float riskPct   = input.float(1.0, "Risk per trade: % of the STARTING balance", minval = 0.01, step = 0.25, group = G_RK,
     tooltip = "Fixed amount every trade (1% of initial capital). Results are shown in %.")
float commSide  = input.float(2.25, "Commission per contract per side ($)", minval = 0, step = 0.05, group = G_RK)
int   slipTicks = input.int(1, "Slippage per stop/market fill (ticks)", minval = 0, group = G_RK)

bool showTable = input.bool(true, "Results table", group = "Display")

// ════════════════════════════════════════════════════════════════════════════════════════════════
// GUARDS
// ════════════════════════════════════════════════════════════════════════════════════════════════
if barstate.isfirst and timeframe.in_seconds() != 300
    runtime.error("Use the 5-minute chart.")
if barstate.isfirst and syminfo.type != "futures"
    runtime.error("Built for NQ futures (NQ1! or MNQ1!).")

float tick   = syminfo.mintick
float breath = breathTicks * tick
float atr14  = ta.atr(14)

// ════════════════════════════════════════════════════════════════════════════════════════════════
// TREND — your Supertrend (direction < 0 = uptrend, > 0 = downtrend)
// ════════════════════════════════════════════════════════════════════════════════════════════════
[supertrend, stDir] = ta.supertrend(stFactor, stATR)
int trend = stDir < 0 ? 1 : -1
plot(showST and stDir < 0 ? supertrend : na, "Up Trend",   color.green, style = plot.style_linebr)
plot(showST and stDir > 0 ? supertrend : na, "Down Trend", color.red,   style = plot.style_linebr)

// ════════════════════════════════════════════════════════════════════════════════════════════════
// STRUCTURE — body swings for the stop
// ════════════════════════════════════════════════════════════════════════════════════════════════
float bodyTop = math.max(open, close)
float bodyBot = math.min(open, close)
bool  isDoji  = (high - low) > 0 and math.abs(close - open) <= dojiPct / 100 * (high - low)
float pH = ta.pivothigh(bodyTop, pivLen, pivLen)
float pL = ta.pivotlow(bodyBot, pivLen, pivLen)
var array<float> shWick = array.new<float>()       // wick extremes of recent swing highs (newest first)
var array<float> slWick = array.new<float>()
if not na(pH) and not isDoji[pivLen]
    shWick.unshift(high[pivLen])
    if shWick.size() > 20
        shWick.pop()
if not na(pL) and not isDoji[pivLen]
    slWick.unshift(low[pivLen])
    if slWick.size() > 20
        slWick.pop()

// Most recent swing beyond the entry (+ breathing room).
f_stop(int dir, float entry) =>
    float res = na
    array<float> wk = dir == 1 ? slWick : shWick
    if wk.size() > 0
        for w in wk
            if (dir == 1 and w < entry) or (dir == -1 and w > entry)
                res := dir == 1 ? w - breath : w + breath
                break
    res

// ════════════════════════════════════════════════════════════════════════════════════════════════
// NO-WICK CANDLES
// ════════════════════════════════════════════════════════════════════════════════════════════════
bool bullNW = barstate.isconfirmed and close > open and open - low <= tick * 0.01
bool bearNW = barstate.isconfirmed and close < open and high - open <= tick * 0.01
plotshape(bullNW, "Bullish no-wick", shape.triangleup,   location.belowbar, color.new(color.yellow, 0), size = size.tiny)
plotshape(bearNW, "Bearish no-wick", shape.triangledown, location.abovebar, color.new(color.yellow, 0), size = size.tiny)

bool inSess = not useSess or not na(time(timeframe.period, sessWin, TZ))

// ════════════════════════════════════════════════════════════════════════════════════════════════
// BOOK-KEEPING
// ════════════════════════════════════════════════════════════════════════════════════════════════
type Setup
    string id
    int    dir
    float  entry
    float  stop
    float  tp
    int    expiryBar
    line   ln

type Live
    string id
    int    dir
    float  entry
    float  stop
    float  tp
    float  risk
    bool   oppSeen
    bool   beDone

var array<Setup> pend = array.new<Setup>()
var array<Live>  live = array.new<Live>()
var map<string, float> riskById = map.new<string, float>()
var int seq = 0
var int cntSetups = 0
var int cntExpired = 0
var int cntFlip = 0
var int cntConflict = 0
var int cntNoStop = 0
var int cntHuge = 0
var int cntAgainst = 0

f_retire(line ln) =>
    if not na(ln)
        ln.set_x2(bar_index)
        ln.set_color(color.new(color.gray, 50))
        ln.set_style(line.style_dotted)

f_openIdx(string id) =>
    int res = -1
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            if strategy.opentrades.entry_id(i) == id
                res := i
                break
    res

// Fills: pending → live
int np = pend.size()
if np > 0
    for j = np - 1 to 0
        Setup s = pend.get(j)
        int oi = f_openIdx(s.id)
        if oi >= 0
            float ep = strategy.opentrades.entry_price(oi)
            live.push(Live.new(s.id, s.dir, ep, s.stop, s.tp, math.abs(s.entry - s.stop), false, false))
            f_retire(s.ln)
            box.new(bar_index, math.max(ep, s.stop), bar_index + 6, math.min(ep, s.stop), border_color = color.new(color.red, 40), bgcolor = color.new(color.red, 85))
            box.new(bar_index, math.max(ep, s.tp), bar_index + 6, math.min(ep, s.tp), border_color = color.new(color.green, 40), bgcolor = color.new(color.green, 85))
            pend.remove(j)

// Closed trades → ledger in R (net of commission + slippage)
var int processed = 0
var int nT = 0
var int nW = 0
var int nL = 0
var int nBE = 0
var float sumR = 0.0
var float sumRnet = 0.0
var float peakR = 0.0
var float maxDDR = 0.0
if strategy.closedtrades > processed
    for i = processed to strategy.closedtrades - 1
        string eid = strategy.closedtrades.entry_id(i)
        float ep = strategy.closedtrades.entry_price(i)
        float xp = strategy.closedtrades.exit_price(i)
        float q  = math.abs(strategy.closedtrades.size(i))
        int   d  = strategy.closedtrades.size(i) > 0 ? 1 : -1
        float rk = riskById.contains(eid) ? riskById.get(eid) : math.abs(ep - xp)
        float r  = rk > 0 ? (xp - ep) * d / rk : 0.0
        bool  isTP = str.startswith(strategy.closedtrades.exit_comment(i), "TP")
        // costs in points per contract: 2 × commission, slippage on the stop / BE exit (limit entries & TPs don't slip)
        float costPts = 2 * commSide / syminfo.pointvalue + (isTP ? 0 : slipTicks * tick)
        nT += 1
        sumR += r
        sumRnet += r - (rk > 0 ? costPts / rk : 0.0)
        peakR := math.max(peakR, sumRnet)
        maxDDR := math.max(maxDDR, peakR - sumRnet)
        if math.abs(xp - ep) < tick
            nBE += 1
        else if r > 0
            nW += 1
        else
            nL += 1
        int nl = live.size()
        if nl > 0
            for k = nl - 1 to 0
                if live.get(k).id == eid
                    live.remove(k)
        int npp = pend.size()
        if npp > 0
            for k = npp - 1 to 0
                if pend.get(k).id == eid
                    f_retire(pend.get(k).ln)
                    pend.remove(k)
    processed := strategy.closedtrades

// ════════════════════════════════════════════════════════════════════════════════════════════════
// SETUPS (confirmed bars only)
// ════════════════════════════════════════════════════════════════════════════════════════════════
if barstate.isconfirmed
    // drop waiting setups: tap window over, trend flipped, or conflicting no-wick
    int n0 = pend.size()
    if n0 > 0
        for j = n0 - 1 to 0
            Setup s = pend.get(j)
            bool drop = false
            if bar_index >= s.expiryBar
                drop := true
                cntExpired += 1
            else if trendAtTap and trend != s.dir
                drop := true
                cntFlip += 1
            else if avConflict and ((s.dir == 1 and bearNW) or (s.dir == -1 and bullNW))
                drop := true
                cntConflict += 1
            if drop
                strategy.cancel(s.id)
                f_retire(s.ln)
                pend.remove(j)
    // new setup from a no-wick that just closed — only in the Supertrend direction
    if bullNW or bearNW
        int dir = bullNW ? 1 : -1
        if trend != dir
            cntAgainst += 1
        else
            float lvl  = open
            float stop = f_stop(dir, lvl)
            if na(stop)
                cntNoStop += 1
            else if avHuge and math.abs(lvl - stop) > hugeATR * atr14
                cntHuge += 1
            else
                float tp = lvl + dir * rrTarget * math.abs(lvl - stop)
                seq += 1
                string id = "NW" + str.tostring(seq)
                line ln = line.new(bar_index, lvl, bar_index, lvl, color = dir == 1 ? color.teal : color.red, width = 2)
                // tap allowed on candles 1..tapWindow after the no-wick
                pend.push(Setup.new(id, dir, lvl, stop, tp, bar_index + tapWindow, ln))
                riskById.put(id, math.abs(lvl - stop))
                cntSetups += 1

// ════════════════════════════════════════════════════════════════════════════════════════════════
// ORDERS — limit at the level; 1% of the starting balance at risk per trade
// ════════════════════════════════════════════════════════════════════════════════════════════════
float riskCash = strategy.initial_capital * riskPct / 100
if barstate.isconfirmed and pend.size() > 0
    for s in pend
        float rd = math.abs(s.entry - s.stop)
        int contracts = rd > 0 ? int(math.floor(riskCash / (rd * syminfo.pointvalue))) : 0
        if inSess and contracts >= 1
            strategy.entry(s.id, s.dir == 1 ? strategy.long : strategy.short, qty = contracts, limit = s.entry,
                 comment = s.dir == 1 ? "NW L" : "NW S")
            strategy.exit(s.id + "-X", from_entry = s.id, stop = s.stop, limit = s.tp, comment_loss = "SL", comment_profit = "TP")
        else
            strategy.cancel(s.id)
        if not na(s.ln)
            s.ln.set_x2(bar_index)

// ════════════════════════════════════════════════════════════════════════════════════════════════
// MANAGEMENT [35:41–36:20]
// ════════════════════════════════════════════════════════════════════════════════════════════════
if useMgmt and barstate.isconfirmed and live.size() > 0
    for t in live
        bool opp = (t.dir == 1 and bearNW) or (t.dir == -1 and bullNW)
        if opp and not t.oppSeen
            t.oppSeen := true
            if (t.dir == 1 ? close < t.entry : close > t.entry)
                t.tp := t.entry                                    // in drawdown → TP to breakeven
                strategy.exit(t.id + "-X", from_entry = t.id, stop = t.stop, limit = t.tp, comment_loss = "SL", comment_profit = "TP-BE")
        if t.oppSeen and not t.beDone and t.tp != t.entry
            if (t.dir == 1 ? close >= t.entry + beAfterR * t.risk : close <= t.entry - beAfterR * t.risk)
                t.beDone := true
                t.stop := t.entry                                  // SL to breakeven
                strategy.exit(t.id + "-X", from_entry = t.id, stop = t.stop, limit = t.tp, comment_loss = "BE", comment_profit = "TP")

// ════════════════════════════════════════════════════════════════════════════════════════════════
// RESULTS TABLE (in % — every trade risks riskPct % of the starting balance)
// ════════════════════════════════════════════════════════════════════════════════════════════════
var table tb = table.new(position.bottom_right, 2, 11, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 60))
f_row(int r, string k, string v) =>
    table.cell(tb, 0, r, k, text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, r, v, text_color = color.white, text_size = size.small, text_halign = text.align_right)
f_pct(float rm) =>
    (rm >= 0 ? "+" : "") + str.tostring(rm * riskPct, "0.00") + "%"
if barstate.islast and showTable
    f_row(0, "No-Wick NQ 5m · Supertrend " + str.tostring(stATR) + "/" + str.tostring(stFactor), "risk " + str.tostring(riskPct, "0.##") + "%")
    f_row(1, "Trades (W / L / BE)", str.tostring(nT) + "  (" + str.tostring(nW) + " / " + str.tostring(nL) + " / " + str.tostring(nBE) + ")")
    f_row(2, "Win rate (excl. BE)", nW + nL > 0 ? str.tostring(100.0 * nW / (nW + nL), "0.0") + "%" : "—")
    f_row(3, "Return (before costs)", f_pct(sumR))
    f_row(4, "Return (after commission + slippage)", f_pct(sumRnet))
    f_row(5, "Max drawdown (closed trades)", str.tostring(maxDDR * riskPct, "0.00") + "%")
    f_row(6, "Avg per trade (net)", nT > 0 ? f_pct(sumRnet / nT) : "—")
    f_row(7, "Setups placed", str.tostring(cntSetups))
    f_row(8, "Not tapped within " + str.tostring(tapWindow) + " / trend flipped", str.tostring(cntExpired) + " / " + str.tostring(cntFlip))
    f_row(9, "No-wicks against trend (ignored)", str.tostring(cntAgainst))
    f_row(10, "Skipped: no stop / huge SL / conflict", str.tostring(cntNoStop) + " / " + str.tostring(cntHuge) + " / " + str.tostring(cntConflict))
