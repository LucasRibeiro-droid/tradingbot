// ════════════════════════════════════════════════════════════════════════════════════════════════
//  NO-WICK ENTRY MODEL — exact baseline from the course video (Bard FX, "the complete no-wick entry
//  model"). Every rule cites the video timestamp it comes from: [mm:ss]. Frame-by-frame logs and the
//  written spec: strategy_course/ (logs/part1–6, SPEC.md).
//
//  Anything he did NOT specify is an input marked  [ASSUMPTION]  — not his rule.
//  Decision areas / ranges (21:05–26:17) are NOT in this baseline (separate layer later).
//
//  Chart: one of his 6 forex pairs on the 15-minute chart [14:56] [16:12]
//         AUDUSD, AUDJPY, GBPUSD, USDJPY, USDCHF, AUDCHF (OANDA).
//  The 30m, 1h and 4h charts are read as REAL timeframes (request.security on closed candles),
//  exactly as if you switched the chart — not rebuilt from 15m candles.
// ════════════════════════════════════════════════════════════════════════════════════════════════

//@version=6
strategy(title = "No-Wick Entry Model (course baseline)",
     shorttitle = "NoWick Model",
     overlay = true,
     pyramiding = 20,                      // several setups may be open together (same timeframe only)
     initial_capital = 100000,
     currency = currency.USD,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     commission_type = strategy.commission.percent,
     commission_value = 0,                 // spread is charged in the results table (input below)
     slippage = 0,
     margin_long = 0,
     margin_short = 0,
     close_entries_rule = "ANY",
     process_orders_on_close = false,
     calc_on_every_tick = false,
     // ⚠ Entries are limit orders that fill inside a bar, so entry + stop/TP can happen in the same
     // 15m bar. Without the bar magnifier TradingView guesses that order. Free plan: keep it off
     // (it errors). Paid plan: turn on "Bar magnifier / High detalization" in the Strategy Tester.
     use_bar_magnifier = false,
     max_lines_count = 500,
     max_labels_count = 500,
     max_boxes_count = 500)

const string TZ = "America/New_York"

// ════════════════════════════════════════════════════════════════════════════════════════════════
// INPUTS
// ════════════════════════════════════════════════════════════════════════════════════════════════
const string G_NW = "No-wick candle"
int  tapWindow  = input.int(9, "Tap must happen within (candles)", minval = 1, group = G_NW,
     tooltip = "[04:47–05:11] 'there cannot be more than nine candles from when this candle gets created to when it gets tapped… on the 10th candle you don't take the trade.' Counted in candles of the timeframe the no-wick formed on.")
bool useHTFprio = input.bool(true, "Look for no-wicks on the 30m and 1h as well (higher timeframe priority)", group = G_NW,
     tooltip = "[15:06–16:10] 'If there is a play on the 30 minute as well as on the 15, you prioritise the 30 minute… 1 hour.' Real 30m / 1h candles. Swings, trend, stop and the 9-candle window all use the timeframe the no-wick formed on.")

const string G_TR = "Trend (internal / external 4h)"
int   pivLen  = input.int(2, "Swing size: candles each side", minval = 1, maxval = 10, group = G_TR,
     tooltip = "[10:27–11:47] Internal trend = 'every single pivot', read on candle BODIES [09:01–09:37]; his zig-zag is set to 2. A swing high = a body top higher than the body tops of N candles each side (confirmed N candles later — no look-ahead).")
float dojiPct = input.float(10.0, "Doji = body ≤ this % of the candle range [ASSUMPTION]", minval = 0, maxval = 50, step = 1, group = G_TR,
     tooltip = "[29:27] 'Doji candles, we don't take doji candles into account as structure.' He never defines a doji.")
string extTF  = input.timeframe("240", "External trend timeframe", group = G_TR,
     tooltip = "[12:25–12:37] 'the external is on the 4 hour'. Only trades in the 4h direction, except his exceptions (two-step BOS, imbalance).")

const string G_EN = "Entry"
string preMode = input.string("Off", "Pre-entry", options = ["Off", "Gann box 0.5", "Retest area"], group = G_EN,
     tooltip = "[30:06–33:29] Only when the no-wick is LOW in the leg (below the 0.5 of the leg, bodies).\nGann box 0.5: enter at the 0.5 of the leg [32:39].\nRetest area: enter at the previous high (long) / previous low (short) [31:57–32:25].\nOff: always enter at the no-wick level (pure tap).")

const string G_SL = "Stop loss / take profit"
string slMode    = input.string("Structure", "Stop method", options = ["Structure", "Previous candle"], group = G_SL,
     tooltip = "[28:29–29:56] 'around the same win rate'.\nStructure: above the most recent high (short) / below the most recent low (long) [05:26–05:45].\nPrevious candle: high/low of the candle before the no-wick, skipping dojis [29:35–29:56].")
float breathPips = input.float(0.8, "Breathing room (pips) [ASSUMPTION — from your screenshot]", minval = 0, step = 0.1, group = G_SL,
     tooltip = "[29:01] 'with a little bit of breathing room'.")
float rrTarget   = input.float(1.0, "Take profit (R)", minval = 0.1, step = 0.1, group = G_SL,
     tooltip = "[05:47] 'TP at a 1:1 ratio'.")
bool  useTPprio  = input.bool(false, "Stop-loss priority: lower TP if 1R needs to break several highs/lows", group = G_SL,
     tooltip = "[33:35–35:03] 'we lower the take-profit to a feasible area'. Off by default — he applies it by eye.")
int   tpPrioN    = input.int(2, "…when at least this many swings lie between entry and 1R [ASSUMPTION]", minval = 1, maxval = 2, group = G_SL)

const string G_IM = "Imbalance exception [26:17–28:31]"
bool  useImb    = input.bool(true, "Allow a ONE-step BOS against the 4h when targeting an unfilled imbalance", group = G_IM,
     tooltip = "[26:42–27:21] 'even if you didn't have a two-step BOS… you can still take it off of a one-step BOS as long as you have the imbalance with you… TP at the top of the imbalance.' [27:26–28:31] not if the imbalance was already filled.")
int   imbMinN   = input.int(3, "Imbalance = at least this many candles of one colour in a row [ASSUMPTION]", minval = 2, group = G_IM,
     tooltip = "[26:17] 'a big move with only bearish or bullish candles that hasn't gotten filled'.")
float imbMinATR = input.float(2.0, "…moving at least this × ATR(14) (significant) [ASSUMPTION]", minval = 0.5, step = 0.5, group = G_IM,
     tooltip = "You asked: significant enough that price will want to come back. Filled = price trades back to where the move started.")

const string G_MG = "Trade management [35:41–36:20]"
bool  useMgmt  = input.bool(true, "Opposite no-wick → breakeven", group = G_MG,
     tooltip = "Once a no-wick against you closes (same timeframe as the trade): wait for price to come a bit your way, then SL to breakeven. If you are in drawdown at that moment, TP to breakeven instead.")
float beAfterR = input.float(0.25, "'A bit' = price moves this many R your way [ASSUMPTION]", minval = 0, step = 0.05, group = G_MG)

const string G_AV = "Trades to avoid [36:20–37:08]"
bool  avConflict = input.bool(true, "1. Avoid conflicting no-wicks", group = G_AV,
     tooltip = "'two no-wicks telling different stories' — an opposite no-wick (same timeframe) prints while a setup waits → setup dropped.")
bool  avHuge  = input.bool(true, "4. Avoid huge SL & TP", group = G_AV)
float hugeATR = input.float(3.0, "…huge = stop wider than this × ATR(14) [ASSUMPTION]", minval = 0.5, step = 0.5, group = G_AV)
bool  avLate  = input.bool(true, "5. Avoid late trends", group = G_AV,
     tooltip = "[17:54–19:30] 'early trend always beats late trend'. Maximum consecutive BOS in the trade direction.")
int   lateBOS = input.int(3, "…late = more than this many BOS in a row [ASSUMPTION]", minval = 2, group = G_AV)
bool  avNews  = input.bool(false, "6. Avoid red-folder news ±1h (needs your news list)", group = G_AV)
string newsList = input.text_area("", "Red-folder news, New York time, one per line: 2026-09-11 08:30", group = G_AV)
// 2. counter-trend → trend rules. 3. decision areas → later layer. 7. session → below. 8. confidence → not codeable.

const string G_SS = "Sessions, New York time [16:42–17:02] — clock times are [ASSUMPTION]"
string sAsiaLate = input.session("2200-0400", "Trade: late Asia", group = G_SS,
     tooltip = "Trade London, NY and late Asia; avoid the first 3 hours of Asia (Asia ≈ 19:00 NY → avoid 19:00–22:00).")
string sLondon   = input.session("0300-1200", "Trade: London", group = G_SS)
string sNY       = input.session("0800-1500", "Trade: NY (ends before 'late NY')", group = G_SS)
string sAvoidNYO = input.session("0930-1030", "Avoid: NYSE open", group = G_SS)
string sAvoidLNY = input.session("1500-1700", "Avoid: late NY (before 17:00 close)", group = G_SS)

const string G_RO = "Account rotation [37:30–38:20]"
bool useRot = input.bool(false, "Simulate 3-account rotation (daily stop)", group = G_RO,
     tooltip = "Move to the next account after 2 wins or 1 loss; after all 3, stop for the day (resets 17:00 New York).")

const string G_RK = "Size & costs"
float riskPct   = input.float(1.0, "Risk per trade: % of the STARTING balance", minval = 0.01, step = 0.25, group = G_RK,
     tooltip = "Every trade risks the same amount (1% of initial capital), whatever the balance becomes. Results are shown in %.")
float spreadPip = input.float(1.0, "Spread (pips) — charged in the results table", minval = 0, step = 0.1, group = G_RK)

const string G_UI = "Display"
bool showNW    = input.bool(true, "Mark 15m no-wick candles (▲ bull / ▼ bear)", group = G_UI)
bool showTable = input.bool(true, "Results table", group = G_UI)

// ════════════════════════════════════════════════════════════════════════════════════════════════
// GUARDS & UNITS
// ════════════════════════════════════════════════════════════════════════════════════════════════
if barstate.isfirst and timeframe.in_seconds() != 900
    runtime.error("Use the 15-minute chart — he looks for trades on the 15m [14:56].")
if barstate.isfirst and syminfo.type != "forex"
    runtime.error("This model is for his forex pairs (AUDUSD, AUDJPY, GBPUSD, USDJPY, USDCHF, AUDCHF) [16:12].")

float pip    = syminfo.currency == "JPY" ? 0.01 : 0.0001
float breath = breathPips * pip

// ════════════════════════════════════════════════════════════════════════════════════════════════
// PER-TIMEFRAME ENGINE — one light state object per timeframe (15m, 30m, 1h, 4h).
// The other timeframes only send their CLOSED candles (open/high/low/close); the structure is then
// computed here, exactly as if you were looking at that chart. This keeps the script light.
// ════════════════════════════════════════════════════════════════════════════════════════════════
type TF
    int          tf
    array<float> bt
    array<float> bb
    array<float> hi
    array<float> lo
    array<bool>  dj
    float atr = na
    int   nATR = 0
    float prevC = na
    float shL = na
    float slL = na
    bool  shB = false
    bool  slB = false
    int   tr = 0
    int   cnt = 0
    float sh1w = na
    float sh2w = na
    float sh3w = na
    float sl1w = na
    float sl2w = na
    float sl3w = na
    float sh1b = na
    float sh2b = na
    float sl1b = na
    float sl2b = na
    float legLow = na
    float legHi = na
    float legHigh = na
    float legLo = na
    float ndH = na
    float ndL = na
    float pvH = na
    float pvL = na
    int   bearRun = 0
    int   bullRun = 0
    float bearStart = na
    float bullStart = na
    float imbDnTop = na
    float imbUpBot = na
    float o = na
    float c = na
    int   tc = 0
    bool  bull = false
    bool  bear = false

f_newTF(int tf) =>
    TF.new(tf = tf, bt = array.new<float>(), bb = array.new<float>(), hi = array.new<float>(), lo = array.new<float>(), dj = array.new<bool>())

// Feed one CLOSED candle of this timeframe.
// Structure [07:01–11:14]: body swings (N candles each side); a BOS = a CLOSE beyond the most recent
// swing [09:21 "always the closure… always the bodies"]; trend = direction of the most recent BOS
// [10:57]; dojis are not structure [29:27].
method upd(TF s, float o, float h, float l, float c, int tc) =>
    float bt   = math.max(o, c)
    float bb   = math.min(o, c)
    float rng  = h - l
    bool  doji = rng > 0 and math.abs(c - o) <= dojiPct / 100 * rng
    // ATR(14), Wilder
    float trv = na(s.prevC) ? rng : math.max(rng, math.abs(h - s.prevC), math.abs(l - s.prevC))
    s.nATR += 1
    s.atr := na(s.atr) ? trv : s.atr + (trv - s.atr) / math.min(s.nATR, 14)
    // previous non-doji candle (previous-candle stop [29:35–29:56])
    s.pvH := s.ndH
    s.pvL := s.ndL
    if not doji
        s.ndH := h
        s.ndL := l
    // candle buffer for swing detection
    s.bt.push(bt)
    s.bb.push(bb)
    s.hi.push(h)
    s.lo.push(l)
    s.dj.push(doji)
    int need = 2 * pivLen + 1
    while s.bt.size() > need
        s.bt.shift()
        s.bb.shift()
        s.hi.shift()
        s.lo.shift()
        s.dj.shift()
    s.legHi := na(s.legHi) ? bt : math.max(s.legHi, bt)
    s.legLo := na(s.legLo) ? bb : math.min(s.legLo, bb)
    if s.bt.size() == need and not s.dj.get(pivLen)
        float cbt = s.bt.get(pivLen)
        float cbb = s.bb.get(pivLen)
        bool isPH = true
        bool isPL = true
        float hiAfter = cbt
        float loAfter = cbb
        for k = 0 to need - 1
            if k < pivLen
                if s.bt.get(k) >= cbt
                    isPH := false
                if s.bb.get(k) <= cbb
                    isPL := false
            else if k > pivLen
                if s.bt.get(k) > cbt
                    isPH := false
                if s.bb.get(k) < cbb
                    isPL := false
                hiAfter := math.max(hiAfter, s.bt.get(k))
                loAfter := math.min(loAfter, s.bb.get(k))
        if isPH
            s.shL := cbt
            s.shB := false
            s.sh3w := s.sh2w
            s.sh2w := s.sh1w
            s.sh1w := s.hi.get(pivLen)
            s.sh2b := s.sh1b
            s.sh1b := cbt
            s.legHigh := cbt
            s.legLo   := loAfter
        if isPL
            s.slL := cbb
            s.slB := false
            s.sl3w := s.sl2w
            s.sl2w := s.sl1w
            s.sl1w := s.lo.get(pivLen)
            s.sl2b := s.sl1b
            s.sl1b := cbb
            s.legLow := cbb
            s.legHi  := hiAfter
    if not na(s.shL) and not s.shB and c > s.shL
        s.shB := true
        s.cnt := s.tr == 1 ? s.cnt + 1 : 1
        s.tr  := 1
    if not na(s.slL) and not s.slB and c < s.slL
        s.slB := true
        s.cnt := s.tr == -1 ? s.cnt + 1 : 1
        s.tr  := -1
    // No-wick candle [02:15–02:57]: bullish with NO bottom wick / bearish with NO top wick (exact).
    s.bull := c > o and o - l <= syminfo.mintick * 0.01
    s.bear := c < o and h - o <= syminfo.mintick * 0.01
    // Imbalance [26:17–28:31]: ≥ imbMinN candles of one colour in a row moving ≥ imbMinATR × ATR;
    // the latest unfilled one of each kind is kept; filled = price trades back to where it started.
    bool isBear = c < o
    bool isBull = c > o
    if not isBear and s.bearRun >= imbMinN and not na(s.prevC) and s.bearStart - s.prevC >= imbMinATR * s.atr
        s.imbDnTop := s.bearStart
    if not isBull and s.bullRun >= imbMinN and not na(s.prevC) and s.prevC - s.bullStart >= imbMinATR * s.atr
        s.imbUpBot := s.bullStart
    if isBear
        if s.bearRun == 0
            s.bearStart := o
        s.bearRun += 1
    else
        s.bearRun := 0
    if isBull
        if s.bullRun == 0
            s.bullStart := o
        s.bullRun += 1
    else
        s.bullRun := 0
    if not na(s.imbDnTop) and h >= s.imbDnTop
        s.imbDnTop := na
    if not na(s.imbUpBot) and l <= s.imbUpBot
        s.imbUpBot := na
    s.prevC := c
    s.o  := o
    s.c  := c
    s.tc := tc

var TF st15  = f_newTF(15)
var TF st30  = f_newTF(30)
var TF st60  = f_newTF(60)
var TF stExt = f_newTF(240)

// Closed candles of the real 30m / 1h / 4h charts. Two requests per timeframe: (a) the candle that
// closes on this 15m bar (lookahead off), and (b) the previous closed candle (classic non-repainting
// form) as a fallback, so every closed candle is fed exactly once and never before it has closed.
[o30a, h30a, l30a, c30a, t30a] = request.security(syminfo.tickerid, "30", [open, high, low, close, time_close], lookahead = barmerge.lookahead_off)
[o30b, h30b, l30b, c30b, t30b] = request.security(syminfo.tickerid, "30", [open[1], high[1], low[1], close[1], time_close[1]], lookahead = barmerge.lookahead_on)
[o60a, h60a, l60a, c60a, t60a] = request.security(syminfo.tickerid, "60", [open, high, low, close, time_close], lookahead = barmerge.lookahead_off)
[o60b, h60b, l60b, c60b, t60b] = request.security(syminfo.tickerid, "60", [open[1], high[1], low[1], close[1], time_close[1]], lookahead = barmerge.lookahead_on)
[oEb, hEb, lEb, cEb, tEb]      = request.security(syminfo.tickerid, extTF, [open[1], high[1], low[1], close[1], time_close[1]], lookahead = barmerge.lookahead_on)

var int last30 = 0
var int last60 = 0
var int lastE  = 0
bool closed15 = barstate.isconfirmed
bool closed30 = false
bool closed60 = false
if barstate.isconfirmed
    st15.upd(open, high, low, close, time_close)
    if t30a == time_close and t30a > last30
        st30.upd(o30a, h30a, l30a, c30a, t30a)
        last30 := t30a
        closed30 := true
    else if not na(t30b) and t30b > last30
        st30.upd(o30b, h30b, l30b, c30b, t30b)
        last30 := t30b
        closed30 := true
    if t60a == time_close and t60a > last60
        st60.upd(o60a, h60a, l60a, c60a, t60a)
        last60 := t60a
        closed60 := true
    else if not na(t60b) and t60b > last60
        st60.upd(o60b, h60b, l60b, c60b, t60b)
        last60 := t60b
        closed60 := true
    if not na(tEb) and tEb > lastE
        stExt.upd(oEb, hEb, lEb, cEb, tEb)                         // external trend: 4h [12:25]
        lastE := tEb
int extTr = stExt.tr

f_st(int tf) =>
    tf == 60 ? st60 : tf == 30 ? st30 : st15

// Did a no-wick of timeframe tf (direction dir) close on this bar?
f_nwClosed(int tf, int dir) =>
    TF s = f_st(tf)
    bool cl = tf == 60 ? closed60 : tf == 30 ? closed30 : closed15
    cl and (dir == 1 ? s.bull : s.bear)

// ════════════════════════════════════════════════════════════════════════════════════════════════
// SESSIONS [16:42–17:02], NEWS [36:46], DAY
// ════════════════════════════════════════════════════════════════════════════════════════════════
f_in(string s) =>
    not na(time(timeframe.period, s, TZ))
bool inSession = (f_in(sAsiaLate) or f_in(sLondon) or f_in(sNY)) and not f_in(sAvoidNYO) and not f_in(sAvoidLNY)

var array<int> newsTs = array.new<int>()
if barstate.isfirst and avNews and str.length(newsList) > 0
    for ln in str.split(newsList, "\n")
        array<string> pr = str.split(str.trim(ln), " ")
        if pr.size() >= 2
            array<string> d = str.split(pr.get(0), "-")
            array<string> t = str.split(pr.get(1), ":")
            if d.size() == 3 and t.size() == 2
                newsTs.push(timestamp(TZ, int(str.tonumber(d.get(0))), int(str.tonumber(d.get(1))), int(str.tonumber(d.get(2))),
                     int(str.tonumber(t.get(0))), int(str.tonumber(t.get(1))), 0))
f_nearNews() =>
    bool hit = false
    if avNews and newsTs.size() > 0
        for t in newsTs
            if math.abs(time - t) <= 3600000 or math.abs(time_close - t) <= 3600000
                hit := true
                break
    hit
bool canTradeNow = inSession and not f_nearNews()

bool after17 = hour(time, TZ) >= 17
bool newDay  = after17 and not after17[1]                 // forex day rolls at 17:00 New York


// ════════════════════════════════════════════════════════════════════════════════════════════════
// SETUP BUILDER — uses the timeframe the no-wick formed on (your rule)
// ════════════════════════════════════════════════════════════════════════════════════════════════
// Returns [status, entry, stop, tp, usedImbalance]:
//   1 ok · 0 not allowed by trend · 2 no valid stop · 3 huge stop · 4 imbalance target < 1R
f_build(int dir, TF s) =>
    int   status = 0
    float lvl    = s.o                                             // the no-wick's flat side = its open [04:23–04:31]
    float entry  = lvl
    float stop   = na
    float tp     = na
    bool  usedImb = false
    // Trend [12:37–14:34]: only the 4h direction (one internal BOS); against the 4h — or with no 4h
    // trend yet — only after two BOS in a row on the internal (his "two-step BOS" exception).
    bool aligned = s.tr == dir and (extTr == dir ? s.cnt >= 1 : s.cnt >= 2)
    // Imbalance exception [26:42–27:21]: one-step BOS against the 4h is OK if an unfilled imbalance
    // lies in the trade direction; TP at the imbalance [27:13].
    float imbTgt = dir == 1 ? s.imbDnTop : s.imbUpBot
    bool  imbOK  = useImb and not aligned and s.tr == dir and s.cnt == 1 and not na(imbTgt) and (dir == 1 ? imbTgt > lvl : imbTgt < lvl)
    bool  late   = avLate and s.cnt > lateBOS                      // 5. late trends [36:42]
    if (aligned or imbOK) and not late
        // Pre-entry [30:06–33:29] — only when the no-wick sits low in the leg (below the 0.5, bodies).
        float mid = dir == 1 ? s.legLow + 0.5 * (s.legHi - s.legLow) : s.legHigh - 0.5 * (s.legHigh - s.legLo)
        bool  lowInLeg = not na(mid) and (dir == 1 ? lvl < mid : lvl > mid)
        if preMode == "Gann box 0.5" and lowInLeg
            entry := mid                                           // "you enter at the 0.5" [32:39]
        else if preMode == "Retest area" and lowInLeg
            // previous high (long) / previous low (short) between the level and price [31:57–32:25]
            float r1 = dir == 1 ? s.sh1b : s.sl1b
            float r2 = dir == 1 ? s.sh2b : s.sl2b
            if not na(r1) and (dir == 1 ? r1 > lvl and r1 < s.c : r1 < lvl and r1 > s.c)
                entry := r1
            else if not na(r2) and (dir == 1 ? r2 > lvl and r2 < s.c : r2 < lvl and r2 > s.c)
                entry := r2
        // Stop [05:26–05:45] [28:29–29:56]
        if slMode == "Structure"
            if dir == 1                                             // most recent swing low below entry (wick)
                stop := not na(s.sl1w) and s.sl1w < entry ? s.sl1w : not na(s.sl2w) and s.sl2w < entry ? s.sl2w : not na(s.sl3w) and s.sl3w < entry ? s.sl3w : na
                stop := na(stop) ? na : stop - breath
            else                                                    // most recent swing high above entry (wick)
                stop := not na(s.sh1w) and s.sh1w > entry ? s.sh1w : not na(s.sh2w) and s.sh2w > entry ? s.sh2w : not na(s.sh3w) and s.sh3w > entry ? s.sh3w : na
                stop := na(stop) ? na : stop + breath
        else
            stop := dir == 1 ? (na(s.pvL) ? na : s.pvL - breath) : (na(s.pvH) ? na : s.pvH + breath)
        if na(stop) or (dir == 1 and stop >= entry) or (dir == -1 and stop <= entry)
            status := 2
        else if avHuge and not na(s.atr) and math.abs(entry - stop) > hugeATR * s.atr   // 4. huge SL & TP [36:32]
            status := 3
        else
            float risk = math.abs(entry - stop)
            tp := entry + dir * rrTarget * risk                     // TP 1:1 [05:47]
            if imbOK
                // "TP at the top of the imbalance. A bit of a higher R than 1:1" [27:13–27:21]
                if (imbTgt - entry) * dir >= risk
                    tp := imbTgt
                    usedImb := true
                    status := 1
                else
                    status := 4
            else
                status := 1
                if useTPprio
                    // stop-loss priority [33:35–35:03]: swings in the way of the 1R target → lower TP
                    float s1 = dir == 1 ? s.sh1b : s.sl1b
                    float s2 = dir == 1 ? s.sh2b : s.sl2b
                    int   n  = 0
                    float first = na
                    if not na(s1) and (dir == 1 ? s1 > entry and s1 < tp : s1 < entry and s1 > tp)
                        n += 1
                        first := s1
                    if not na(s2) and (dir == 1 ? s2 > entry and s2 < tp : s2 < entry and s2 > tp)
                        n += 1
                        first := na(first) ? s2 : dir == 1 ? math.min(first, s2) : math.max(first, s2)
                    if n >= tpPrioN and not na(first)
                        tp := first
    [status, entry, stop, tp, usedImb]

// ════════════════════════════════════════════════════════════════════════════════════════════════
// BOOK-KEEPING TYPES
// ════════════════════════════════════════════════════════════════════════════════════════════════
type Setup
    string id
    int    dir
    int    tf
    float  entry
    float  stop
    float  tp
    int    expiry      // last close time on which the tap may happen
    bool   imb
    line   ln

type Live
    string id
    int    dir
    int    tf
    float  entry
    float  stop
    float  tp
    float  risk
    bool   oppSeen
    bool   beDone

var array<Setup> pend = array.new<Setup>()
var array<Live>  live = array.new<Live>()
var map<string, float> riskById = map.new<string, float>()
var map<string, int>   tfById   = map.new<string, int>()
var int seq = 0

var int cntSetups = 0
var int cntS15 = 0
var int cntS30 = 0
var int cntS60 = 0
var int cntImb = 0
var int cntNoStop = 0
var int cntHuge = 0
var int cntImbShort = 0
var int cntExpired = 0
var int cntConflict = 0

f_retire(line ln) =>
    if not na(ln)
        ln.set_x2(bar_index)
        ln.set_color(color.new(color.gray, 50))
        ln.set_style(line.style_dotted)

f_openIdx(string id) =>
    int res = -1
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            if strategy.opentrades.entry_id(i) == id
                res := i
                break
    res

// ════════════════════════════════════════════════════════════════════════════════════════════════
// FILLS, CLOSED TRADES (ledger in R and %), ACCOUNT ROTATION
// ════════════════════════════════════════════════════════════════════════════════════════════════
var int processed = 0
var int nT = 0
var int nW = 0
var int nL = 0
var int nBE = 0
var float sumR = 0.0
var float sumRnet = 0.0
var float peakR = 0.0
var float maxDDR = 0.0
var int rotAcc  = 0
var int rotWins = 0
if newDay
    rotAcc  := 0
    rotWins := 0

// pending → live when filled
int np = pend.size()
if np > 0
    for j = np - 1 to 0
        Setup s = pend.get(j)
        int oi = f_openIdx(s.id)
        if oi >= 0
            float ep = strategy.opentrades.entry_price(oi)
            live.push(Live.new(s.id, s.dir, s.tf, ep, s.stop, s.tp, math.abs(s.entry - s.stop), false, false))
            f_retire(s.ln)
            box.new(bar_index, math.max(ep, s.stop), bar_index + 8, math.min(ep, s.stop), border_color = color.new(color.red, 40), bgcolor = color.new(color.red, 85))
            box.new(bar_index, math.max(ep, s.tp), bar_index + 8, math.min(ep, s.tp), border_color = color.new(color.green, 40), bgcolor = color.new(color.green, 85))
            pend.remove(j)

if strategy.closedtrades > processed
    for i = processed to strategy.closedtrades - 1
        string eid = strategy.closedtrades.entry_id(i)
        float  ep  = strategy.closedtrades.entry_price(i)
        float  xp  = strategy.closedtrades.exit_price(i)
        int    d   = strategy.closedtrades.size(i) > 0 ? 1 : -1
        float  rk  = riskById.contains(eid) ? riskById.get(eid) : math.abs(ep - xp)
        float  r   = rk > 0 ? (xp - ep) * d / rk : 0.0
        float  rn  = r - (rk > 0 ? spreadPip * pip / rk : 0.0)
        nT += 1
        sumR += r
        sumRnet += rn
        peakR := math.max(peakR, sumRnet)
        maxDDR := math.max(maxDDR, peakR - sumRnet)
        if math.abs(xp - ep) < syminfo.mintick
            nBE += 1                                                  // breakeven: no rotation step
        else if r > 0
            nW += 1
            rotWins += 1
            if rotWins >= 2                                           // two wins → next account [37:58]
                rotAcc  += 1
                rotWins := 0
        else
            nL += 1
            rotAcc  += 1                                              // one loss → next account [37:58]
            rotWins := 0
        // drop from live / pending lists
        int nl = live.size()
        if nl > 0
            for k = nl - 1 to 0
                if live.get(k).id == eid
                    live.remove(k)
        int npp = pend.size()
        if npp > 0
            for k = npp - 1 to 0
                if pend.get(k).id == eid                              // filled and closed in the same bar
                    f_retire(pend.get(k).ln)
                    pend.remove(k)
    processed := strategy.closedtrades

bool rotHalt = useRot and rotAcc >= 3                                 // done for the day [38:06–38:16]

// ════════════════════════════════════════════════════════════════════════════════════════════════
// EXPIRY, CONFLICTS, NEW SETUPS (confirmed bars only)
// ════════════════════════════════════════════════════════════════════════════════════════════════
if barstate.isconfirmed
    int n0 = pend.size()
    if n0 > 0
        for j = n0 - 1 to 0
            Setup s = pend.get(j)
            bool drop = false
            if rotHalt
                drop := true
            else if time_close >= s.expiry                                // no tap within 9 candles [04:47–05:11]
                drop := true
                cntExpired += 1
            else if avConflict and f_nwClosed(s.tf, -s.dir)               // 1. conflicting no-wicks [36:20]
                drop := true
                cntConflict += 1
            if drop
                strategy.cancel(s.id)
                f_retire(s.ln)
                pend.remove(j)

    if not rotHalt
        // 1h first, then 30m, then 15m [15:06–16:10]; each on its own real chart.
        for c = 0 to 2
            int tf = c == 0 ? 60 : c == 1 ? 30 : 15
            bool okTF = tf == 15 or useHTFprio
            for dd = 0 to 1
                int dir = dd == 0 ? 1 : -1
                if okTF and f_nwClosed(tf, dir)
                    TF stf = f_st(tf)
                    [st, en, sp, tp, im] = f_build(dir, stf)
                    if st == 1
                        seq += 1
                        string id = "NW" + str.tostring(tf) + "_" + str.tostring(seq)
                        int barsBack = int(tf / 15) - 1
                        line ln = line.new(bar_index - barsBack, en, bar_index, en, color = dir == 1 ? color.teal : color.red, width = tf == 15 ? 1 : tf == 30 ? 2 : 3)
                        pend.push(Setup.new(id, dir, tf, en, sp, tp, stf.tc + tapWindow * tf * 60000, im, ln))
                        riskById.put(id, math.abs(en - sp))
                        tfById.put(id, tf)
                        cntSetups += 1
                        cntS15 += tf == 15 ? 1 : 0
                        cntS30 += tf == 30 ? 1 : 0
                        cntS60 += tf == 60 ? 1 : 0
                        cntImb += im ? 1 : 0
                    else if st == 2
                        cntNoStop += 1
                    else if st == 3
                        cntHuge += 1
                    else if st == 4
                        cntImbShort += 1

// ════════════════════════════════════════════════════════════════════════════════════════════════
// ORDERS — several setups at once, but only ONE timeframe at a time (your rule):
//   • with trades open: only setups of the same timeframe and direction may fill;
//   • when flat: only the highest timeframe that has setups waiting (higher timeframe priority).
// Entry on the tap, limit order at the level [05:19–05:25]; live only in session / away from news.
// ════════════════════════════════════════════════════════════════════════════════════════════════
int lockTF  = 0
int lockDir = 0
if live.size() > 0
    lockTF  := live.get(0).tf
    lockDir := live.get(0).dir
else if pend.size() > 0
    for s in pend
        lockTF := math.max(lockTF, s.tf)

float riskCash = strategy.initial_capital * riskPct / 100           // fixed 1% of the starting balance
if barstate.isconfirmed and pend.size() > 0
    for s in pend
        bool may = canTradeNow and not rotHalt and s.tf == lockTF and (lockDir == 0 or s.dir == lockDir)
        float rd = math.abs(s.entry - s.stop)
        float units = rd > 0 ? math.floor(strategy.convert_to_symbol(riskCash) / (rd * syminfo.pointvalue)) : 0
        if may and units >= 1
            strategy.entry(s.id, s.dir == 1 ? strategy.long : strategy.short, qty = units, limit = s.entry,
                 comment = (s.dir == 1 ? "L " : "S ") + str.tostring(s.tf) + "m" + (s.imb ? " IMB" : ""))
            strategy.exit(s.id + "-X", from_entry = s.id, stop = s.stop, limit = s.tp, comment_loss = "SL", comment_profit = "TP")
        else
            strategy.cancel(s.id)
        if not na(s.ln)
            s.ln.set_x2(bar_index)

// ════════════════════════════════════════════════════════════════════════════════════════════════
// IN THE TRADE — management [35:41–36:20], per trade, on the trade's own timeframe
// ════════════════════════════════════════════════════════════════════════════════════════════════
if useMgmt and live.size() > 0
    for t in live
        if f_nwClosed(t.tf, -t.dir) and not t.oppSeen
            t.oppSeen := true
            bool inDD = t.dir == 1 ? close < t.entry : close > t.entry
            if inDD
                t.tp := t.entry                                         // "in drawdown → TP to break even"
                strategy.exit(t.id + "-X", from_entry = t.id, stop = t.stop, limit = t.tp, comment_loss = "SL", comment_profit = "TP-BE")
        if barstate.isconfirmed and t.oppSeen and not t.beDone and t.tp != t.entry
            bool aBit = t.dir == 1 ? close >= t.entry + beAfterR * t.risk : close <= t.entry - beAfterR * t.risk
            if aBit
                t.beDone := true
                t.stop   := t.entry                                     // "move stop loss to break even"
                strategy.exit(t.id + "-X", from_entry = t.id, stop = t.stop, limit = t.tp, comment_loss = "BE", comment_profit = "TP")

// ════════════════════════════════════════════════════════════════════════════════════════════════
// PLOTS & TABLE (returns in % — every trade risks riskPct % of the starting balance)
// ════════════════════════════════════════════════════════════════════════════════════════════════
plotshape(showNW and closed15 and st15.bull, "Bullish no-wick (15m)", shape.triangleup,   location.belowbar, color.new(color.yellow, 0), size = size.tiny)
plotshape(showNW and closed15 and st15.bear, "Bearish no-wick (15m)", shape.triangledown, location.abovebar, color.new(color.yellow, 0), size = size.tiny)
plotshape(showNW and closed30 and (st30.bull or st30.bear), "No-wick closed on the 30m", shape.diamond, location.top, color.new(color.aqua, 0), size = size.tiny)
plotshape(showNW and closed60 and (st60.bull or st60.bear), "No-wick closed on the 1h", shape.diamond, location.bottom, color.new(color.fuchsia, 0), size = size.tiny)
bgcolor(not inSession ? color.new(color.gray, 92) : na, title = "Outside trading session")

var table tb = table.new(position.bottom_right, 2, 14, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 60))
f_row(int r, string k, string v) =>
    table.cell(tb, 0, r, k, text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, r, v, text_color = color.white, text_size = size.small, text_halign = text.align_right)
f_pct(float rMult) =>
    (rMult >= 0 ? "+" : "") + str.tostring(rMult * riskPct, "0.00") + "%"
if barstate.islast and showTable
    f_row(0, "No-Wick model — " + syminfo.ticker, "risk " + str.tostring(riskPct, "0.##") + "% / trade")
    f_row(1, "Trades (W / L / BE)", str.tostring(nT) + "  (" + str.tostring(nW) + " / " + str.tostring(nL) + " / " + str.tostring(nBE) + ")")
    f_row(2, "Win rate (excl. BE)", nW + nL > 0 ? str.tostring(100.0 * nW / (nW + nL), "0.0") + "%" : "—")
    f_row(3, "Return (before spread)", f_pct(sumR))
    f_row(4, "Return (after " + str.tostring(spreadPip, "0.0#") + " pip spread)", f_pct(sumRnet))
    f_row(5, "Max drawdown (closed trades)", str.tostring(maxDDR * riskPct, "0.00") + "%")
    f_row(6, "Avg per trade (after spread)", nT > 0 ? f_pct(sumRnet / nT) : "—")
    f_row(7, "Setups 15m / 30m / 1h", str.tostring(cntS15) + " / " + str.tostring(cntS30) + " / " + str.tostring(cntS60))
    f_row(8, "…of which imbalance exception", str.tostring(cntImb))
    f_row(9, "Not tapped within " + str.tostring(tapWindow) + " candles", str.tostring(cntExpired))
    f_row(10, "Skipped: no stop / huge SL / imb < 1R", str.tostring(cntNoStop) + " / " + str.tostring(cntHuge) + " / " + str.tostring(cntImbShort))
    f_row(11, "Dropped: conflicting no-wick", str.tostring(cntConflict))
    f_row(12, "Stop / pre-entry", slMode + " / " + preMode)
    f_row(13, "Rotation", useRot ? "on (account " + str.tostring(math.min(rotAcc + 1, 3)) + "/3 today" + (rotHalt ? ", done" : "") + ")" : "off")

