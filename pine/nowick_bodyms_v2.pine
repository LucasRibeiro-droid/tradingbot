//
// ════════════════════════════════════════════════════════════════════════════════════════════════
//  NO-WICK × BODY MARKET STRUCTURE — futures, 5m or 15m
//
//  TREND = your Body Market Structure logic (bodies only, a level breaks only on a CLOSE).
//  ENTRY: confirmed bullish trend + bullish no-wick (no bottom wick) = BUY at the no-wick open on
//         the tap; confirmed bearish trend + bearish no-wick = SELL.
//  STOP:  buy → beyond the WICK of the protected HL; sell → beyond the WICK of the protected LH;
//         + breathing room (default 5 pips).
//  TP:    1:1.  PRE-ENTRY: if the stop is more than 10 pips away, enter 2 pips before the tap.
//  NO TRADE: external structure before the tap · tap after 10 candles · choppy · NTZ 20–24 London
//            (positions closed when the NTZ starts) · while a CHoCH is pending (default).
//  EARLY EXIT: only on an A setup against us (reversal confirmed after entry + opposite no-wick).
//  RISK: 1% of current equity per trade (option: starting balance).
//
//  CHART: only the trades are labelled — each trade shows its entry / SL / TP, the HL or LH used
//  for the stop and the HH or LL that confirmed the trend. All labels are anchored to their
//  candle (above / below the bar), so they never drift away from the candles.
// ════════════════════════════════════════════════════════════════════════════════════════════════

//@version=6
strategy(title = "No-Wick × Body Structure (futures 5m/15m)",
     shorttitle = "NW BodyMS",
     overlay = true,
     scale = scale.right,
     pyramiding = 10,
     initial_capital = 100000,
     currency = currency.USD,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 0,                 // costs are charged in the results table
     slippage = 0,
     margin_long = 0,
     margin_short = 0,
     close_entries_rule = "ANY",
     process_orders_on_close = false,
     calc_on_every_tick = false,
     use_bar_magnifier = false,            // free plan: keep off
     max_labels_count = 500)

// ════════════════════════════════════════════════════════════════════════════════════════════════
// INPUTS
// ════════════════════════════════════════════════════════════════════════════════════════════════
const string G_P = "Pips"
float pipPts = input.float(1.0, "1 pip = this many points", minval = 0.01, step = 0.25, group = G_P,
     tooltip = "Futures have no pips. Default 1 point (= 4 ticks on NQ/ES). Set 0.25 if you mean ticks on NQ/ES.")

const string G_E = "Entry / stop / target"
float breathPips  = input.float(5.0, "Breathing room beyond the HL/LH wick (pips)", minval = 0, step = 0.5, group = G_E)
float preIfSLPips = input.float(10.0, "Pre-entry if SL is more than (pips)", minval = 0, step = 0.5, group = G_E)
float prePips     = input.float(2.0, "…enter this many pips before the tap", minval = 0, step = 0.5, group = G_E)
float rrTarget    = input.float(1.0, "Take profit (R)", minval = 0.1, step = 0.1, group = G_E)
int   tapWindow   = input.int(10, "Tap must happen within (candles)", minval = 1, group = G_E)
int   maxOpen     = input.int(1, "Max open trades at once", minval = 1, maxval = 10, group = G_E)

const string G_F = "Filters"
string pendMode = input.string("No trades", "While a CHoCH is pending", options = ["No trades", "Old trend", "New direction"], group = G_F,
     tooltip = "A CHoCH is not a confirmed reversal until its HL/LH + BOS.\nNo trades: wait for confirmation (or for the CHoCH to fail).\nOld trend: keep trading the previous trend.\nNew direction: already trade the CHoCH direction.")
int    chopBars = input.int(30, "Choppy: no external structure for this many candles → no trades", minval = 5, group = G_F)
string ntz      = input.session("2000-0000", "No trading zone (London time)", group = G_F)
bool   useA     = input.bool(true, "Close on an A setup against us (and take the new one)", group = G_F)

const string G_C = "Size & costs"
float  riskPct   = input.float(1.0, "Risk per trade (%)", minval = 0.01, step = 0.25, group = G_C)
string riskBase  = input.string("Current equity", "…of", options = ["Current equity", "Starting balance"], group = G_C)
float  commSide  = input.float(2.25, "Commission per contract per side ($) — NQ ≈ 2.25, MNQ ≈ 0.62", minval = 0, step = 0.05, group = G_C)
int    slipTicks = input.int(1, "Slippage on stop / market exits (ticks)", minval = 0, group = G_C)

const string G_D = "Display"
bool showNW    = input.bool(true, "Mark no-wick candles", group = G_D)
bool showTable = input.bool(true, "Results table", group = G_D)
color bullCol = color.teal
color bearCol = color.red

if barstate.isfirst and timeframe.in_seconds() != 300 and timeframe.in_seconds() != 900
    runtime.error("Use the 5-minute or 15-minute chart.")
if barstate.isfirst and syminfo.type != "futures"
    runtime.error("Built for futures (e.g. NQ1!, MNQ1!, ES1!, MES1!).")

float pip    = pipPts
float breath = breathPips * pip

// ════════════════════════════════════════════════════════════════════════════════════════════════
// BODY MARKET STRUCTURE (your logic) — also remembers each level's candle and wick
// ════════════════════════════════════════════════════════════════════════════════════════════════
float bodyTop = math.max(open, close)
float bodyBot = math.min(open, close)
bool  bullCandle = close > open
bool  bearCandle = close < open

var int   dir           = 1
var bool  confirmed     = false
var bool  everConfirmed = false
var float ext      = na         // leg extreme (body)
var float extWick  = na
var int   extBar   = na
var bool  pb       = false
var float pot      = na         // potential HL / LH (body)
var float potWick  = na
var int   potBar   = na
var float prot     = na         // protected HL (uptrend) / LH (downtrend) (body)
var float protWick = na
var int   protBar  = na
var bool  sawCounter = false
var int   lastExtBar = na       // candle of the last confirmed HH (uptrend) / LL (downtrend)

if barstate.isfirst
    ext      := bodyTop
    extWick  := high
    extBar   := bar_index
    prot     := bodyBot
    protWick := low
    protBar  := bar_index

bool structEvent = false
bool revBull = false
bool revBear = false
bool isBull = dir == 1

if isBull ? close < prot : close > prot
    // CHoCH (if a trend was confirmed) or a failed CHoCH (if one was pending)
    structEvent := true
    if not confirmed and everConfirmed
        confirmed := true                       // CHoCH failed → the old trend carries on
    else if confirmed
        confirmed := false                      // CHoCH → pending
    prot     := ext
    protWick := extWick
    protBar  := extBar
    dir      := -dir
    ext      := isBull ? bodyBot : bodyTop
    extWick  := isBull ? low : high
    extBar   := bar_index
    pb       := false
    pot      := na
    potWick  := na
    potBar   := na
    sawCounter := false
else
    if not pb
        if sawCounter and not na(pot) and (isBull ? bullCandle : bearCandle)
            pb := true                          // pullback complete → internal structure
        else
            bool counter = isBull ? bearCandle : bullCandle
            if isBull ? bodyTop >= ext : bodyBot <= ext
                ext     := isBull ? bodyTop : bodyBot
                extWick := isBull ? high : low
                extBar  := bar_index
                sawCounter := counter
                pot     := counter ? (isBull ? bodyBot : bodyTop) : na
                potWick := counter ? (isBull ? low : high) : na
                potBar  := counter ? bar_index : na
            else
                if counter
                    sawCounter := true
                if na(pot) or (isBull ? bodyBot < pot : bodyTop > pot)
                    pot     := isBull ? bodyBot : bodyTop
                    potWick := isBull ? low : high
                    potBar  := bar_index
    if pb
        if isBull ? close > ext : close < ext
            // BOS: the leg extreme becomes the HH / LL, the pullback the protected HL / LH
            structEvent := true
            if not confirmed and everConfirmed
                if isBull
                    revBull := true
                else
                    revBear := true
            confirmed     := true
            everConfirmed := true
            lastExtBar := extBar
            prot     := pot
            protWick := potWick
            protBar  := potBar
            ext      := isBull ? bodyTop : bodyBot
            extWick  := isBull ? high : low
            extBar   := bar_index
            pb       := false
            pot      := na
            potWick  := na
            potBar   := na
            sawCounter := false
        else if isBull ? bodyBot < pot : bodyTop > pot
            pot     := isBull ? bodyBot : bodyTop
            potWick := isBull ? low : high
            potBar  := bar_index

// Trend used for trading
bool pending = everConfirmed and not confirmed
int trend = not everConfirmed ? 0 : confirmed ? dir : pendMode == "Old trend" ? -dir : pendMode == "New direction" ? dir : 0

var int lastEventBar = 0
if structEvent
    lastEventBar := bar_index
bool choppy = bar_index - lastEventBar > chopBars

var int lastRevBar = -1
var int lastRevDir = 0
if revBull
    lastRevBar := bar_index
    lastRevDir := 1
if revBear
    lastRevBar := bar_index
    lastRevDir := -1

bool inNTZ = not na(time(timeframe.period, ntz, "Europe/London"))

bool bullNW = barstate.isconfirmed and close > open and open - low <= syminfo.mintick * 0.01
bool bearNW = barstate.isconfirmed and close < open and high - open <= syminfo.mintick * 0.01
plotshape(showNW and bullNW, "Bullish no-wick", shape.triangleup,   location.belowbar, color.new(color.yellow, 0), size = size.tiny)
plotshape(showNW and bearNW, "Bearish no-wick", shape.triangledown, location.abovebar, color.new(color.yellow, 0), size = size.tiny)

// ════════════════════════════════════════════════════════════════════════════════════════════════
// LABELS — always anchored to the candle (yloc above / below bar), never to a price level
// ════════════════════════════════════════════════════════════════════════════════════════════════
f_tag(int b, string txt, bool above, color col) =>
    if not na(b)
        label.new(b, 0, txt, yloc = above ? yloc.abovebar : yloc.belowbar,
             style = above ? label.style_label_down : label.style_label_up,
             color = color.new(col, 15), textcolor = color.white, size = size.small)

// ════════════════════════════════════════════════════════════════════════════════════════════════
// BOOK-KEEPING
// ════════════════════════════════════════════════════════════════════════════════════════════════
type Setup
    string id
    int    dir
    float  entry
    float  stop
    float  tp
    int    expiryBar
    int    evCount
    int    stopBar      // candle of the HL / LH used for the stop
    string stopTxt
    int    trendBar     // candle of the HH / LL that confirmed the trend
    string trendTxt

type Live
    string id
    int    dir
    int    entryBar

var array<Setup> pend = array.new<Setup>()
var array<Live>  live = array.new<Live>()
var map<string, float> riskById = map.new<string, float>()
var int seq = 0
var int evCount = 0
if structEvent
    evCount += 1

var int cSetups = 0
var int cAgainst = 0
var int cNoTrend = 0
var int cChop = 0
var int cNTZ = 0
var int cBadStop = 0
var int cExpired = 0
var int cStruct = 0
var int cA = 0

f_openIdx(string id) =>
    int res = -1
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            if strategy.opentrades.entry_id(i) == id
                res := i
                break
    res

// fills: label the trade and the swings it used
int np = pend.size()
if np > 0
    for j = np - 1 to 0
        Setup s = pend.get(j)
        if f_openIdx(s.id) >= 0
            live.push(Live.new(s.id, s.dir, bar_index))
            bool isBuy = s.dir == 1
            f_tag(bar_index, (isBuy ? "BUY " : "SELL ") + str.tostring(s.entry, format.mintick) + "\nSL " + str.tostring(s.stop, format.mintick) + "\nTP " + str.tostring(s.tp, format.mintick),
                 not isBuy, isBuy ? bullCol : bearCol)
            f_tag(s.stopBar, s.stopTxt, not isBuy, color.new(color.orange, 0))      // HL below / LH above
            f_tag(s.trendBar, s.trendTxt, isBuy, isBuy ? bullCol : bearCol)       // HH above / LL below
            pend.remove(j)

// closed trades → ledger
var int processed = 0
var int nT = 0
var int nW = 0
var int nL = 0
var float sumR = 0.0
var float eqNet  = 1.0
var float eqPeak = 1.0
var float ddPct  = 0.0
if strategy.closedtrades > processed
    for i = processed to strategy.closedtrades - 1
        string eid = strategy.closedtrades.entry_id(i)
        float ep = strategy.closedtrades.entry_price(i)
        float xp = strategy.closedtrades.exit_price(i)
        int   d  = strategy.closedtrades.size(i) > 0 ? 1 : -1
        float rk = riskById.contains(eid) ? riskById.get(eid) : math.abs(ep - xp)
        float r  = rk > 0 ? (xp - ep) * d / rk : 0.0
        bool  isTP = strategy.closedtrades.exit_comment(i) == "TP"
        float costPts = 2 * commSide / syminfo.pointvalue + (isTP ? 0 : slipTicks * syminfo.mintick)
        float rn = r - (rk > 0 ? costPts / rk : 0.0)
        nT += 1
        sumR += r
        eqNet  := riskBase == "Current equity" ? eqNet * (1 + rn * riskPct / 100) : eqNet + rn * riskPct / 100
        eqPeak := math.max(eqPeak, eqNet)
        ddPct  := math.max(ddPct, (eqPeak - eqNet) / eqPeak * 100)
        if r > 0
            nW += 1
        else
            nL += 1
        int nl = live.size()
        if nl > 0
            for k = nl - 1 to 0
                if live.get(k).id == eid
                    live.remove(k)
        int npp = pend.size()
        if npp > 0
            for k = npp - 1 to 0
                if pend.get(k).id == eid
                    pend.remove(k)
    processed := strategy.closedtrades

// NTZ: close everything
if inNTZ and strategy.position_size != 0
    strategy.close_all(comment = "NTZ")

// ════════════════════════════════════════════════════════════════════════════════════════════════
// SETUPS (confirmed bars)
// ════════════════════════════════════════════════════════════════════════════════════════════════
if barstate.isconfirmed
    int n0 = pend.size()
    if n0 > 0
        for j = n0 - 1 to 0
            Setup s = pend.get(j)
            bool drop = false
            if evCount != s.evCount                 // external structure before the tap
                drop := true
                cStruct += 1
            else if bar_index >= s.expiryBar        // tap after 10 candles
                drop := true
                cExpired += 1
            if drop
                strategy.cancel(s.id)
                pend.remove(j)

    if bullNW or bearNW
        int d = bullNW ? 1 : -1
        // A setup against us: reversal confirmed after our entry + this opposite no-wick → close
        if useA and live.size() > 0 and confirmed and dir == d and lastRevDir == d
            for t in live
                if t.dir == -d and lastRevBar > t.entryBar
                    strategy.close(t.id, comment = "A setup")
                    cA += 1
        if inNTZ
            cNTZ += 1
        else if trend == 0
            cNoTrend += 1
        else if trend != d
            cAgainst += 1
        else if choppy
            cChop += 1
        else
            // which swing protects the trade
            float stopRef  = na
            int   stopBar  = na
            string stopTxt = ""
            int   trendBar = na
            string trendTxt = ""
            if confirmed
                stopRef  := protWick
                stopBar  := protBar
                stopTxt  := d == 1 ? "HL" : "LH"
                trendBar := lastExtBar
                trendTxt := d == 1 ? "HH" : "LL"
            else if pendMode == "Old trend"
                stopRef  := extWick                // the CHoCH leg broke the old HL/LH
                stopBar  := extBar
                stopTxt  := d == 1 ? "CHoCH low" : "CHoCH high"
            else                                    // New direction
                stopRef  := protWick
                stopBar  := protBar
                stopTxt  := d == 1 ? "LL" : "HH"
            float lvl  = open
            float stop = na(stopRef) ? na : d == 1 ? stopRef - breath : stopRef + breath
            if na(stop) or (d == 1 ? stop >= lvl : stop <= lvl)
                cBadStop += 1
            else
                float entry = lvl
                if math.abs(lvl - stop) > preIfSLPips * pip
                    entry := lvl + d * prePips * pip
                float tp = entry + d * rrTarget * math.abs(entry - stop)
                seq += 1
                string id = "NW" + str.tostring(seq)
                pend.push(Setup.new(id, d, entry, stop, tp, bar_index + tapWindow, evCount, stopBar, stopTxt, trendBar, trendTxt))
                riskById.put(id, math.abs(entry - stop))
                cSetups += 1

// ════════════════════════════════════════════════════════════════════════════════════════════════
// ORDERS
// ════════════════════════════════════════════════════════════════════════════════════════════════
float riskCash = (riskBase == "Current equity" ? strategy.equity : strategy.initial_capital) * riskPct / 100
if barstate.isconfirmed and pend.size() > 0
    int slots = maxOpen - live.size()
    int liveDir = live.size() > 0 ? live.get(0).dir : 0
    for j = pend.size() - 1 to 0
        Setup s = pend.get(j)
        float rd = math.abs(s.entry - s.stop)
        int contracts = rd > 0 ? int(math.floor(riskCash / (rd * syminfo.pointvalue))) : 0
        if not inNTZ and slots > 0 and contracts >= 1 and (liveDir == 0 or liveDir == s.dir)
            strategy.entry(s.id, s.dir == 1 ? strategy.long : strategy.short, qty = contracts, limit = s.entry,
                 comment = s.dir == 1 ? "NW L" : "NW S")
            strategy.exit(s.id + "-X", from_entry = s.id, stop = s.stop, limit = s.tp, comment_loss = "SL", comment_profit = "TP")
            slots -= 1
        else
            strategy.cancel(s.id)

// ════════════════════════════════════════════════════════════════════════════════════════════════
// TABLE
// ════════════════════════════════════════════════════════════════════════════════════════════════
var table tb = table.new(position.bottom_right, 2, 11, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 60))
f_row(int r, string k, string v) =>
    table.cell(tb, 0, r, k, text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, r, v, text_color = color.white, text_size = size.small, text_halign = text.align_right)
if barstate.islast and showTable
    f_row(0, "NW × Body structure — " + syminfo.ticker, str.tostring(riskPct, "0.##") + "% of " + (riskBase == "Current equity" ? "equity" : "start bal."))
    f_row(1, "Trend now", (not everConfirmed ? "Forming" : dir == 1 ? "Bullish" : "Bearish") + (pending ? " CHoCH (pending)" : ""))
    f_row(2, "Trades (W / L)", str.tostring(nT) + "  (" + str.tostring(nW) + " / " + str.tostring(nL) + ")")
    f_row(3, "Win rate", nT > 0 ? str.tostring(100.0 * nW / nT, "0.0") + "%" : "—")
    f_row(4, "Return after costs", (eqNet >= 1 ? "+" : "") + str.tostring((eqNet - 1) * 100, "0.00") + "%")
    f_row(5, "Max drawdown", str.tostring(ddPct, "0.00") + "%")
    f_row(6, "Setups placed", str.tostring(cSetups))
    f_row(7, "Dropped: structure before tap / tap > " + str.tostring(tapWindow), str.tostring(cStruct) + " / " + str.tostring(cExpired))
    f_row(8, "Skipped: against / no trend or pending / choppy", str.tostring(cAgainst) + " / " + str.tostring(cNoTrend) + " / " + str.tostring(cChop))
    f_row(9, "Skipped: NTZ / bad stop", str.tostring(cNTZ) + " / " + str.tostring(cBadStop))
    f_row(10, "Closed on A setup", str.tostring(cA))
