// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
//
// ════════════════════════════════════════════════════════════════════════════════════════════════
//  NOWICK BACKTESTER — no-wick candle levels with a momentum (anti-consolidation) filter
//  Cost-aware: commission, slippage on every fill (including limit take-profits) and an optional
//  "trade-through" requirement before a take-profit counts as filled.
//
//  Built for a 3-minute chart of MNQ / ES / MGC / GC (one instrument per chart).
//  All session times are America/New_York, so DST is handled automatically.
//
//  THE SETUP (short; long is the mirror image)
//   1. Momentum: over the last N minutes (default 30) price must have moved down by at least
//      X × ATR, and moved fairly directly (efficiency ratio). Otherwise the market is treated as
//      consolidating and no-wick candles are ignored (marked with a grey ×).
//   2. A bearish candle with no top wick (high − open ≤ tolerance) creates a level at its high
//      (red ▼ above the candle + a red line from it).
//   3. Price must CLOSE above the level (line turns dashed = "armed"), then CLOSE back below it.
//      The short is sent on that close (fills at the next bar's open) unless momentum has turned
//      bullish by then.
//   4. Stop: the previous candle's high. If that is closer than the minimum stop distance, the
//      high of the candle before it is used instead (up to "Candles to look back"). If none is
//      far enough, the trade is skipped.
//   5. Take profit: R multiple of the risk (default 2R).
//   On the chart each trade is drawn as a position box: red = stop zone, green = target zone,
//   white line = entry, with labelled prices, and the result (currency and R) at the exit.
//
//  HOW THE RESULTS ARE PRODUCED
//   TradingView only slips market/stop orders and a Pine limit order has ONE price (trigger =
//   fill). So the take-profit limit sits X ticks beyond the target (trade-through), and the table
//   re-prices every fill: strips the Tester's own slippage, moves TP fills back to the target and
//   charges YOUR Costs inputs on every fill. The TABLE is the realistic ledger; the Tester's own
//   net profit is shown as a reference row.
//
//  ⚠ OPTIMISTIC-FILL WARNINGS are marked with  "⚠ FILL ASSUMPTION"  throughout the code.
// ════════════════════════════════════════════════════════════════════════════════════════════════

//@version=6
strategy(title = "NOWICK Backtester — no-wick levels (cost-aware)",
     shorttitle = "NOWICK",
     overlay = true,
     pyramiding = 1,
     initial_capital = 50000,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     // Commission/slippage here only drive the Strategy Tester's OWN numbers (reference only).
     // Pine requires constants here, so they cannot be linked to inputs; the table uses the
     // "Costs" inputs instead.
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 0.62,
     slippage = 1,
     // Futures: disable TradingView's margin-call simulation.
     margin_long = 0,
     margin_short = 0,
     // Signals on the bar CLOSE; market entries fill at the NEXT bar's OPEN (what you'd get live).
     // ⚠ FILL ASSUMPTION: "Fill orders on bar close" (process_orders_on_close) would fill at the
     // signal close — optimistic, since you only know the close once the bar is over.
     process_orders_on_close = false,
     calc_on_every_tick = false,
     calc_on_order_fills = false,
     // ⚠ FILL ASSUMPTION: without the bar magnifier, when a stop AND a target both lie inside one
     // chart bar, TradingView guesses the intrabar path (extreme closest to the open first). That
     // guess can turn real losers into winners. OFF here because the free plan raises a runtime
     // error when it is on; on a paid plan enable it in the Strategy Tester ("High detalization").
     use_bar_magnifier = false,
     fill_orders_on_standard_ohlc = true,
     // Keep at 0: the script implements its own (input-driven) trade-through for take-profits.
     backtest_fill_limits_assumption = 0,
     max_lines_count = 500,
     max_labels_count = 500,
     max_boxes_count = 500,
     max_bars_back = 500)

// ════════════════════════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ════════════════════════════════════════════════════════════════════════════════════════════════
const string TZ = "America/New_York"
const string ID = "NOWICK"

// ════════════════════════════════════════════════════════════════════════════════════════════════
// INPUTS
// ════════════════════════════════════════════════════════════════════════════════════════════════
const string G_SET = "No-wick setup"
int    wickTolTicks = input.int(0, "Wick tolerance (ticks)", minval = 0, group = G_SET,
     tooltip = "Bearish candle: high − open ≤ this. Bullish candle: open − low ≤ this. 0 = no wick at all.")
int    levelLife    = input.int(20, "Level expires after (bars)", minval = 1, group = G_SET,
     tooltip = "A level is also removed the first time price closes back through it, traded or not.")
float  rrTarget     = input.float(2.0, "Take profit (R multiple)", minval = 0.1, step = 0.1, group = G_SET)
string nwSession    = input.session("0930-1545", "Trading window (ET)", group = G_SET,
     tooltip = "No-wick candles only create levels, and trades are only taken, inside this window.")

const string G_STOP = "Stop loss"
int minStopTicks = input.int(8, "Minimum stop distance (ticks)", minval = 1, group = G_STOP)
int stopLookback = input.int(2, "Candles to look back for the stop", minval = 1, maxval = 10, group = G_STOP,
     tooltip = "1 = previous candle's high/low only.\n2 = previous candle; if that stop is closer than the minimum distance, use the candle before it.\n3+ = keep stepping back one candle at a time.\nIf no candle gives a stop far enough away, the trade is skipped.")
int stopBufTicks = input.int(0, "Stop buffer beyond the candle (ticks)", minval = 0, group = G_STOP)

const string G_MOM = "Momentum (no trades while consolidating)"
int   momMinutes = input.int(30, "Look-back window (minutes)", minval = 6, maxval = 120, group = G_MOM,
     tooltip = "Momentum is measured over this many minutes up to and including the candle being judged (15–30 recommended).")
float momMinMove = input.float(1.0, "Minimum net move (× ATR)", minval = 0, step = 0.1, group = G_MOM,
     tooltip = "Close now vs close at the start of the window must differ by at least this many ATRs. Smaller = consolidation.")
float momMinEff  = input.float(0.35, "Minimum directional efficiency (0–1)", minval = 0, maxval = 1, step = 0.05, group = G_MOM,
     tooltip = "Net move ÷ total distance travelled (close to close) in the window. 1 = straight line, near 0 = chop. 0.3–0.4 filters most sideways action.")
int   atrLen     = input.int(14, "ATR length (bars)", minval = 1, group = G_MOM)
bool  momStrongAtEntry = input.bool(false, "Require momentum still strong at entry", group = G_MOM,
     tooltip = "Off: entry is blocked only if momentum has turned the OTHER way by the close back through the level.\nOn: momentum must still pass both thresholds in the trade's direction at entry.")

const string G_DAY = "Day trading rules"
int   qty    = input.int(1, "Contracts per trade", minval = 1, group = G_DAY)
int   dayH   = input.int(9,  "Trading day starts (ET)  hour", minval = 0, maxval = 23, inline = "day", group = G_DAY)
int   dayM   = input.int(30, "minute", minval = 0, maxval = 59, inline = "day", group = G_DAY,
     tooltip = "Daily reset for the loss limit and the levels. 09:30 for ES/MNQ; e.g. 08:20 for gold.")
int   flatH  = input.int(15, "Flatten all at  hour (ET)", minval = 0, maxval = 23, inline = "flat", group = G_DAY)
int   flatM  = input.int(55, "minute", minval = 0, maxval = 59, inline = "flat", group = G_DAY,
     tooltip = "The flatten order goes out on the close of the first bar that ends at/after this time and fills at the next bar's open. No new entries from then on.")
bool  useDLL    = input.bool(false, "Use daily loss limit", group = G_DAY)
float dllAmount = input.float(500.0, "Daily loss limit (account currency)", minval = 0, group = G_DAY,
     tooltip = "Realised net P&L today + estimated open P&L after costs. Checked on each bar close; when hit, the position is closed and no more trades are taken until the next day.")

const string G_COST = "Costs"
float commPerSide  = input.float(0.62, "Commission per contract per side", minval = 0, step = 0.01, group = G_COST,
     tooltip = "Your broker's all-in rate (commission + exchange + NFA + clearing). Charged on entry AND exit.")
int   slipTicks    = input.int(1, "Slippage per fill (ticks)", minval = 0, group = G_COST,
     tooltip = "Applied against you on every market/stop fill: entries, stop-losses, end-of-day and loss-limit exits.")
bool  slipOnTP     = input.bool(true, "Apply slippage to take-profit (limit) fills too", group = G_COST)
bool  needThrough  = input.bool(true, "Require price to trade THROUGH the target", group = G_COST)
int   throughTicks = input.int(1, "Trade-through distance (ticks)", minval = 0, group = G_COST)
int   testerSlip   = input.int(1, "Slippage set in Properties (ticks)", minval = 0, group = G_COST,
     tooltip = "Must equal Settings ▸ Properties ▸ Slippage, so the table can strip the Tester's own slippage before applying yours.")

const string G_UI = "Display"
bool   showTable    = input.bool(true, "Show results table", group = G_UI)
string tablePosIn   = input.string("Bottom left", "Table position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G_UI)
bool   showNoWick   = input.bool(true, "Mark no-wick candles that create a level", group = G_UI)
bool   showFiltered = input.bool(true, "Mark no-wick candles filtered out (consolidation / outside window)", group = G_UI)
bool   showLevels   = input.bool(true, "Draw level lines", group = G_UI)
bool   showTrades   = input.bool(true, "Draw entry / stop / target boxes for each trade", group = G_UI)
bool   showMomBg    = input.bool(true, "Tint background by momentum (green up, red down, none = consolidating)", group = G_UI)

// ════════════════════════════════════════════════════════════════════════════════════════════════
// INSTRUMENT & TIMEFRAME
// ════════════════════════════════════════════════════════════════════════════════════════════════
float tick    = syminfo.mintick      // MNQ/ES 0.25, MGC/GC 0.10
float pv      = syminfo.pointvalue   // currency per 1.0 point per contract: MNQ 2, ES 50, MGC 10, GC 100
float stopBuf = stopBufTicks * tick
float minDist = minStopTicks * tick
int   thruEff = needThrough ? throughTicks : 0

int tfSec = timeframe.in_seconds()
if barstate.isfirst and not timeframe.isintraday
    runtime.error("Use an intraday chart (the script is designed for 3 minutes).")
// Number of chart bars in the momentum window (30 min on a 3m chart = 10 bars).
int momBars = math.max(1, int(math.round(momMinutes * 60 / tfSec)))

// ════════════════════════════════════════════════════════════════════════════════════════════════
// SESSION CLOCK (America/New_York)
// ════════════════════════════════════════════════════════════════════════════════════════════════
f_ts(int h, int m) =>
    timestamp(TZ, year(time, TZ), month(time, TZ), dayofmonth(time, TZ), h, m, 0)

int dayTs  = f_ts(dayH, dayM)
int flatTs = f_ts(flatH, flatM)

// First bar at/after the day start. The "< flatTs" guard stops a Sunday-evening bar from counting.
bool newDay = time >= dayTs and time < flatTs and (na(time[1]) or time[1] < dayTs)
var bool dayActive = false
var int  daysCount = 0
if newDay
    dayActive := true
    daysCount += 1

bool conf       = barstate.isconfirmed                 // confirmed bars only — no repainting
bool afterStart = dayActive and time >= dayTs
bool beforeFlat = afterStart and time_close < flatTs   // an order sent now fills before the flatten
bool flatTime   = afterStart and time_close >= flatTs
bool inWindow   = not na(time(timeframe.period, nwSession, TZ))

// ════════════════════════════════════════════════════════════════════════════════════════════════
// MOMENTUM — trend vs consolidation over the last `momMinutes`
// ════════════════════════════════════════════════════════════════════════════════════════════════
// netMove : how far price got (close now − close at the start of the window)
// pathLen : how far price travelled to get there (sum of |close-to-close| changes)
// eff     : netMove / pathLen → 1 = one-way move, ~0 = back-and-forth chop
// Momentum is +1 / −1 only when BOTH the size (× ATR) and the efficiency thresholds pass;
// otherwise it is 0 = consolidating, and no-wick candles are ignored.
float atr     = ta.atr(atrLen)
float netMove = close - close[momBars]
float pathLen = math.sum(math.abs(close - close[1]), momBars)
float eff     = pathLen > 0 ? math.abs(netMove) / pathLen : 0.0
bool  strong  = not na(atr) and not na(netMove) and math.abs(netMove) >= momMinMove * atr and eff >= momMinEff
int   momentum = strong ? (netMove > 0 ? 1 : -1) : 0

// ════════════════════════════════════════════════════════════════════════════════════════════════
// NO-WICK CANDLE DETECTION
// ════════════════════════════════════════════════════════════════════════════════════════════════
bool bearNoWick = close < open and math.round((high - open) / tick) <= wickTolTicks
bool bullNoWick = close > open and math.round((open - low) / tick) <= wickTolTicks
bool bearOK = conf and bearNoWick and afterStart and inWindow and momentum == -1   // creates a level
bool bullOK = conf and bullNoWick and afterStart and inWindow and momentum == 1

// ════════════════════════════════════════════════════════════════════════════════════════════════
// RESULTS LEDGER — re-prices every closed trade with YOUR costs. 0 = longs, 1 = shorts, 2 = all.
// ════════════════════════════════════════════════════════════════════════════════════════════════
var array<float> stTrades  = array.new<float>(3, 0.0)
var array<float> stWins    = array.new<float>(3, 0.0)
var array<float> stGross   = array.new<float>(3, 0.0)
var array<float> stNet     = array.new<float>(3, 0.0)
var array<float> stCost    = array.new<float>(3, 0.0)
var array<float> stWinSum  = array.new<float>(3, 0.0)
var array<float> stLossSum = array.new<float>(3, 0.0)
var array<float> stRSum    = array.new<float>(3, 0.0)
var array<float> stRCnt    = array.new<float>(3, 0.0)
var array<float> stPeak    = array.new<float>(3, strategy.initial_capital)
var array<float> stDD      = array.new<float>(3, 0.0)
var array<float> stDDPct   = array.new<float>(3, 0.0)
var array<float> stTester  = array.new<float>(3, 0.0)

f_update(int k, float g, float n, float c, float r, float tNet) =>
    stTrades.set(k, stTrades.get(k) + 1)
    stGross.set(k, stGross.get(k) + g)
    stNet.set(k, stNet.get(k) + n)
    stCost.set(k, stCost.get(k) + c)
    stTester.set(k, stTester.get(k) + tNet)
    if n > 0
        stWins.set(k, stWins.get(k) + 1)
        stWinSum.set(k, stWinSum.get(k) + n)
    else
        stLossSum.set(k, stLossSum.get(k) + n)
    if not na(r)
        stRSum.set(k, stRSum.get(k) + r)
        stRCnt.set(k, stRCnt.get(k) + 1)
    float eq = strategy.initial_capital + stNet.get(k)
    stPeak.set(k, math.max(stPeak.get(k), eq))
    float dd = stPeak.get(k) - eq
    stDD.set(k, math.max(stDD.get(k), dd))
    stDDPct.set(k, math.max(stDDPct.get(k), stPeak.get(k) > 0 ? dd / stPeak.get(k) * 100 : 0.0))

var int   processed = 0
var float dayNet    = 0.0
var bool  halted    = false
var float curStop   = na      // stop of the current / last trade (for R)
var float curTgt    = na
var float lastNet   = na      // result of the most recently closed trade (for the chart label)
var float lastR     = na
if newDay
    dayNet := 0.0
    halted := false

if strategy.closedtrades > processed
    for i = processed to strategy.closedtrades - 1
        float  sz   = strategy.closedtrades.size(i)
        int    dir  = sz > 0 ? 1 : -1
        int    b    = dir == 1 ? 0 : 1
        float  q    = math.abs(sz)
        float  ep   = strategy.closedtrades.entry_price(i)
        float  xp   = strategy.closedtrades.exit_price(i)
        bool   isTP = str.endswith(strategy.closedtrades.exit_comment(i), "TP")
        // Strip the Tester's own slippage (applied to the market entry and to market/stop exits,
        // never to the limit TP); move TP fills back from target + trade-through to the target
        // (a gap-through fill keeps its genuine improvement).
        float idealEntry = ep - dir * testerSlip * tick
        float idealExit  = isTP ? xp - dir * thruEff * tick : xp + dir * testerSlip * tick
        float grossPnl   = (idealExit - idealEntry) * dir * q * pv
        float commCost   = commPerSide * q * 2
        int   slipFills  = 1 + (isTP ? (slipOnTP ? 1 : 0) : 1)
        float slipCost   = slipFills * slipTicks * tick * pv * q
        float costT      = commCost + slipCost
        float netPnl     = grossPnl - costT
        float fillEntry  = idealEntry + dir * slipTicks * tick
        float riskCur    = na(curStop) ? na : math.abs(fillEntry - curStop) * q * pv
        float rMult      = na(riskCur) or riskCur <= 0 ? na : netPnl / riskCur
        float tNet       = strategy.closedtrades.profit(i)
        f_update(b, grossPnl, netPnl, costT, rMult, tNet)
        f_update(2, grossPnl, netPnl, costT, rMult, tNet)
        dayNet  += netPnl
        lastNet := netPnl
        lastR   := rMult
    processed := strategy.closedtrades

// ════════════════════════════════════════════════════════════════════════════════════════════════
// TRADE DRAWING — position box (red = risk, green = reward), entry line, price labels, result
// ════════════════════════════════════════════════════════════════════════════════════════════════
var box   tvRisk   = na
var box   tvReward = na
var line  tvEntry  = na
var label tvLblE   = na
var bool  tvActive = false
var bool  tvFilled = false
var int   tvClosedAtStart = 0

f_fmt(float p) =>
    str.tostring(p, format.mintick)

if tvActive
    bool done = strategy.closedtrades > tvClosedAtStart
    // Once filled, move the entry line from the planned price (signal close) to the real fill.
    if not tvFilled and (strategy.position_size != 0 or done)
        float fillPx = done ? strategy.closedtrades.entry_price(strategy.closedtrades - 1) : strategy.position_avg_price
        tvFilled := true
        tvEntry.set_y1(fillPx)
        tvEntry.set_y2(fillPx)
        tvRisk.set_top(math.max(fillPx, curStop))
        tvRisk.set_bottom(math.min(fillPx, curStop))
        tvReward.set_top(math.max(fillPx, curTgt))
        tvReward.set_bottom(math.min(fillPx, curTgt))
        tvLblE.set_y(fillPx)
        tvLblE.set_text("Entry " + f_fmt(fillPx))
    tvRisk.set_right(bar_index)
    tvReward.set_right(bar_index)
    tvEntry.set_x2(bar_index)
    if done
        tvActive := false
        int   last  = strategy.closedtrades - 1
        float xPx   = strategy.closedtrades.exit_price(last)
        string why  = strategy.closedtrades.exit_comment(last)
        string res  = why + "  " + (lastNet >= 0 ? "+" : "") + str.tostring(lastNet, "#,##0.00") +
             (na(lastR) ? "" : "  (" + (lastR >= 0 ? "+" : "") + str.tostring(lastR, "0.00") + "R)")
        label.new(bar_index, xPx, res, style = label.style_label_left,
             color = lastNet >= 0 ? color.new(color.green, 10) : color.new(color.red, 10),
             textcolor = color.white, size = size.small)

// ════════════════════════════════════════════════════════════════════════════════════════════════
// DAILY LOSS LIMIT & END-OF-DAY FLATTEN
// ════════════════════════════════════════════════════════════════════════════════════════════════
float openQty = math.abs(strategy.position_size)
float openEst = strategy.openprofit - openQty * (2 * commPerSide + (2 * slipTicks - testerSlip) * tick * pv)
// ⚠ FILL ASSUMPTION: the limit is only checked on bar closes and the exit fills at the next open —
// a fast move can take the real loss past the limit before you're out.
if useDLL and conf and afterStart and not halted and dayNet + openEst <= -dllAmount
    halted := true

if strategy.position_size != 0
    if halted
        strategy.close_all(comment = "DLL")
    else if flatTime
        strategy.close_all(comment = "EOD")              // fills at the next bar's open + slippage
    else if session.islastbar
        // Safety net for early-close (holiday) sessions: exit at this bar's close.
        // ⚠ FILL ASSUMPTION: relies on TradingView's session calendar knowing the early close.
        strategy.close_all(comment = "EOD-early", immediately = true)

bool canTrade = conf and beforeFlat and not halted

// ════════════════════════════════════════════════════════════════════════════════════════════════
// LEVELS — created by a qualifying no-wick candle, armed by a close through, used on the close back
// ════════════════════════════════════════════════════════════════════════════════════════════════
var array<float> lvPx  = array.new<float>()
var array<int>   lvDir = array.new<int>()    // -1 = bearish level (short setup), +1 = bullish level (long setup)
var array<int>   lvBar = array.new<int>()
var array<int>   lvSt  = array.new<int>()    // 0 = waiting for a close beyond, 1 = armed (closed beyond)
var array<line>  lvLn  = array.new<line>()

color C_BEAR = color.new(color.red, 0)
color C_BULL = color.new(color.teal, 0)
color C_DONE = color.new(color.gray, 60)

// Funnel counters (shown under the table) — how many setups each rule removes.
var int cntNoWick   = 0
var int cntFiltered = 0
var int cntLevels   = 0
var int cntTriggers = 0
var int cntTaken    = 0
var int skipStop    = 0
var int skipMom     = 0
var int skipOther   = 0

f_retireLine(line ln) =>
    if not na(ln)
        ln.set_x2(bar_index)
        ln.set_color(C_DONE)
        ln.set_style(line.style_dotted)

// Stop for direction `dir` (−1 short / +1 long): previous candle's high/low; if that is closer
// than the minimum distance, step back one candle at a time (taking the most extreme high/low
// so far) up to `stopLookback` candles. Returns na if none is far enough → trade skipped.
f_stop(int dir, float entry) =>
    float res = na
    float ext = na
    for k = 1 to stopLookback
        float h = dir == -1 ? high[k] : low[k]
        ext := na(ext) ? h : dir == -1 ? math.max(ext, h) : math.min(ext, h)
        float cand = dir == -1 ? ext + stopBuf : ext - stopBuf
        bool  rightSide = dir == -1 ? cand > entry : cand < entry
        if rightSide and math.abs(cand - entry) >= minDist
            res := cand
            break
    res

int  nwSig  = 0
bool nwSent = false

if conf
    if newDay
        int nOld = lvPx.size()
        if nOld > 0
            for j = 0 to nOld - 1
                f_retireLine(lvLn.get(j))
        lvPx.clear()
        lvDir.clear()
        lvBar.clear()
        lvSt.clear()
        lvLn.clear()

    // 1) Walk existing levels, newest first, so the newest level wins if several trigger together.
    int n = lvPx.size()
    if n > 0
        for j = n - 1 to 0
            float px   = lvPx.get(j)
            int   d    = lvDir.get(j)
            bool  drop = false
            line  ln   = lvLn.get(j)
            if bar_index - lvBar.get(j) > levelLife
                drop := true                                   // expired
            else if lvSt.get(j) == 0
                if (d == -1 and close > px) or (d == 1 and close < px)
                    lvSt.set(j, 1)                             // closed through → armed
                    if not na(ln)
                        ln.set_style(line.style_dashed)
                        ln.set_width(2)
            else if (d == -1 and close < px) or (d == 1 and close > px)
                drop := true                                   // closed back → used, traded or not
                cntTriggers += 1
                if nwSig == 0
                    nwSig := d
            if drop
                f_retireLine(ln)
                lvPx.remove(j)
                lvDir.remove(j)
                lvBar.remove(j)
                lvSt.remove(j)
                lvLn.remove(j)
            else if not na(ln)
                ln.set_x2(bar_index)

    // 2) New levels from THIS bar (evaluated from the next bar on).
    if (bearNoWick or bullNoWick) and afterStart and inWindow
        cntNoWick += 1
        if not bearOK and not bullOK
            cntFiltered += 1
    if bearOK
        cntLevels += 1
        lvPx.push(high)
        lvDir.push(-1)
        lvBar.push(bar_index)
        lvSt.push(0)
        lvLn.push(showLevels ? line.new(bar_index, high, bar_index, high, color = C_BEAR, width = 1) : line(na))
        alert("NOWICK: bearish no-wick level at " + f_fmt(high), alert.freq_once_per_bar_close)
    if bullOK
        cntLevels += 1
        lvPx.push(low)
        lvDir.push(1)
        lvBar.push(bar_index)
        lvSt.push(0)
        lvLn.push(showLevels ? line.new(bar_index, low, bar_index, low, color = C_BULL, width = 1) : line(na))
        alert("NOWICK: bullish no-wick level at " + f_fmt(low), alert.freq_once_per_bar_close)

    // 3) Entry on the close back through the level.
    if nwSig != 0
        bool momOk = momStrongAtEntry ? momentum == nwSig : momentum != -nwSig
        if not momOk
            skipMom += 1
        else if not (canTrade and inWindow and strategy.position_size == 0)
            skipOther += 1
        else
            float entry = close
            float stop  = f_stop(nwSig, entry)
            if na(stop)
                skipStop += 1
            else
                float risk = math.abs(entry - stop)
                float tgt  = entry + nwSig * rrTarget * risk
                strategy.entry(ID, nwSig == 1 ? strategy.long : strategy.short, qty = qty,
                     comment = nwSig == 1 ? "NOWICK L" : "NOWICK S")
                // ⚠ FILL ASSUMPTION: the TP limit sits `thruEff` ticks beyond the target so it only
                // fills when price trades through; it is then assumed fully filled (no queue or
                // partial fills). The table moves the fill back to the target and applies slippage.
                // Stops fill at the stop + slippage (at the open if the bar gaps through); real stops
                // in a fast market can slip more — stress-test "Slippage per fill".
                strategy.exit(ID + "-X", from_entry = ID, stop = stop,
                     limit = tgt + nwSig * thruEff * tick,
                     comment_loss = "SL", comment_profit = "TP")
                curStop := stop
                curTgt  := tgt
                nwSent  := true
                cntTaken += 1
                alert("NOWICK " + (nwSig == 1 ? "LONG" : "SHORT") + " entry ~" + f_fmt(entry) + "  SL " + f_fmt(stop) + "  TP " + f_fmt(tgt), alert.freq_once_per_bar_close)
                if showTrades
                    // Drawn at the planned entry (signal close); moved to the real fill next bar.
                    tvRisk   := box.new(bar_index, math.max(entry, stop), bar_index + 1, math.min(entry, stop),
                         border_color = color.new(color.red, 30), bgcolor = color.new(color.red, 82))
                    tvReward := box.new(bar_index, math.max(entry, tgt), bar_index + 1, math.min(entry, tgt),
                         border_color = color.new(color.green, 30), bgcolor = color.new(color.green, 82))
                    tvEntry  := line.new(bar_index, entry, bar_index + 1, entry, color = color.white, width = 2)
                    tvLblE   := label.new(bar_index, entry, "Entry ~" + f_fmt(entry), style = label.style_label_right,
                         color = color.new(color.gray, 10), textcolor = color.white, size = size.small)
                    string slTxt = "SL " + f_fmt(stop) + "  (" + str.tostring(math.round(risk / tick)) + " ticks)"
                    string tpTxt = "TP " + f_fmt(tgt) + "  (" + str.tostring(rrTarget, "0.0#") + "R)"
                    // Upper price gets its label above, lower price below, so they never overlap.
                    label.new(bar_index, math.max(stop, tgt), nwSig == 1 ? tpTxt : slTxt, style = label.style_label_down,
                         color = nwSig == 1 ? color.new(color.green, 10) : color.new(color.red, 10), textcolor = color.white, size = size.small)
                    label.new(bar_index, math.min(stop, tgt), nwSig == 1 ? slTxt : tpTxt, style = label.style_label_up,
                         color = nwSig == 1 ? color.new(color.red, 10) : color.new(color.green, 10), textcolor = color.white, size = size.small)
                    tvActive := true
                    tvFilled := false
                    tvClosedAtStart := strategy.closedtrades

// Drop a leftover exit order once the position is gone (e.g. after an EOD flatten), unless an
// entry (with its fresh exit) was just sent on this bar.
if strategy.position_size == 0 and not nwSent
    strategy.cancel(ID + "-X")

// ⚠ FILL ASSUMPTION: every order is assumed fully filled for any size. Fine for 1–5 MNQ/ES/MGC,
// questionable for large GC size.

// ════════════════════════════════════════════════════════════════════════════════════════════════
// PLOTS
// ════════════════════════════════════════════════════════════════════════════════════════════════
plotshape(showNoWick and bearOK, "No-wick bearish (level created)", shape.triangledown, location.abovebar, C_BEAR, size = size.tiny, text = "NW")
plotshape(showNoWick and bullOK, "No-wick bullish (level created)", shape.triangleup,   location.belowbar, C_BULL, size = size.tiny, text = "NW")
plotshape(showFiltered and conf and bearNoWick and not bearOK, "No-wick bearish (filtered out)", shape.xcross, location.abovebar, color.new(color.gray, 30), size = size.tiny)
plotshape(showFiltered and conf and bullNoWick and not bullOK, "No-wick bullish (filtered out)", shape.xcross, location.belowbar, color.new(color.gray, 30), size = size.tiny)
bgcolor(showMomBg and afterStart and inWindow ? (momentum == 1 ? color.new(color.green, 93) : momentum == -1 ? color.new(color.red, 93) : na) : na, title = "Momentum")
bgcolor(halted and afterStart and time < flatTs ? color.new(color.red, 85) : na, title = "Daily loss limit hit")

// ════════════════════════════════════════════════════════════════════════════════════════════════
// RESULTS TABLE (closed trades, re-priced with the Costs inputs)
// ════════════════════════════════════════════════════════════════════════════════════════════════
f_pos(string s) =>
    s == "Top left" ? position.top_left : s == "Top right" ? position.top_right : s == "Bottom right" ? position.bottom_right : position.bottom_left

var table tb = table.new(f_pos(tablePosIn), 4, 22, bgcolor = color.new(color.black, 15), border_color = color.new(color.gray, 60), border_width = 1)

f_cell(int c, int r, string t, color tc) =>
    table.cell(tb, c, r, t, text_color = tc, text_size = size.small,
         text_halign = c == 0 ? text.align_left : text.align_right)

f_money(float v) =>
    na(v) ? "—" : str.tostring(v, "#,##0.00")

f_pct(float v) =>
    na(v) ? "—" : str.tostring(v, "0.0") + "%"

f_pnlColor(float v) =>
    na(v) or v == 0 ? color.white : v > 0 ? color.new(color.lime, 0) : color.new(color.red, 0)

if barstate.islast and showTable
    color W = color.white
    color H = color.new(color.yellow, 0)
    color G = color.new(color.gray, 0)
    f_cell(0, 0, "NOWICK results (" + strategy.account_currency + ", closed trades)", H)
    f_cell(1, 0, "Longs", H)
    f_cell(2, 0, "Shorts", H)
    f_cell(3, 0, "All", H)
    array<string> labels = array.from(
         "Trades", "Win rate (net)", "Gross P&L", "Net P&L", "Total costs", "Costs % of gross P&L",
         "Profit factor (net)", "Expectancy / trade (net)", "Avg R achieved (net)",
         "Avg win (net)", "Avg loss (net)", "Avg cost / trade",
         "Max drawdown (closed, net)", "Max drawdown %", "Avg trades / day",
         "Tester net profit (ref.)")
    for r = 0 to labels.size() - 1
        f_cell(0, r + 1, labels.get(r), W)
    for k = 0 to 2
        int   c       = k + 1
        float nT      = stTrades.get(k)
        float wins    = stWins.get(k)
        float gross   = stGross.get(k)
        float net     = stNet.get(k)
        float cost    = stCost.get(k)
        float winSum  = stWinSum.get(k)
        float lossSum = stLossSum.get(k)
        float pf      = lossSum < 0 ? winSum / math.abs(lossSum) : na
        f_cell(c, 1,  str.tostring(nT, "#"), W)
        f_cell(c, 2,  nT > 0 ? f_pct(wins / nT * 100) : "—", W)
        f_cell(c, 3,  f_money(gross), f_pnlColor(gross))
        f_cell(c, 4,  f_money(net), f_pnlColor(net))
        f_cell(c, 5,  f_money(cost), W)
        f_cell(c, 6,  gross > 0 ? f_pct(cost / gross * 100) : "n/a (gross ≤ 0)", W)
        f_cell(c, 7,  na(pf) ? (winSum > 0 ? "∞" : "—") : str.tostring(pf, "0.00"), W)
        f_cell(c, 8,  nT > 0 ? f_money(net / nT) : "—", f_pnlColor(nT > 0 ? net / nT : na))
        f_cell(c, 9,  stRCnt.get(k) > 0 ? str.tostring(stRSum.get(k) / stRCnt.get(k), "0.00") + "R" : "—", W)
        f_cell(c, 10, wins > 0 ? f_money(winSum / wins) : "—", W)
        f_cell(c, 11, nT - wins > 0 ? f_money(lossSum / (nT - wins)) : "—", W)
        f_cell(c, 12, nT > 0 ? f_money(cost / nT) : "—", W)
        f_cell(c, 13, f_money(stDD.get(k)), W)
        f_cell(c, 14, f_pct(stDDPct.get(k)), W)
        f_cell(c, 15, daysCount > 0 ? str.tostring(nT / daysCount, "0.00") : "—", W)
        f_cell(c, 16, f_money(stTester.get(k)), G)
    string funnel = "Setups: " + str.tostring(cntNoWick) + " no-wick candles → " + str.tostring(cntFiltered) +
         " filtered (consolidation) → " + str.tostring(cntLevels) + " levels → " + str.tostring(cntTriggers) +
         " closed back → " + str.tostring(cntTaken) + " traded.  Skipped: stop too tight " + str.tostring(skipStop) +
         ", momentum flipped " + str.tostring(skipMom) + ", position open / outside hours " + str.tostring(skipOther)
    f_cell(0, 17, funnel, G)
    table.merge_cells(tb, 0, 17, 3, 17)
    string costNote = "Costs: " + str.tostring(commPerSide, "0.00") + "/contract/side · slip " + str.tostring(slipTicks) + "t" +
         (slipOnTP ? " (incl. TPs)" : " (not on TPs)") + " · TP trade-through " + str.tostring(thruEff) + "t · momentum " +
         str.tostring(momMinutes) + " min · " + str.tostring(daysCount) + " sessions · tick " + str.tostring(tick) + " = " + str.tostring(tick * pv, "0.00")
    f_cell(0, 18, costNote, G)
    table.merge_cells(tb, 0, 18, 3, 18)
