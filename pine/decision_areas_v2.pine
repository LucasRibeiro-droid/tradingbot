//
// ════════════════════════════════════════════════════════════════════════════════════════════════
//  DECISION AREAS (last 5 trading days) — for the no-wick strategy on the 5-minute chart
//
//  A DECISION AREA is a price zone that, during the last 5 trading days:
//   • was tapped and REJECTED more than 3 times (≥ 4 by default): the wick reaches the zone and the
//     candle closes back on the side it came from. One rejection per approach (price must move away
//     before the next one counts);
//   • was NOT broken slightly and then re-entered (a close through the zone that comes back before
//     running far = "fake break" → not a decision area);
//   • a BIG breakthrough (price runs far beyond the zone after closing through it) is allowed.
//  The decision areas split the chart into RANGES. The range price is in now is shaded, with its
//  midline: lower half → look for buys, upper half → look for sells.
//  Levels are recalculated on the latest candle from the last 5 trading days (like marking them at
//  the start of your session). Zones are drawn at their prices, on the candles' own price scale.
// ════════════════════════════════════════════════════════════════════════════════════════════════

//@version=6
indicator("Decision Areas v2", shorttitle = "DA v2", overlay = true,
     max_boxes_count = 60, max_lines_count = 10, max_labels_count = 60, max_bars_back = 5000)

int   nDays     = input.int(5, "Look-back (trading days)", minval = 1, maxval = 20)
int   minRej    = input.int(4, "Rejections needed (more than 3 = 4)", minval = 2)
int   pivLen    = input.int(3, "Swing size for candidate levels (candles each side)", minval = 1, maxval = 10)
float zoneATR   = input.float(0.5, "Group swings closer than (× ATR)", minval = 0.1, step = 0.1,
     tooltip = "Swings closer than this are the same zone.")
float minHATR   = input.float(1.0, "Minimum zone height (× ATR)", minval = 0.1, step = 0.1,
     tooltip = "Each zone covers the wick-to-body area of its rejection candles, and is at least this tall.")
float awayATR   = input.float(1.0, "Price must move this far away (× ATR) before the next rejection counts", minval = 0.2, step = 0.1)
float bigATR    = input.float(3.0, "Big breakthrough = runs this far beyond the zone (× ATR)", minval = 1.0, step = 0.5,
     tooltip = "A close through the zone that comes back BEFORE travelling this far is a fake break → zone rejected.")
bool  showRange = input.bool(true, "Shade the current range + midline")
color daCol     = input.color(color.orange, "Decision area colour")
color rgCol     = input.color(color.blue, "Range colour")

float atr = ta.atr(14)

// trading-day starts (futures day rolls at the exchange session; works for forex too)
var array<int> dayStart = array.new<int>()
if timeframe.change("D") or barstate.isfirst
    dayStart.push(bar_index)
    if dayStart.size() > 40
        dayStart.shift()

// candidate swings (wicks)
float ph = ta.pivothigh(high, pivLen, pivLen)
float pl = ta.pivotlow(low, pivLen, pivLen)
var array<float> swP = array.new<float>()       // wick tip
var array<float> swE = array.new<float>()       // body edge of the same candle (wick-to-body = the area)
var array<int>   swB = array.new<int>()
if not na(ph)
    swP.push(ph)
    swE.push(math.max(open[pivLen], close[pivLen]))
    swB.push(bar_index - pivLen)
if not na(pl)
    swP.push(pl)
    swE.push(math.min(open[pivLen], close[pivLen]))
    swB.push(bar_index - pivLen)
if swP.size() > 1500
    swP.shift()
    swE.shift()
    swB.shift()

type Zone
    float top
    float bot
    int   rej
    bool  fake

var array<box>   drawnB = array.new<box>()
var array<label> drawnL = array.new<label>()
var line  midLn = na
var box   rngBx = na
var table st = table.new(position.top_right, 1, 1, bgcolor = color.new(color.black, 30))

if barstate.islast and not na(atr)
    // clear old drawings
    for b in drawnB
        b.delete()
    for l in drawnL
        l.delete()
    drawnB.clear()
    drawnL.clear()
    line.delete(midLn)
    box.delete(rngBx)

    int startBar = dayStart.size() >= nDays ? dayStart.get(dayStart.size() - nDays) : 0
    int nBars = math.min(bar_index - startBar, 4900)
    startBar := bar_index - nBars

    // 1. cluster the swings of the window into candidate zones
    array<float> px = array.new<float>()
    array<float> pe = array.new<float>()
    if swP.size() > 0
        for i = 0 to swP.size() - 1
            if swB.get(i) >= startBar
                px.push(swP.get(i))
                pe.push(swE.get(i))
    array<int> ord = px.size() > 0 ? array.sort_indices(px, order.ascending) : array.new<int>()
    float w = zoneATR * atr
    array<Zone> zones = array.new<Zone>()
    Zone cur = na
    float curRef = na
    for i in ord
        float p = px.get(i)
        float e = pe.get(i)
        if na(cur) or p - curRef > w
            cur := Zone.new(math.max(p, e), math.min(p, e), 0, false)
            curRef := p
            zones.push(cur)
        else
            // the zone covers the wick-to-body area of every swing candle in it
            cur.top := math.max(cur.top, p, e)
            cur.bot := math.min(cur.bot, p, e)
    // minimum height
    for z in zones
        float mid = (z.top + z.bot) / 2
        if z.top - z.bot < minHATR * atr
            z.top := mid + minHATR * atr / 2
            z.bot := mid - minHATR * atr / 2

    // 2. walk the window bar by bar (oldest → newest) and score each zone
    for z in zones
        int   side = 0          // +1 price above the zone, −1 below (by close), 0 unknown yet
        bool  armed = true      // a new approach may count a rejection
        int   brk = 0           // +1 / −1 = closed through, waiting to see if it's big or fake
        int   brkFrom = 0
        float far = 0.0
        for k = nBars to 0
            float c = close[k]
            float h = high[k]
            float l = low[k]
            int cs = c > z.top ? 1 : c < z.bot ? -1 : 0
            if side == 0 and cs != 0
                side := cs
            // re-arm once price has moved away from the zone
            if not armed and (l > z.top + awayATR * atr or h < z.bot - awayATR * atr)
                armed := true
            if brk != 0
                // after a close through: big run → fine; back on the old side first → fake break
                far := brk == 1 ? math.max(far, h - z.top) : math.max(far, z.bot - l)
                if far >= bigATR * atr
                    brk := 0
                    side := brkFrom * -1
                else if cs == brkFrom
                    z.fake := true
                    brk := 0
            else if side != 0 and cs == -side
                // closed through the zone
                brk := cs
                brkFrom := side
                far := cs == 1 ? h - z.top : z.bot - l
            else if side == 1 and l <= z.top and cs == 1 and armed
                z.rej += 1                                  // tapped from above, closed back above
                armed := false
            else if side == -1 and h >= z.bot and cs == -1 and armed
                z.rej += 1                                  // tapped from below, closed back below
                armed := false

    // 3. decision areas
    array<Zone> da = array.new<Zone>()
    for z in zones
        if z.rej >= minRej and not z.fake
            da.push(z)
    for z in da
        drawnB.push(box.new(startBar, z.top, bar_index + 20, z.bot, border_color = color.new(daCol, 20), bgcolor = color.new(daCol, 75)))
        drawnL.push(label.new(bar_index + 20, (z.top + z.bot) / 2, "DA " + str.tostring(z.rej) + "×", style = label.style_label_left,
             color = color.new(daCol, 10), textcolor = color.white, size = size.tiny))

    // 4. the range price is in now
    float rTop = na
    float rBot = na
    for z in da
        if z.bot > close and (na(rTop) or z.bot < rTop)
            rTop := z.bot
        if z.top < close and (na(rBot) or z.top > rBot)
            rBot := z.top
    if showRange and not na(rTop) and not na(rBot)
        rngBx := box.new(startBar, rTop, bar_index + 20, rBot, border_color = color.new(rgCol, 100), bgcolor = color.new(rgCol, 93))
        float m = (rTop + rBot) / 2
        midLn := line.new(startBar, m, bar_index + 20, m, color = color.new(rgCol, 30), style = line.style_dashed)
        drawnL.push(label.new(bar_index + 20, m, close > m ? "upper half → sells" : "lower half → buys", style = label.style_label_left,
             color = color.new(rgCol, 30), textcolor = color.white, size = size.tiny))

    string rangeTxt = na(rTop) or na(rBot) ? (na(rTop) ? "above all decision areas" : "below all decision areas") : (close > (rTop + rBot) / 2 ? "upper half of range" : "lower half of range")
    table.cell(st, 0, 0, "Decision areas: " + str.tostring(da.size()) + " (last " + str.tostring(nDays) + " days) · price in " + rangeTxt,
         text_color = color.white, text_size = size.small)
