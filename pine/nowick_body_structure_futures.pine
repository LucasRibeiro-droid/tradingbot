//
// ════════════════════════════════════════════════════════════════════════════════════════════════
//  NO-WICK × BODY MARKET STRUCTURE — futures, 5m or 15m
//
//  TREND = your "Body Market Structure (BOS / CHoCH / internal)" logic (bodies only, closes only):
//    bullish = confirmed uptrend, bearish = confirmed downtrend. A pending CHoCH (not yet confirmed
//    by LH/HL + BOS) is NOT a trend → no new trades.
//
//  ENTRY: bullish trend + bullish no-wick (no bottom wick) = BUY at the no-wick open on the tap;
//         bearish trend + bearish no-wick (no top wick) = SELL. Mirror image.
//  STOP:  buy → below the protected HL, sell → above the protected LH, measured from that candle's
//         WICK, plus breathing room (default 5 pips).
//  TP:    fixed 1:1.
//  PRE-ENTRY: if the stop is more than 10 pips from the no-wick level, enter 2 pips BEFORE the tap.
//
//  DO NOT TAKE THE TRADE
//   • external structure forms before the tap (any BOS / CHoCH / CHoCH-failed / reversal);
//   • tap after 10 candles;
//   • choppy / sideways: no external structure for a long time (input);
//   • inside the NTZ (20:00–24:00 London). All open positions are closed when the NTZ starts.
//
//  EXIT before SL/TP only on an A SETUP against us: the 3 reversal steps (CHoCH → LH/HL → BOS) happen
//  after entry and then an opposite no-wick prints → close, and that no-wick becomes the new setup.
//  Max open trades: input (default 1).
//  Inputs marked [ASSUMPTION] are values you did not specify.
// ════════════════════════════════════════════════════════════════════════════════════════════════

//@version=6
strategy(title = "No-Wick × Body Structure (futures 5m/15m)",
     shorttitle = "NW BodyMS",
     overlay = true,
     scale = scale.right,                  // same price scale as the candles, so drawings stay fixed to price
     pyramiding = 10,
     initial_capital = 100000,
     currency = currency.USD,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 0,                 // costs are charged in the results table (inputs below)
     slippage = 0,
     margin_long = 0,
     margin_short = 0,
     close_entries_rule = "ANY",
     process_orders_on_close = false,
     calc_on_every_tick = false,
     // ⚠ Free plan: keep the bar magnifier off (it errors). Without it, when entry and SL/TP fall in
     // the same bar TradingView guesses the order — results can look better than reality.
     use_bar_magnifier = false,
     max_lines_count = 500,
     max_labels_count = 500)

// ════════════════════════════════════════════════════════════════════════════════════════════════
// INPUTS
// ════════════════════════════════════════════════════════════════════════════════════════════════
const string G_P = "Pips"
float pipPts = input.float(1.0, "1 pip = this many points [ASSUMPTION]", minval = 0.01, step = 0.25, group = G_P,
     tooltip = "Futures have no pips. Default 1 point (= 4 ticks on NQ/ES, 10 ticks on MGC/GC). Change if you mean ticks.")

const string G_E = "Entry / stop / target"
float breathPips  = input.float(5.0, "Breathing room beyond the HL/LH wick (pips)", minval = 0, step = 0.5, group = G_E)
float preIfSLPips = input.float(10.0, "Pre-entry if SL is more than (pips)", minval = 0, step = 0.5, group = G_E)
float prePips     = input.float(2.0, "…enter this many pips before the tap", minval = 0, step = 0.5, group = G_E)
float rrTarget    = input.float(1.0, "Take profit (R)", minval = 0.1, step = 0.1, group = G_E)
int   tapWindow   = input.int(10, "Tap must happen within (candles)", minval = 1, group = G_E,
     tooltip = "Tap after 10 candles → no trade.")
int   maxOpen     = input.int(1, "Max open trades at once", minval = 1, maxval = 10, group = G_E)

const string G_F = "Filters"
int   chopBars = input.int(30, "Choppy: no external structure for this many candles → no trades [ASSUMPTION]", minval = 5, group = G_F)
string ntz     = input.session("2000-0000", "No trading zone (London time)", group = G_F)
bool  useA     = input.bool(true, "Close on an A setup against us (and take the new one)", group = G_F)

const string G_C = "Size & costs"
float riskPct   = input.float(1.0, "Risk per trade: % of the STARTING balance", minval = 0.01, step = 0.25, group = G_C)
float commSide  = input.float(2.25, "Commission per contract per side ($) — NQ ≈ 2.25, MNQ ≈ 0.62", minval = 0, step = 0.05, group = G_C)
int   slipTicks = input.int(1, "Slippage on stop / market exits (ticks)", minval = 0, group = G_C)

const string G_D = "Display"
bool showStruct = input.bool(true, "Show BOS / CHoCH / HL / LH labels", group = G_D)
bool showTable  = input.bool(true, "Results table", group = G_D)
color bullCol = color.teal
color bearCol = color.red
color pendCol = color.orange

if barstate.isfirst and timeframe.in_seconds() != 300 and timeframe.in_seconds() != 900
    runtime.error("Use the 5-minute or 15-minute chart.")
if barstate.isfirst and syminfo.type != "futures"
    runtime.error("Built for futures (e.g. NQ1!, MNQ1!, ES1!, MES1!).")

float pip    = pipPts
float breath = breathPips * pip

// ════════════════════════════════════════════════════════════════════════════════════════════════
// BODY MARKET STRUCTURE — your indicator's logic (bodies, closes), plus the WICK of each level
// ════════════════════════════════════════════════════════════════════════════════════════════════
float bodyTop = math.max(open, close)
float bodyBot = math.min(open, close)
bool  bullCandle = close > open
bool  bearCandle = close < open

var int   dir           = 1
var bool  confirmed     = false
var bool  everConfirmed = false
var float ext           = na
var float extWick       = na      // wick of the leg-extreme candle
var int   extBar        = na
var bool  pb            = false
var float pot           = na
var float potWick       = na      // wick of the potential HL / LH candle
var int   potBar        = na
var float prot          = na      // protected HL (uptrend) / LH (downtrend), body level
var float protWick      = na      // its candle's wick → the stop reference
var int   protBar       = na
var bool  sawCounter    = false

if barstate.isfirst
    ext      := bodyTop
    extWick  := high
    extBar   := bar_index
    prot     := bodyBot
    protWick := low
    protBar  := bar_index

bool structEvent = false          // any EXTERNAL structure: BOS, CHoCH, CHoCH failed
bool revBear = false              // reversal confirmed (CHoCH → LH → BOS)
bool revBull = false

f_lbl(int b, float p, string txt, color col, bool up) =>
    if showStruct
        label.new(b, p, txt, color = color.new(col, 100), textcolor = col, style = up ? label.style_label_down : label.style_label_up, size = size.small)

bool isBull = dir == 1
bool broke  = isBull ? close < prot : close > prot

if broke
    structEvent := true
    if confirmed
        f_lbl(bar_index, prot, "CHoCH", pendCol, not isBull)       // trend not reversed yet
        prot     := ext
        protWick := extWick
        protBar  := extBar
        dir      := -dir
        confirmed := false
    else
        if everConfirmed
            f_lbl(bar_index, prot, "CHoCH failed", isBull ? bearCol : bullCol, not isBull)
            confirmed := true
        prot     := ext
        protWick := extWick
        protBar  := extBar
        dir      := -dir
    ext     := isBull ? bodyBot : bodyTop
    extWick := isBull ? low : high
    extBar  := bar_index
    pb      := false
    pot     := na
    potWick := na
    potBar  := na
    sawCounter := false
else
    if not pb
        // pullback = opposite candle(s) after the leg extreme, then a candle in the trend direction again
        if sawCounter and not na(pot) and (isBull ? bullCandle : bearCandle)
            pb := true
        else
            bool counter = isBull ? bearCandle : bullCandle
            if isBull ? bodyTop >= ext : bodyBot <= ext
                ext     := isBull ? bodyTop : bodyBot
                extWick := isBull ? high : low
                extBar  := bar_index
                sawCounter := counter
                pot     := counter ? (isBull ? bodyBot : bodyTop) : na
                potWick := counter ? (isBull ? low : high) : na
                potBar  := counter ? bar_index : na
            else
                if counter
                    sawCounter := true
                if na(pot) or (isBull ? bodyBot < pot : bodyTop > pot)
                    pot     := isBull ? bodyBot : bodyTop
                    potWick := isBull ? low : high
                    potBar  := bar_index
    if pb
        // internal structure: only a body close beyond the leg extreme counts (BOS)
        if isBull ? close > ext : close < ext
            structEvent := true
            f_lbl(potBar, pot, isBull ? "HL" : "LH", isBull ? bullCol : bearCol, not isBull)
            bool newTrend = not confirmed
            f_lbl(bar_index, ext, newTrend and everConfirmed ? "BOS — reversal" : "BOS", isBull ? bullCol : bearCol, isBull)
            if newTrend and everConfirmed
                if isBull
                    revBull := true
                else
                    revBear := true
            confirmed     := true
            everConfirmed := true
            prot     := pot
            protWick := potWick
            protBar  := potBar
            ext      := isBull ? bodyTop : bodyBot
            extWick  := isBull ? high : low
            extBar   := bar_index
            pb       := false
            pot      := na
            potWick  := na
            potBar   := na
            sawCounter := false
        else
            if isBull ? bodyBot < pot : bodyTop > pot
                pot     := isBull ? bodyBot : bodyTop
                potWick := isBull ? low : high
                potBar  := bar_index

// Trend for trading: only a CONFIRMED trend counts (a pending CHoCH is not a trend).
int trend = everConfirmed and confirmed ? dir : 0
bgcolor(trend == 1 ? color.new(bullCol, 94) : trend == -1 ? color.new(bearCol, 94) : everConfirmed ? color.new(pendCol, 94) : na, title = "Trend")

// Choppy / sideways: no external structure for chopBars candles.
var int lastEventBar = 0
if structEvent
    lastEventBar := bar_index
bool choppy = bar_index - lastEventBar > chopBars

// Reversal confirmations (for the A setup)
var int lastRevBar = -1
var int lastRevDir = 0
if revBull
    lastRevBar := bar_index
    lastRevDir := 1
if revBear
    lastRevBar := bar_index
    lastRevDir := -1

// NTZ 20:00–24:00 London
bool inNTZ = not na(time(timeframe.period, ntz, "Europe/London"))
bgcolor(inNTZ ? color.new(color.gray, 85) : na, title = "No trading zone")

// No-wick candles
bool bullNW = barstate.isconfirmed and close > open and open - low <= syminfo.mintick * 0.01
bool bearNW = barstate.isconfirmed and close < open and high - open <= syminfo.mintick * 0.01
plotshape(bullNW, "Bullish no-wick", shape.triangleup,   location.belowbar, color.new(color.yellow, 0), size = size.tiny)
plotshape(bearNW, "Bearish no-wick", shape.triangledown, location.abovebar, color.new(color.yellow, 0), size = size.tiny)

// ════════════════════════════════════════════════════════════════════════════════════════════════
// BOOK-KEEPING
// ════════════════════════════════════════════════════════════════════════════════════════════════
type Setup
    string id
    int    dir
    float  entry
    float  stop
    float  tp
    int    expiryBar
    int    evCount
    line   ln

type Live
    string id
    int    dir
    int    entryBar

var array<Setup> pend = array.new<Setup>()
var array<Live>  live = array.new<Live>()
var map<string, float> riskById = map.new<string, float>()
var int seq = 0
var int evCount = 0
if structEvent
    evCount += 1

var int cSetups = 0
var int cAgainst = 0
var int cNoTrend = 0
var int cChop = 0
var int cNTZ = 0
var int cBadStop = 0
var int cExpired = 0
var int cStruct = 0
var int cA = 0

f_retire(line ln) =>
    if not na(ln)
        ln.set_x2(bar_index)
        ln.set_color(color.new(color.gray, 50))
        ln.set_style(line.style_dotted)

f_openIdx(string id) =>
    int res = -1
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            if strategy.opentrades.entry_id(i) == id
                res := i
                break
    res

// fills: pending → live
int np = pend.size()
if np > 0
    for j = np - 1 to 0
        Setup s = pend.get(j)
        if f_openIdx(s.id) >= 0
            live.push(Live.new(s.id, s.dir, bar_index))
            f_retire(s.ln)
            box.new(bar_index, math.max(s.entry, s.stop), bar_index + 6, math.min(s.entry, s.stop), border_color = color.new(color.red, 40), bgcolor = color.new(color.red, 85))
            box.new(bar_index, math.max(s.entry, s.tp), bar_index + 6, math.min(s.entry, s.tp), border_color = color.new(color.green, 40), bgcolor = color.new(color.green, 85))
            pend.remove(j)

// closed trades → ledger in R
var int processed = 0
var int nT = 0
var int nW = 0
var int nL = 0
var float sumR = 0.0
var float sumRnet = 0.0
var float peakR = 0.0
var float maxDDR = 0.0
if strategy.closedtrades > processed
    for i = processed to strategy.closedtrades - 1
        string eid = strategy.closedtrades.entry_id(i)
        float ep = strategy.closedtrades.entry_price(i)
        float xp = strategy.closedtrades.exit_price(i)
        int   d  = strategy.closedtrades.size(i) > 0 ? 1 : -1
        float rk = riskById.contains(eid) ? riskById.get(eid) : math.abs(ep - xp)
        float r  = rk > 0 ? (xp - ep) * d / rk : 0.0
        bool  isTP = strategy.closedtrades.exit_comment(i) == "TP"
        float costPts = 2 * commSide / syminfo.pointvalue + (isTP ? 0 : slipTicks * syminfo.mintick)
        nT += 1
        sumR += r
        sumRnet += r - (rk > 0 ? costPts / rk : 0.0)
        peakR := math.max(peakR, sumRnet)
        maxDDR := math.max(maxDDR, peakR - sumRnet)
        if r > 0
            nW += 1
        else
            nL += 1
        int nl = live.size()
        if nl > 0
            for k = nl - 1 to 0
                if live.get(k).id == eid
                    live.remove(k)
        int npp = pend.size()
        if npp > 0
            for k = npp - 1 to 0
                if pend.get(k).id == eid
                    f_retire(pend.get(k).ln)
                    pend.remove(k)
    processed := strategy.closedtrades

// ════════════════════════════════════════════════════════════════════════════════════════════════
// NTZ: close everything, no entries
// ════════════════════════════════════════════════════════════════════════════════════════════════
if inNTZ and strategy.position_size != 0
    strategy.close_all(comment = "NTZ")

// ════════════════════════════════════════════════════════════════════════════════════════════════
// SETUPS (confirmed bars)
// ════════════════════════════════════════════════════════════════════════════════════════════════
if barstate.isconfirmed
    // drop waiting setups
    int n0 = pend.size()
    if n0 > 0
        for j = n0 - 1 to 0
            Setup s = pend.get(j)
            bool drop = false
            if evCount != s.evCount                       // external structure before the tap
                drop := true
                cStruct += 1
            else if bar_index >= s.expiryBar              // tap after 10 candles
                drop := true
                cExpired += 1
            if drop
                strategy.cancel(s.id)
                f_retire(s.ln)
                pend.remove(j)

    if bullNW or bearNW
        int d = bullNW ? 1 : -1
        // A setup against us: reversal confirmed after our entry, then this opposite no-wick → close.
        if useA and live.size() > 0 and trend == d and lastRevDir == d
            for t in live
                if t.dir == -d and lastRevBar > t.entryBar
                    strategy.close(t.id, comment = "A setup")
                    cA += 1
        // new setup
        if inNTZ
            cNTZ += 1
        else if trend == 0
            cNoTrend += 1
        else if trend != d
            cAgainst += 1
        else if choppy
            cChop += 1
        else
            float lvl  = open
            float stop = d == 1 ? protWick - breath : protWick + breath
            if na(stop) or (d == 1 ? stop >= lvl : stop <= lvl)
                cBadStop += 1
            else
                float entry = lvl
                if math.abs(lvl - stop) > preIfSLPips * pip
                    entry := lvl + d * prePips * pip          // enter 2 pips before the tap
                float tp = entry + d * rrTarget * math.abs(entry - stop)
                seq += 1
                string id = "NW" + str.tostring(seq)
                line ln = line.new(bar_index, entry, bar_index, entry, color = d == 1 ? bullCol : bearCol, width = 2)
                pend.push(Setup.new(id, d, entry, stop, tp, bar_index + tapWindow, evCount, ln))
                riskById.put(id, math.abs(entry - stop))
                cSetups += 1

// ════════════════════════════════════════════════════════════════════════════════════════════════
// ORDERS — limit at the entry; max open trades; one direction at a time
// ════════════════════════════════════════════════════════════════════════════════════════════════
float riskCash = strategy.initial_capital * riskPct / 100
if barstate.isconfirmed and pend.size() > 0
    int slots = maxOpen - live.size()
    int liveDir = live.size() > 0 ? live.get(0).dir : 0
    for j = pend.size() - 1 to 0                           // newest setups first
        Setup s = pend.get(j)
        float rd = math.abs(s.entry - s.stop)
        int contracts = rd > 0 ? int(math.floor(riskCash / (rd * syminfo.pointvalue))) : 0
        bool may = not inNTZ and slots > 0 and contracts >= 1 and (liveDir == 0 or liveDir == s.dir)
        if may
            strategy.entry(s.id, s.dir == 1 ? strategy.long : strategy.short, qty = contracts, limit = s.entry,
                 comment = s.dir == 1 ? "NW L" : "NW S")
            strategy.exit(s.id + "-X", from_entry = s.id, stop = s.stop, limit = s.tp, comment_loss = "SL", comment_profit = "TP")
            slots -= 1
        else
            strategy.cancel(s.id)
        if not na(s.ln)
            s.ln.set_x2(bar_index)

// ════════════════════════════════════════════════════════════════════════════════════════════════
// LEVEL LINES & TABLE
// ════════════════════════════════════════════════════════════════════════════════════════════════
var line protLine = line.new(na, na, na, na, color = color.new(color.white, 40), style = line.style_dashed, extend = extend.right)
if not na(protBar)
    line.set_xy1(protLine, protBar, protWick)
    line.set_xy2(protLine, bar_index, protWick)
    line.set_color(protLine, dir == 1 ? bullCol : bearCol)

var table tb = table.new(position.bottom_right, 2, 12, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 60))
f_row(int r, string k, string v) =>
    table.cell(tb, 0, r, k, text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, r, v, text_color = color.white, text_size = size.small, text_halign = text.align_right)
f_pct(float rm) =>
    (rm >= 0 ? "+" : "") + str.tostring(rm * riskPct, "0.00") + "%"
if barstate.islast and showTable
    f_row(0, "NW × Body structure — " + syminfo.ticker + " " + timeframe.period + "m", "risk " + str.tostring(riskPct, "0.##") + "%")
    f_row(1, "Trend now", trend == 1 ? "Bullish" : trend == -1 ? "Bearish" : everConfirmed ? "CHoCH pending" : "Forming")
    f_row(2, "Trades (W / L)", str.tostring(nT) + "  (" + str.tostring(nW) + " / " + str.tostring(nL) + ")")
    f_row(3, "Win rate", nT > 0 ? str.tostring(100.0 * nW / nT, "0.0") + "%" : "—")
    f_row(4, "Return (before costs)", f_pct(sumR))
    f_row(5, "Return (after costs)", f_pct(sumRnet))
    f_row(6, "Max drawdown (closed trades)", str.tostring(maxDDR * riskPct, "0.00") + "%")
    f_row(7, "Setups placed", str.tostring(cSetups))
    f_row(8, "Dropped: structure before tap / tap > " + str.tostring(tapWindow), str.tostring(cStruct) + " / " + str.tostring(cExpired))
    f_row(9, "No-wicks skipped: against / no trend / choppy", str.tostring(cAgainst) + " / " + str.tostring(cNoTrend) + " / " + str.tostring(cChop))
    f_row(10, "Skipped: NTZ / bad stop", str.tostring(cNTZ) + " / " + str.tostring(cBadStop))
    f_row(11, "Closed on A setup", str.tostring(cA))
