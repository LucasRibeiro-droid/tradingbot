// https://mozilla.org/MPL/2.0/
//
// ════════════════════════════════════════════════════════════════════════════════════════════════
//  No-Wick R — RANGE PLAY (support / resistance + no-wick)
//
//  ZONES: swing highs / lows (3 candles each side) of the last 288 candles (1 day). A level where at
//         least N swings sit within ±1 ATR = an area price keeps rejecting.
//  SELL:  bearish no-wick whose open is inside a RESISTANCE zone → limit sell at its open,
//         stop above the zone + breathing room, target = middle between entry and the support zone.
//  BUY:   bullish no-wick whose open is inside a SUPPORT zone → mirror.
//  A with-trend no-wick that forms INSIDE an opposite zone (bullish no-wick at resistance) is never
//  traded here (that's your "over-extended into a rejection area" rule).
//
//  TESTED on NQ 1-minute data 2021 → Apr 2026 (1-minute fills, MNQ costs), 384+ variations:
//   • With a stop just past the zone (what you'd do by eye) it LOSES: ≈ −0.19R per trade — the stop
//     sits ~6 pts away and normal noise takes it out; costs do the rest.
//   • Best settings (defaults below: ≥5 swings, stop 4 ATR past the zone, target mid-range):
//     276 trades (≈50/yr), win 45%, +0.14R/trade — but +0.03R in 2021-23 and +0.33R in 2024-26.
//     That gap means it is NOT a proven edge; treat this as an experiment / forward-test only.
//  No trades 20:00-24:00 London (all closed at 20:00).
// ════════════════════════════════════════════════════════════════════════════════════════════════

//@version=6
strategy("No-Wick R — Range Play", shorttitle = "NW-R", overlay = true,
     initial_capital = 50000, currency = currency.USD, pyramiding = 10,
     margin_long = 0, margin_short = 0,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.62, slippage = 1,
     use_bar_magnifier = false, process_orders_on_close = false,
     max_labels_count = 500, max_lines_count = 500, max_boxes_count = 50)

const string G1 = "Zones"
const string G2 = "Setup"
const string G3 = "Risk"
int   look    = input.int(288, "Zones from the last (candles)", minval = 50, maxval = 2000, group = G1)
int   pivLen  = input.int(3, "Swing size (candles each side)", minval = 1, maxval = 10, group = G1)
float zw      = input.float(1.0, "Zone half-width (× ATR)", minval = 0.1, step = 0.1, group = G1)
int   minT    = input.int(5, "Rejections needed (swings in the zone)", minval = 2, group = G1)
bool  showZ   = input.bool(true, "Draw the nearest zones", group = G1)

int    wickT   = input.int(0, "No-wick tolerance (ticks)", minval = 0, group = G2)
int    tapWin  = input.int(9, "Tap within (candles)", minval = 1, group = G2)
float  buf     = input.float(4.0, "Stop beyond the zone by (× ATR)", minval = 0, step = 0.25, group = G2)
string tgtMode = input.string("Middle of range", "Target", options = ["Middle of range", "Opposite zone", "Fixed R"], group = G2)
float  rr      = input.float(1.0, "Fixed R (if target = Fixed R)", minval = 0.5, step = 0.5, group = G2)
bool   useNtz  = input.bool(true, "No-trade zone 20:00-24:00 London", group = G2)

float riskPct = input.float(0.5, "Risk per trade (% of current equity)", minval = 0.05, step = 0.25, group = G3)
int   maxQty  = input.int(30, "Max contracts per trade", minval = 1, group = G3)
int   maxOpen = input.int(3, "Max trades open at once", minval = 1, group = G3)

if barstate.isfirst and timeframe.in_seconds() != 300
    runtime.error("Use the 5-minute chart.")

float tick = syminfo.mintick
float atr  = ta.atr(14)

// ── swings of the last N candles ────────────────────────────────────────────────────────────────
float ph = ta.pivothigh(high, pivLen, pivLen)
float pl = ta.pivotlow(low, pivLen, pivLen)
var array<float> hiP = array.new<float>()
var array<int>   hiB = array.new<int>()
var array<float> loP = array.new<float>()
var array<int>   loB = array.new<int>()
if not na(ph)
    hiP.push(ph)
    hiB.push(bar_index - pivLen)
if not na(pl)
    loP.push(pl)
    loB.push(bar_index - pivLen)
while hiB.size() > 0 and hiB.get(0) < bar_index - look
    hiB.shift()
    hiP.shift()
while loB.size() > 0 and loB.get(0) < bar_index - look
    loB.shift()
    loP.shift()

// swings within ±w of x (skipping swings of the last `skip` candles); returns [count, min, max]
f_zone(array<float> P, array<int> B, float x, float w, int skip) =>
    int n = 0
    float mn = na
    float mx = na
    if P.size() > 0
        for i = 0 to P.size() - 1
            if B.get(i) < bar_index - skip and math.abs(P.get(i) - x) <= w
                n += 1
                mn := na(mn) ? P.get(i) : math.min(mn, P.get(i))
                mx := na(mx) ? P.get(i) : math.max(mx, P.get(i))
    [n, mn, mx]

// nearest clustered level beyond `from` in direction dir (+1 above / -1 below)
f_nextZone(array<float> P, array<int> B, float from, int dir, float w) =>
    float best = na
    if P.size() > 0
        for i = 0 to P.size() - 1
            float p = P.get(i)
            if (dir == 1 and p > from) or (dir == -1 and p < from)
                [n, _a, _b] = f_zone(P, B, p, w, 6)
                if n >= minT and (na(best) or (dir == 1 ? p < best : p > best))
                    best := p
    best

// ── setups ──────────────────────────────────────────────────────────────────────────────────────
type Setup
    string id
    int    dir
    float  lvl
    float  stop
    float  tp
    int    bar
    line   ln

var array<Setup> pend = array.new<Setup>()
var int seq = 0
bool inNtz  = useNtz and hour(time, "Europe/London") >= 20
bool ntzNew = inNtz and hour(time[1], "Europe/London") < 20

f_isOpen(string id) =>
    bool res = false
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            if strategy.opentrades.entry_id(i) == id
                res := true
                break
    res

if pend.size() > 0
    for j = pend.size() - 1 to 0
        Setup s = pend.get(j)
        if f_isOpen(s.id)
            label.new(bar_index, na, (s.dir == 1 ? "BUY (range)" : "SELL (range)") + "\nE " + str.tostring(s.lvl, format.mintick) +
                 "\nSL " + str.tostring(s.stop, format.mintick) + "\nTP " + str.tostring(s.tp, format.mintick),
                 yloc = s.dir == 1 ? yloc.belowbar : yloc.abovebar, style = s.dir == 1 ? label.style_label_up : label.style_label_down,
                 color = s.dir == 1 ? color.teal : color.red, textcolor = color.white, size = size.tiny)
            line.new(bar_index, s.stop, bar_index + 6, s.stop, color = color.red)
            line.new(bar_index, s.tp, bar_index + 6, s.tp, color = color.green)
            s.ln.set_x2(bar_index)
            pend.remove(j)

if barstate.isconfirmed
    if ntzNew
        strategy.close_all(comment = "NTZ")
    if pend.size() > 0
        for j = pend.size() - 1 to 0
            Setup s = pend.get(j)
            bool tpFirst = s.dir == 1 ? high >= s.tp : low <= s.tp
            if bar_index - s.bar >= tapWin or tpFirst or inNtz
                strategy.cancel(s.id)
                s.ln.set_x2(bar_index)
                s.ln.set_style(line.style_dotted)
                s.ln.set_color(color.new(color.gray, 60))
                pend.remove(j)
            else
                s.ln.set_x2(bar_index + 1)
    bool bullNW = close > open and open - low <= wickT * tick
    bool bearNW = close < open and high - open <= wickT * tick
    if (bullNW or bearNW) and not inNtz and not na(atr)
        int dir = bullNW ? 1 : -1
        float lvl = open
        float w = zw * atr
        // SELL needs a resistance zone (swing highs) at the level; BUY a support zone (swing lows)
        int n = 0
        float zmin = na
        float zmax = na
        if dir == -1
            [n1, a1, b1] = f_zone(hiP, hiB, lvl, w, 6)
            n := n1
            zmin := a1
            zmax := b1
        else
            [n2, a2, b2] = f_zone(loP, loB, lvl, w, 6)
            n := n2
            zmin := a2
            zmax := b2
        if n >= minT
            float stop = dir == -1 ? math.max(zmax, high) + buf * atr : math.min(zmin, low) - buf * atr
            float rk = math.abs(lvl - stop)
            float opp = dir == -1 ? f_nextZone(loP, loB, lvl - rk * 0.5, -1, w) : f_nextZone(hiP, hiB, lvl + rk * 0.5, 1, w)
            float tp = tgtMode == "Fixed R" ? lvl + dir * rr * rk : na(opp) ? na :
                 tgtMode == "Opposite zone" ? opp - dir * 0.1 * atr : (lvl + opp) / 2
            if not na(tp) and math.abs(tp - lvl) >= 0.8 * rk and rk >= 4 * tick
                seq += 1
                line ln = line.new(bar_index, lvl, bar_index + 1, lvl, color = dir == 1 ? color.teal : color.red, width = 2)
                pend.push(Setup.new("R" + str.tostring(seq), dir, lvl, stop, tp, bar_index, ln))
    for s in pend
        float rk = math.abs(s.lvl - s.stop)
        int qty = math.min(maxQty, int(math.floor(strategy.equity * riskPct / 100 / (rk * syminfo.pointvalue))))
        if qty >= 1 and strategy.opentrades < maxOpen
            strategy.entry(s.id, s.dir == 1 ? strategy.long : strategy.short, qty = qty, limit = s.lvl)
            strategy.exit(s.id + "x", from_entry = s.id, stop = s.stop, limit = s.tp, comment_loss = "SL", comment_profit = "TP")
        else
            strategy.cancel(s.id)

// ── nearest zones (drawn on the latest candle only) ─────────────────────────────────────────────
var box zR = na
var box zS = na
if showZ and barstate.islast and not na(atr)
    box.delete(zR)
    box.delete(zS)
    float w = zw * atr
    float r = f_nextZone(hiP, hiB, close, 1, w)
    float s = f_nextZone(loP, loB, close, -1, w)
    if not na(r)
        [n, mn, mx] = f_zone(hiP, hiB, r, w, 0)
        zR := box.new(bar_index - look, mx, bar_index + 10, mn - 0.1 * atr, border_color = color.purple, bgcolor = color.new(color.purple, 85),
             text = "R " + str.tostring(n) + "×", text_color = color.purple, text_size = size.small, text_halign = text.align_right)
    if not na(s)
        [n, mn, mx] = f_zone(loP, loB, s, w, 0)
        zS := box.new(bar_index - look, mx + 0.1 * atr, bar_index + 10, mn, border_color = color.purple, bgcolor = color.new(color.purple, 85),
             text = "S " + str.tostring(n) + "×", text_color = color.purple, text_size = size.small, text_halign = text.align_right)

var table tb = table.new(position.bottom_right, 2, 4, bgcolor = color.new(color.black, 25), border_width = 1, border_color = color.new(color.gray, 60))
if barstate.islast
    int nT = strategy.closedtrades
    float ret = strategy.netprofit / strategy.initial_capital * 100
    table.cell(tb, 0, 0, "NW-R range — " + syminfo.ticker, text_color = color.yellow, text_size = size.small)
    table.cell(tb, 0, 1, "Trades " + str.tostring(nT), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 2, "Win " + (nT > 0 ? str.tostring(float(strategy.wintrades) / nT * 100, "0.0") + "%" : "-"), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 3, "Net " + str.tostring(ret, "+0.0;-0.0") + "%  ·  DD " + str.tostring(strategy.max_drawdown_percent, "0.0") + "%",
         text_color = ret >= 0 ? color.green : color.red, text_size = size.small)
