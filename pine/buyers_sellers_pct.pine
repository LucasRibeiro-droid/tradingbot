// https://mozilla.org/MPL/2.0/
//
// ════════════════════════════════════════════════════════════════════════════════════════════════
//  BUYERS vs SELLERS %
//
//  Red zone ABOVE price = sellers, green zone BELOW price = buyers, each with its % of the volume
//  traded over the look-back (default: today's session).
//
//  How the volume is split:
//   • "Intrabar (1m)": each 1-minute candle inside your candles counts as buying volume if it closed
//     up and selling volume if it closed down (most accurate; works on 2m+ charts).
//   • "Candle shape": volume × (close − low)/(high − low) = buyers, the rest = sellers.
//  This is an ESTIMATE of aggression from candles — TradingView does not give real bid/ask order
//  flow on the free plan.
// ════════════════════════════════════════════════════════════════════════════════════════════════

//@version=6
indicator("Buyers vs Sellers %", shorttitle = "Buy/Sell %", overlay = true, max_boxes_count = 10, max_labels_count = 10)

string mode    = input.string("Session", "Look-back", options = ["Session", "Bars"])
int    nBars   = input.int(100, "Bars (when look-back = Bars)", minval = 5, maxval = 2000)
string method  = input.string("Intrabar (1m)", "Volume split", options = ["Intrabar (1m)", "Candle shape"])
int    ext     = input.int(15, "Zone width to the right (bars)", minval = 2, maxval = 100)
bool   showHist = input.bool(false, "Plot buyers % history (bottom of the chart)")
color  sellCol = input.color(color.red, "Sellers")
color  buyCol  = input.color(color.green, "Buyers")

// ── buying / selling volume of this candle ──────────────────────────────────────────────────────
f_shape() =>
    float rng = high - low
    float bv = rng > 0 ? volume * (close - low) / rng : volume / 2
    [bv, volume - bv]

float bVol = na
float sVol = na
bool canIntra = method == "Intrabar (1m)" and timeframe.in_seconds() > 60
if canIntra
    [ltfDiff, ltfVol] = request.security_lower_tf(syminfo.tickerid, "1", [close - open, volume])
    float b = 0.0
    float s = 0.0
    if ltfVol.size() > 0
        for i = 0 to ltfVol.size() - 1
            float d = ltfDiff.get(i)
            float v = ltfVol.get(i)
            if d > 0
                b += v
            else if d < 0
                s += v
            else
                b += v / 2
                s += v / 2
        bVol := b
        sVol := s
if na(bVol) or bVol + sVol == 0
    [bv, sv] = f_shape()
    bVol := bv
    sVol := sv

// ── totals over the look-back ───────────────────────────────────────────────────────────────────
var float sumB = 0.0
var float sumS = 0.0
var float hiS = na
var float loS = na
bool newSess = timeframe.change("D")
float totB = na
float totS = na
float zTop = na
float zBot = na
if mode == "Session"
    if newSess
        sumB := 0.0
        sumS := 0.0
        hiS := high
        loS := low
    sumB += nz(bVol)
    sumS += nz(sVol)
    hiS := math.max(nz(hiS, high), high)
    loS := math.min(nz(loS, low), low)
    totB := sumB
    totS := sumS
    zTop := hiS
    zBot := loS
else
    totB := math.sum(nz(bVol), nBars)
    totS := math.sum(nz(sVol), nBars)
    zTop := ta.highest(high, nBars)
    zBot := ta.lowest(low, nBars)

float tot = totB + totS
float buyPct = tot > 0 ? totB / tot * 100 : 50
float sellPct = 100 - buyPct

plot(showHist ? buyPct : na, "Buyers %", buyCol, display = display.data_window)

// ── zones: sellers above price, buyers below ────────────────────────────────────────────────────
var box sBox = na
var box bBox = na
var label sLbl = na
var label bLbl = na
if barstate.islast
    box.delete(sBox)
    box.delete(bBox)
    label.delete(sLbl)
    label.delete(bLbl)
    int x1 = bar_index - (mode == "Bars" ? nBars : 30)
    int x2 = bar_index + ext
    float top = math.max(zTop, close)
    float bot = math.min(zBot, close)
    sBox := box.new(x1, top, x2, close, border_color = color.new(sellCol, 100), bgcolor = color.new(sellCol, 100 - math.round(15 + sellPct * 0.4)))
    bBox := box.new(x1, close, x2, bot, border_color = color.new(buyCol, 100), bgcolor = color.new(buyCol, 100 - math.round(15 + buyPct * 0.4)))
    sLbl := label.new(x2, (top + close) / 2, "SELLERS " + str.tostring(sellPct, "0.0") + "%", style = label.style_label_left,
         color = sellCol, textcolor = color.white, size = size.normal)
    bLbl := label.new(x2, (close + bot) / 2, "BUYERS " + str.tostring(buyPct, "0.0") + "%", style = label.style_label_left,
         color = buyCol, textcolor = color.white, size = size.normal)
