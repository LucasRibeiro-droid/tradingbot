//@version=6
// =====================================================================================
// Body-Based Structure + No-Wick Strategy (Trend / Range with Volume-Profile LVNs)
// -------------------------------------------------------------------------------------
// TREND (the active "trend change" methods say there is a trend):
//   • Only trade no-wick candles in the direction of the trend.
//   • Wait for price to come back to the no-wick candle's open (limit order).
//   • Stop loss at the previous swing low (longs) / swing high (shorts). Take profit 1:1.
// RANGE (the active methods say there is NO clear trend):
//   • Fixed-range volume profile from yesterday 09:00 to today 09:00 (London).
//   • The 3 lowest-volume nodes (LVNs) become "decision areas".
//   • While price is between decision areas:
//       - bearish no-wick at the top of the range    -> sell, SL 5 ticks above the area
//       - bullish no-wick at the bottom of the range -> buy,  SL 5 ticks below the area
//   • Take profit 1:1.
// SESSIONS (London time): Asia 22:00-08:00, London 08:00-17:00, New York 13:00-22:00.
//   Each session can be drawn and traded on/off independently.
//
// TREND-CHANGE METHODS (turn each on/off, then choose how they combine):
//   1. CHoCH            – trend flips on the first body CLOSE beyond the last opposite swing.
//   2. CHoCH + BOS      – after a CHoCH, wait for a BOS in the new direction to confirm.
//   3. Dow Theory       – bullish only with HH + HL, bearish only with LH + LL.
//   4. MSS displacement – the break must be made by a big "displacement" candle (body ≥ X × ATR).
//   5. EMA filter       – fast EMA above / below slow EMA.
//
// Market structure uses CANDLE BODIES ONLY: body high = max(open, close),
// body low = min(open, close). A level is broken only when a candle CLOSES beyond it.
// =====================================================================================
strategy("Body Structure No-Wick Strategy", overlay = true, pyramiding = 0,
     initial_capital = 100000, default_qty_type = strategy.fixed, default_qty_value = 1,
     margin_long = 0, margin_short = 0,   // 0 = no margin check (default 100% rejects futures orders)
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ───────────────────────────── Inputs ─────────────────────────────
const string G_STR  = "Market Structure (bodies only)"
swingLen      = input.int(5, "Swing length (bars each side)", minval = 1, group = G_STR)
showSwings    = input.bool(true, "Show HH / HL / LH / LL", group = G_STR)
showBOS       = input.bool(true, "Show BOS", group = G_STR)
showCHoCH     = input.bool(true, "Show CHoCH", group = G_STR)
colBull       = input.color(color.new(#089981, 0), "Bullish colour", group = G_STR)
colBear       = input.color(color.new(#F23645, 0), "Bearish colour", group = G_STR)
colCHoCH      = input.color(color.new(#FF9800, 0), "CHoCH colour", group = G_STR)

const string G_TC   = "Trend Change Definition"
useChoch      = input.bool(true,  "1. CHoCH (first body close beyond last opposite swing)", group = G_TC,
     tooltip = "Fastest. Trend flips as soon as a candle body closes beyond the last swing high (in a downtrend) or swing low (in an uptrend).")
useConfirm    = input.bool(false, "2. CHoCH + confirmation BOS", group = G_TC,
     tooltip = "Conservative. After a CHoCH, the trend only flips once price makes a BOS in the new direction (breaks the next swing too). Fewer fake reversals, later entries.")
useDow        = input.bool(true,  "3. Dow Theory (HH+HL / LH+LL sequence)", group = G_TC,
     tooltip = "Bullish only when the last swing high is a HH AND the last swing low is a HL. Bearish only with LH AND LL. Otherwise the previous trend is kept.")
useDisp       = input.bool(false, "4. Market Structure Shift with displacement", group = G_TC,
     tooltip = "Trend flips only when the candle that closes beyond the swing is a displacement candle: body ≥ multiplier × ATR(14). Small, weak breaks are ignored.")
dispMult      = input.float(1.2, "    Displacement body ≥ ATR ×", minval = 0.1, step = 0.1, group = G_TC)
useEma        = input.bool(false, "5. EMA filter (fast vs slow)", group = G_TC,
     tooltip = "Bullish while the fast EMA is above the slow EMA, bearish while below.")
emaFastLen    = input.int(20, "    Fast EMA", minval = 1, inline = "ema", group = G_TC)
emaSlowLen    = input.int(50, "Slow EMA", minval = 2, inline = "ema", group = G_TC)
showEma       = input.bool(true, "    Plot EMAs when method 5 is on", group = G_TC)
combineMode   = input.string("All must agree", "Combine active methods", options = ["All must agree", "Majority"], group = G_TC,
     tooltip = "All must agree: trend trades only when every active method points the same way; otherwise the market is treated as a range.\nMajority: more than half of the active methods must agree.")

const string G_NW   = "No-Wick Candles"
nwTolTicks    = input.int(0, "Wick tolerance (ticks)", minval = 0, tooltip = "0 = the open must be exactly the low (bullish) / high (bearish).", group = G_NW)
nwMinBody     = input.int(2, "Minimum body size (ticks)", minval = 1, group = G_NW)
showNW        = input.bool(true, "Mark no-wick candles", group = G_NW)

const string G_TR   = "Trend Trades"
allowTrend    = input.bool(true, "Take trend trades", group = G_TR)
slRef         = input.string("Body", "Stop at previous swing", options = ["Body", "Wick"], tooltip = "Body = the body-based swing level. Wick = the lowest low / highest high around that swing.", group = G_TR)
slBufTicks    = input.int(0, "Extra stop buffer (ticks)", minval = 0, group = G_TR)
rr            = input.float(1.0, "Reward : Risk", minval = 0.1, step = 0.1, group = G_TR)
expiryBars    = input.int(20, "Cancel unfilled order after N bars", minval = 1, group = G_TR)
replacePend   = input.bool(true, "Newer no-wick replaces pending order", group = G_TR)

const string G_VP   = "Range Trades / Volume Profile"
allowRange    = input.bool(true, "Take range trades (when there is no clear trend)", group = G_VP)
vpAnchor      = input.session("0900-0901", "Profile anchor time (London)", tooltip = "The profile covers the 24h before this time each day.", group = G_VP)
vpRows        = input.int(60, "Profile rows", minval = 20, maxval = 150, group = G_VP)
vpSmooth      = input.int(1, "Smoothing (rows each side)", minval = 0, maxval = 5, group = G_VP)
vpEdgePct     = input.float(10, "Ignore profile edges (%)", minval = 1, maxval = 30, tooltip = "Rows at the very top/bottom of the profile always have low volume; they are ignored when picking decision areas.", group = G_VP)
vpMinSep      = input.int(4, "Min distance between decision areas (rows)", minval = 1, group = G_VP)
nZones        = input.int(3, "Number of decision areas", minval = 2, maxval = 6, group = G_VP)
zoneProxTicks = input.int(4, "Touch tolerance around area (ticks)", minval = 0, group = G_VP)
rangeSlTicks  = input.int(5, "Range stop beyond area (ticks)", minval = 0, group = G_VP)
rangeEntry    = input.string("Retest", "Range entry", options = ["Retest", "Market on close"], group = G_VP)
showProfile   = input.bool(true, "Draw volume profile", group = G_VP)
colZone       = input.color(color.new(#2962FF, 75), "Decision area colour", group = G_VP)

const string G_SS   = "Sessions (London time)"
tradeAsia     = input.bool(true, "Trade Asia",     inline = "as", group = G_SS)
showAsia      = input.bool(true, "Show",           inline = "as", group = G_SS)
sessAsia      = input.session("2200-0800", "",     inline = "as", group = G_SS)
colAsia       = input.color(color.new(#9C27B0, 0), "", inline = "as", group = G_SS)
tradeLon      = input.bool(true, "Trade London",   inline = "lo", group = G_SS)
showLon       = input.bool(true, "Show",           inline = "lo", group = G_SS)
sessLon       = input.session("0800-1700", "",     inline = "lo", group = G_SS)
colLon        = input.color(color.new(#2962FF, 0), "", inline = "lo", group = G_SS)
tradeNY       = input.bool(true, "Trade New York", inline = "ny", group = G_SS)
showNY        = input.bool(true, "Show",           inline = "ny", group = G_SS)
sessNY        = input.session("1300-2200", "",     inline = "ny", group = G_SS)
colNY         = input.color(color.new(#FF9800, 0), "", inline = "ny", group = G_SS)
closeOutside  = input.bool(true, "Close trades when no enabled session is open", group = G_SS)

// ───────────────────────────── Helpers ─────────────────────────────
tick     = syminfo.mintick
bodyHi   = math.max(open, close)
bodyLo   = math.min(open, close)
bodySize = math.abs(close - open)
atr14    = ta.atr(14)

inSess(string s) => not na(time(timeframe.period, s, "Europe/London"))

inAsia   = inSess(sessAsia)
inLon    = inSess(sessLon)
inNY     = inSess(sessNY)
canTrade = (tradeAsia and inAsia) or (tradeLon and inLon) or (tradeNY and inNY)

// ───────────────────────────── Session boxes ─────────────────────────────
// Draws a box around each session's high/low with its name in the top-left corner.
sessionBox(bool inS, bool show, string name, color c) =>
    var box   b  = na
    var float hi = na
    var float lo = na
    if show and inS
        if not inS[1] or na(b)
            hi := high
            lo := low
            b  := box.new(bar_index, hi, bar_index, lo, border_color = color.new(c, 20), border_width = 1,
                 border_style = line.style_dashed, bgcolor = color.new(c, 92), text = name, text_color = color.new(c, 0),
                 text_size = size.small, text_halign = text.align_left, text_valign = text.align_top)
        else
            hi := math.max(hi, high)
            lo := math.min(lo, low)
            b.set_top(hi)
            b.set_bottom(lo)
            b.set_right(bar_index)
    if not inS
        b := na

sessionBox(inAsia, showAsia, "ASIA",     colAsia)
sessionBox(inLon,  showLon,  "LONDON",   colLon)
sessionBox(inNY,   showNY,   "NEW YORK", colNY)

// ─────────────────────── Market structure (bodies) ───────────────────────
ph        = ta.pivothigh(bodyHi, swingLen, swingLen)
pl        = ta.pivotlow(bodyLo, swingLen, swingLen)
winWickHi = ta.highest(high, swingLen * 2 + 1)
winWickLo = ta.lowest(low, swingLen * 2 + 1)

var int    trend        = 0       // CHoCH-based structure trend: 1 bull, -1 bear, 0 undefined
var int    lastSwingDir = 0       // 1 = last swing was a high, -1 = a low

var float  lastHigh     = na
var float  prevHigh     = na
var float  lastHighWick = na
var int    lastHighBar  = na
var string lastHighType = ""
var bool   highBroken   = true
var label  lastHighLbl  = na

var float  lastLow      = na
var float  prevLow      = na
var float  lastLowWick  = na
var int    lastLowBar   = na
var string lastLowType  = ""
var bool   lowBroken    = true
var label  lastLowLbl   = na

pivBar = bar_index - swingLen

// New swing high
if not na(ph)
    bool accept = lastSwingDir != 1 or na(lastHigh) or ph > lastHigh
    if accept
        if lastSwingDir != 1
            prevHigh := lastHigh                 // new leg: previous high becomes reference
        lastHigh     := ph
        lastHighWick := winWickHi
        lastHighBar  := pivBar
        highBroken   := false
        lastHighType := na(prevHigh) ? "H" : ph > prevHigh ? "HH" : "LH"
        if showSwings
            if lastSwingDir == 1 and not na(lastHighLbl)
                label.delete(lastHighLbl)        // consecutive highs: keep only the higher one
            lastHighLbl := label.new(pivBar, ph, lastHighType, style = label.style_label_down,
                 color = color.new(color.black, 100), textcolor = lastHighType == "HH" ? colBull : colBear, size = size.small)
        lastSwingDir := 1

// New swing low
if not na(pl)
    bool accept = lastSwingDir != -1 or na(lastLow) or pl < lastLow
    if accept
        if lastSwingDir != -1
            prevLow := lastLow
        lastLow     := pl
        lastLowWick := winWickLo
        lastLowBar  := pivBar
        lowBroken   := false
        lastLowType := na(prevLow) ? "L" : pl < prevLow ? "LL" : "HL"
        if showSwings
            if lastSwingDir == -1 and not na(lastLowLbl)
                label.delete(lastLowLbl)
            lastLowLbl := label.new(pivBar, pl, lastLowType, style = label.style_label_up,
                 color = color.new(color.black, 100), textcolor = lastLowType == "HL" ? colBull : colBear, size = size.small)
        lastSwingDir := -1

// Breaks (candle must CLOSE beyond the body level)
bullBOS   = false
bullCHoCH = false
bearBOS   = false
bearCHoCH = false

if not highBroken and not na(lastHigh) and close > lastHigh
    bool isCh = trend == -1
    bullCHoCH := isCh
    bullBOS   := not isCh
    if (isCh and showCHoCH) or (not isCh and showBOS)
        line.new(lastHighBar, lastHigh, bar_index, lastHigh, color = isCh ? colCHoCH : colBull,
             style = isCh ? line.style_dashed : line.style_solid, width = 1)
        label.new(int(math.avg(lastHighBar, bar_index)), lastHigh, isCh ? "CHoCH" : "BOS",
             style = label.style_label_down, color = color.new(color.black, 100),
             textcolor = isCh ? colCHoCH : colBull, size = size.tiny)
    trend      := 1
    highBroken := true

if not lowBroken and not na(lastLow) and close < lastLow
    bool isCh = trend == 1
    bearCHoCH := isCh
    bearBOS   := not isCh
    if (isCh and showCHoCH) or (not isCh and showBOS)
        line.new(lastLowBar, lastLow, bar_index, lastLow, color = isCh ? colCHoCH : colBear,
             style = isCh ? line.style_dashed : line.style_solid, width = 1)
        label.new(int(math.avg(lastLowBar, bar_index)), lastLow, isCh ? "CHoCH" : "BOS",
             style = label.style_label_up, color = color.new(color.black, 100),
             textcolor = isCh ? colCHoCH : colBear, size = size.tiny)
    trend     := -1
    lowBroken := true

// ─────────────────────── Trend-change methods ───────────────────────
// 1. CHoCH: the structure trend above
tChoch = trend

// 2. CHoCH + confirmation BOS: only a BOS (which can only happen after the CHoCH) sets the trend
var int tConfirm = 0
if bullBOS
    tConfirm := 1
if bearBOS
    tConfirm := -1

// 3. Dow Theory: needs both swings in sequence; otherwise keep the previous trend
var int tDow = 0
if lastHighType == "HH" and lastLowType == "HL"
    tDow := 1
else if lastHighType == "LH" and lastLowType == "LL"
    tDow := -1

// 4. Market Structure Shift with displacement: close beyond the last swing with a big-bodied candle
var int tDisp = 0
isDisp = bodySize >= dispMult * atr14
if tDisp != 1 and not na(lastHigh) and close > lastHigh and close > open and isDisp
    tDisp := 1
if tDisp != -1 and not na(lastLow) and close < lastLow and close < open and isDisp
    tDisp := -1

// 5. EMA filter
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
tEma    = emaFast > emaSlow ? 1 : emaFast < emaSlow ? -1 : 0
plot(useEma and showEma ? emaFast : na, "Fast EMA", color = color.new(color.yellow, 20))
plot(useEma and showEma ? emaSlow : na, "Slow EMA", color = color.new(color.aqua, 20))

// Combine the active methods into one trend: 1 bull, -1 bear, 0 = no clear trend (range)
combine() =>
    int active = 0
    int bulls  = 0
    int bears  = 0
    if useChoch
        active += 1
        bulls  += tChoch == 1 ? 1 : 0
        bears  += tChoch == -1 ? 1 : 0
    if useConfirm
        active += 1
        bulls  += tConfirm == 1 ? 1 : 0
        bears  += tConfirm == -1 ? 1 : 0
    if useDow
        active += 1
        bulls  += tDow == 1 ? 1 : 0
        bears  += tDow == -1 ? 1 : 0
    if useDisp
        active += 1
        bulls  += tDisp == 1 ? 1 : 0
        bears  += tDisp == -1 ? 1 : 0
    if useEma
        active += 1
        bulls  += tEma == 1 ? 1 : 0
        bears  += tEma == -1 ? 1 : 0
    int res = 0
    if active > 0
        if combineMode == "All must agree"
            res := bulls == active ? 1 : bears == active ? -1 : 0
        else
            res := bulls * 2 > active ? 1 : bears * 2 > active ? -1 : 0
    res

mainTrend = combine()

// ───────────────────────────── No-wick candles ─────────────────────────────
nwTol      = nwTolTicks * tick + tick * 0.5   // half-tick slack for floating-point rounding
bullNoWick = close > open and (open - low)  <= nwTol and bodySize >= nwMinBody * tick - tick * 0.5
bearNoWick = close < open and (high - open) <= nwTol and bodySize >= nwMinBody * tick - tick * 0.5

plotshape(showNW and bullNoWick, "Bullish no-wick", shape.triangleup,   location.belowbar, colBull, size = size.tiny)
plotshape(showNW and bearNoWick, "Bearish no-wick", shape.triangledown, location.abovebar, colBear, size = size.tiny)

// ─────────────── Fixed-range volume profile (09:00 -> 09:00 London) ───────────────
inAnchor = inSess(vpAnchor)
newVP    = inAnchor and not inAnchor[1]

var array<float> vpHi  = array.new_float()
var array<float> vpLo  = array.new_float()
var array<float> vpVol = array.new_float()
var int          winStart = na               // time of the bar that opened the window

var array<float> zBot = array.new_float()    // decision areas, sorted low -> high
var array<float> zTop = array.new_float()
var array<box>   profBoxes = array.new<box>()

if newVP
    zBot.clear()
    zTop.clear()
    int n = vpVol.size()
    if n > 0 and not na(winStart)
        float pTop = vpHi.max()
        float pBot = vpLo.min()
        float step = (pTop - pBot) / vpRows
        if step > 0
            // 1) Distribute every bar's volume across the rows its range covers
            vols = array.new_float(vpRows, 0.0)
            for i = 0 to n - 1
                float h = vpHi.get(i)
                float l = vpLo.get(i)
                float v = vpVol.get(i)
                int r0 = math.max(0, math.min(vpRows - 1, int(math.floor((l - pBot) / step))))
                int r1 = math.max(0, math.min(vpRows - 1, int(math.floor((h - pBot) / step))))
                if h == l or r0 == r1
                    vols.set(r0, vols.get(r0) + v)
                else
                    for r = r0 to r1
                        float rLo = pBot + r * step
                        float ov  = math.min(h, rLo + step) - math.max(l, rLo)
                        if ov > 0
                            vols.set(r, vols.get(r) + v * ov / (h - l))

            // 2) Smooth the profile
            sm = array.new_float(vpRows, 0.0)
            for r = 0 to vpRows - 1
                float s = 0.0
                int   c = 0
                for k = -vpSmooth to vpSmooth
                    int j = r + k
                    if j >= 0 and j < vpRows
                        s += vols.get(j)
                        c += 1
                sm.set(r, s / c)

            // 3) Pick the lowest-volume nodes (local minima first, then any row), away from the edges
            int skip = math.max(1, int(math.round(vpRows * vpEdgePct / 100)))
            picked = array.new_int()
            for pass = 0 to 1
                while picked.size() < nZones
                    int   best  = -1
                    float bestV = 1e100
                    for r = skip to vpRows - 1 - skip
                        bool ok = true
                        for p in picked
                            if math.abs(p - r) < vpMinSep
                                ok := false
                        if ok and pass == 0
                            ok := sm.get(r) <= sm.get(r - 1) and sm.get(r) <= sm.get(r + 1)
                        if ok and sm.get(r) < bestV
                            best  := r
                            bestV := sm.get(r)
                    if best == -1
                        break
                    picked.push(best)
            picked.sort(order.ascending)
            for r in picked
                zBot.push(pBot + r * step)
                zTop.push(pBot + (r + 1) * step)

            // 4) Draw (areas extend 24h, until the next profile)
            int areaEnd = time + 24 * 3600000
            for r in picked
                float zb = pBot + r * step
                box.new(time, zb + step, areaEnd, zb, border_color = color.new(colZone, 30), bgcolor = colZone,
                     xloc = xloc.bar_time, text = "Decision area", text_size = size.tiny,
                     text_color = color.new(colZone, 0), text_halign = text.align_right)
            if showProfile
                for b in profBoxes
                    box.delete(b)
                profBoxes.clear()
                float maxV  = vols.max()
                int   width = int((time - winStart) * 0.3)
                if maxV > 0
                    for r = 0 to vpRows - 1
                        float rb = pBot + r * step
                        int   w  = int(width * vols.get(r) / maxV)
                        profBoxes.push(box.new(winStart, rb + step, winStart + math.max(w, 1), rb,
                             xloc = xloc.bar_time, border_color = color.new(color.gray, 100),
                             bgcolor = picked.includes(r) ? color.new(colZone, 40) : color.new(color.gray, 75)))
    // start a fresh 24h window from this bar
    vpHi.clear()
    vpLo.clear()
    vpVol.clear()
    winStart := time

if not na(winStart)
    vpHi.push(high)
    vpLo.push(low)
    vpVol.push(nz(volume))

nZ         = zBot.size()
rangeLo    = nZ > 0 ? zBot.min() : na
rangeHi    = nZ > 0 ? zTop.max() : na
inRangeNow = nZ >= 2 and close >= rangeLo - zoneProxTicks * tick and close <= rangeHi + zoneProxTicks * tick

// Current mode: TREND when the combined trend is clear, RANGE when it isn't and price is inside the areas
string mode = mainTrend != 0 ? "TREND" : inRangeNow ? "RANGE" : "WAIT"

// ───────────────────────────── Debug counters ─────────────────────────────
var int cntNoWick = 0
var int cntSetups = 0
if (bullNoWick or bearNoWick) and canTrade
    cntNoWick += 1

// ───────────────────────────── Orders ─────────────────────────────
var int    pendDir  = 0
var float  pendSL   = na
var float  pendTP   = na
var int    pendBar  = na
var string pendTag  = ""
var array<line> pendLines = array.new<line>()

flat = strategy.position_size == 0

cancelPending() =>
    strategy.cancel("Long")
    strategy.cancel("Short")
    for l in pendLines
        l.set_x2(bar_index)
    pendLines.clear()

// Filled -> forget pending state
if not flat and pendDir != 0
    pendDir := 0
    pendLines.clear()

// Cancel unfilled pending orders when the setup is no longer valid
if flat and pendDir != 0
    bool kill = not canTrade or bar_index - pendBar > expiryBars
    if pendDir == 1
        kill := kill or close < pendSL or high >= pendTP
    else
        kill := kill or close > pendSL or low <= pendTP
    if pendTag == "Trend" and mainTrend != pendDir
        kill := true
    if pendTag == "Range" and mode != "RANGE"
        kill := true
    if kill
        cancelPending()
        pendDir := 0

placeOrder(int dir, float ent, float sl, float tp, string tag, bool market) =>
    string id = dir == 1 ? "Long" : "Short"
    if market
        strategy.entry(id, dir == 1 ? strategy.long : strategy.short, comment = tag)
    else
        strategy.entry(id, dir == 1 ? strategy.long : strategy.short, limit = ent, comment = tag)
    strategy.exit(id + " exit", id, stop = sl, limit = tp, comment_loss = "SL", comment_profit = "TP")
    pendLines.push(line.new(bar_index, ent, bar_index + expiryBars, ent, color = color.gray))
    pendLines.push(line.new(bar_index, sl,  bar_index + expiryBars, sl,  color = colBear))
    pendLines.push(line.new(bar_index, tp,  bar_index + expiryBars, tp,  color = colBull))
    alert(tag + " " + id + " | entry " + str.tostring(ent, format.mintick) + " SL " + str.tostring(sl, format.mintick) + " TP " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)

bool canNew = flat and canTrade and barstate.isconfirmed and (pendDir == 0 or replacePend)

// ---- Trend setups: no-wick candle WITH the trend, enter on retest of its open ----
if canNew and allowTrend and mode == "TREND"
    if mainTrend == 1 and bullNoWick and not na(lastLow)
        float ent = open
        float sl  = (slRef == "Body" ? lastLow : lastLowWick) - slBufTicks * tick
        if sl < ent
            float tp = ent + (ent - sl) * rr
            if pendDir != 0
                cancelPending()
            placeOrder(1, ent, sl, tp, "Trend", false)
            pendDir := 1, pendSL := sl, pendTP := tp, pendBar := bar_index, pendTag := "Trend"
    else if mainTrend == -1 and bearNoWick and not na(lastHigh)
        float ent = open
        float sl  = (slRef == "Body" ? lastHigh : lastHighWick) + slBufTicks * tick
        if sl > ent
            float tp = ent - (sl - ent) * rr
            if pendDir != 0
                cancelPending()
            placeOrder(-1, ent, sl, tp, "Trend", false)
            pendDir := -1, pendSL := sl, pendTP := tp, pendBar := bar_index, pendTag := "Trend"

// ---- Range setups: bearish no-wick at top decision area / bullish no-wick at bottom ----
if canNew and allowRange and mode == "RANGE"
    float prox = zoneProxTicks * tick
    bool  mkt  = rangeEntry == "Market on close"
    if bearNoWick
        // the candle's high (= its open) must be touching a decision area that has another area below it
        for i = 1 to nZ - 1
            if high >= zBot.get(i) - prox and high <= zTop.get(i) + prox
                float ent = mkt ? close : open
                float sl  = zTop.get(i) + rangeSlTicks * tick
                if sl > ent
                    float tp = ent - (sl - ent) * rr
                    if pendDir != 0
                        cancelPending()
                    placeOrder(-1, ent, sl, tp, "Range", mkt)
                    pendDir := -1, pendSL := sl, pendTP := tp, pendBar := bar_index, pendTag := "Range"
                break
    else if bullNoWick
        // the candle's low (= its open) must be touching a decision area that has another area above it
        for i = 0 to nZ - 2
            if low >= zBot.get(i) - prox and low <= zTop.get(i) + prox
                float ent = mkt ? close : open
                float sl  = zBot.get(i) - rangeSlTicks * tick
                if sl < ent
                    float tp = ent + (ent - sl) * rr
                    if pendDir != 0
                        cancelPending()
                    placeOrder(1, ent, sl, tp, "Range", mkt)
                    pendDir := 1, pendSL := sl, pendTP := tp, pendBar := bar_index, pendTag := "Range"
                break

// Market range entries fill next bar; don't keep them as "pending"
if pendTag == "Range" and rangeEntry == "Market on close" and pendDir != 0 and bar_index > pendBar
    pendDir := 0

if pendBar == bar_index
    cntSetups += 1

// ---- Leaving all enabled sessions: cancel and (optionally) flatten ----
if canTrade[1] and not canTrade
    if pendDir != 0
        cancelPending()
        pendDir := 0
    if closeOutside
        strategy.close_all(comment = "Session end")

// ───────────────────────────── Status table ─────────────────────────────
trendTxt(int t) => t == 1 ? "Bullish" : t == -1 ? "Bearish" : "None"
onOff(bool b, int t) => b ? trendTxt(t) : "off"

var table dbg = table.new(position.bottom_right, 2, 12, bgcolor = color.new(color.black, 30), border_width = 1)
if barstate.islast
    string sessNow = (inAsia ? "Asia " : "") + (inLon ? "London " : "") + (inNY ? "New York" : "")
    table.cell(dbg, 0, 0,  "Mode",                   text_color = color.white, text_size = size.small)
    table.cell(dbg, 1, 0,  mode,                     text_color = color.white, text_size = size.small)
    table.cell(dbg, 0, 1,  "Combined trend",         text_color = color.white, text_size = size.small)
    table.cell(dbg, 1, 1,  trendTxt(mainTrend),      text_color = mainTrend == 1 ? colBull : mainTrend == -1 ? colBear : color.white, text_size = size.small)
    table.cell(dbg, 0, 2,  "1. CHoCH",               text_color = color.white, text_size = size.small)
    table.cell(dbg, 1, 2,  onOff(useChoch, tChoch),  text_color = color.white, text_size = size.small)
    table.cell(dbg, 0, 3,  "2. CHoCH + BOS",         text_color = color.white, text_size = size.small)
    table.cell(dbg, 1, 3,  onOff(useConfirm, tConfirm), text_color = color.white, text_size = size.small)
    table.cell(dbg, 0, 4,  "3. Dow Theory",          text_color = color.white, text_size = size.small)
    table.cell(dbg, 1, 4,  onOff(useDow, tDow),      text_color = color.white, text_size = size.small)
    table.cell(dbg, 0, 5,  "4. MSS displacement",    text_color = color.white, text_size = size.small)
    table.cell(dbg, 1, 5,  onOff(useDisp, tDisp),    text_color = color.white, text_size = size.small)
    table.cell(dbg, 0, 6,  "5. EMA filter",          text_color = color.white, text_size = size.small)
    table.cell(dbg, 1, 6,  onOff(useEma, tEma),      text_color = color.white, text_size = size.small)
    table.cell(dbg, 0, 7,  "Session now",            text_color = color.white, text_size = size.small)
    table.cell(dbg, 1, 7,  sessNow == "" ? "-" : sessNow, text_color = color.white, text_size = size.small)
    table.cell(dbg, 0, 8,  "Decision areas",         text_color = color.white, text_size = size.small)
    table.cell(dbg, 1, 8,  str.tostring(nZ),         text_color = color.white, text_size = size.small)
    table.cell(dbg, 0, 9,  "No-wick candles (enabled sessions)", text_color = color.white, text_size = size.small)
    table.cell(dbg, 1, 9,  str.tostring(cntNoWick),  text_color = color.white, text_size = size.small)
    table.cell(dbg, 0, 10, "Orders placed",          text_color = color.white, text_size = size.small)
    table.cell(dbg, 1, 10, str.tostring(cntSetups),  text_color = color.white, text_size = size.small)
    table.cell(dbg, 0, 11, "Trades",                 text_color = color.white, text_size = size.small)
    table.cell(dbg, 1, 11, str.tostring(strategy.closedtrades + strategy.opentrades), text_color = color.white, text_size = size.small)

// Structure alerts (strategies use alert(); create one alert with "Any alert() function call")
if bullBOS
    alert("Bullish BOS (body close) on " + syminfo.ticker, alert.freq_once_per_bar_close)
if bearBOS
    alert("Bearish BOS (body close) on " + syminfo.ticker, alert.freq_once_per_bar_close)
if bullCHoCH
    alert("Bullish CHoCH (body close) on " + syminfo.ticker, alert.freq_once_per_bar_close)
if bearCHoCH
    alert("Bearish CHoCH (body close) on " + syminfo.ticker, alert.freq_once_per_bar_close)
if mainTrend != mainTrend[1]
    alert("Combined trend changed to " + trendTxt(mainTrend) + " on " + syminfo.ticker, alert.freq_once_per_bar_close)
